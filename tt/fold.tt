#import prelude
#import nat
-- fold.tt: the folds over the Nat whose step is an addition, and what they compute (M17).
-- A fold that uses its induction hypothesis walks the literal, so the erasure refuses it; for the steps
-- below the walk has a closed form, and these are the theorems that license the erasure to emit it.

-- one more: a fold whose step adds w to the running value, n times, is z + n * w
def elim_add : (z w n : Nat) -> Path Nat (elim Nat (\_ -> Nat) z (\k ih -> add ih w) n) (add z (mul n w)) :=
  \z w n -> elim Nat (\n -> Path Nat (elim Nat (\_ -> Nat) z (\k ih -> add ih w) n) (add z (mul n w)))
    (sym Nat (add z zero) z (add_zero_r z))     -- n = 0: the left side is z, and mul zero w is zero
    (\k ih -> compPath Nat (add (elim Nat (\_ -> Nat) z (\k ih -> add ih w) k) w) (add (add z (mul k w)) w) (add z (add w (mul k w)))
       (cong Nat Nat (\x -> add x w) (elim Nat (\_ -> Nat) z (\k ih -> add ih w) k) (add z (mul k w)) ih)
       (compPath Nat (add (add z (mul k w)) w) (add z (add (mul k w) w)) (add z (add w (mul k w)))
          (add_assoc z (mul k w) w)
          (cong Nat Nat (\x -> add z x) (add (mul k w) w) (add w (mul k w)) (add_comm (mul k w) w))))
    n
