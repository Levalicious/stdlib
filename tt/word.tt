#import nat
-- word.tt: machine words in the theory (M16a). The word type is the naturals below 2^64 with that bound irrelevant; the
-- operations are specified by the naturals' arithmetic (mkw reduces modulo 2^64, bounded by nat.tt's modLtS) and erased to
-- the run-time primitives of the same names.
def M64 : Nat := 18446744073709551616
def M63 : Nat := 18446744073709551615
word Word : U := Sigma Nat .(\k -> Lt k M64)
def mkw : Nat -> Word := \y -> (mod y M64, modLtS y M63)
def n2b : Nat -> Bool := \n -> elim Nat (\_ -> Bool) false (\_ _ -> true) n
word wadd : Word -> Word -> Word := \a b -> mkw (add (fst a) (fst b))
word wsub : Word -> Word -> Word := \a b -> mkw (add (fst a) (sub M64 (fst b)))
word wmul : Word -> Word -> Word := \a b -> mkw (mul (fst a) (fst b))
word weq : Word -> Word -> Bool := \a b -> n2b (beq (fst a) (fst b))
word wlt : Word -> Word -> Bool := \a b -> n2b (blt (fst a) (fst b))
word waddc : Word -> Word -> Sigma Word (\_ -> Word) := \a b -> (mkw (add (fst a) (fst b)), mkw (div (add (fst a) (fst b)) M64))
word wsubb : Word -> Word -> Sigma Word (\_ -> Word) := \a b -> (mkw (add (fst a) (sub M64 (fst b))), mkw (blt (fst a) (fst b)))
word wmull : Word -> Word -> Sigma Word (\_ -> Word) := \a b -> (mkw (mul (fst a) (fst b)), mkw (div (mul (fst a) (fst b)) M64))
word wdivmod : Word -> Word -> Sigma Word (\_ -> Word) := \a b -> (mkw (div (fst a) (fst b)), mkw (mod (fst a) (fst b)))

-- the laws: a Word is its first component (the second is irrelevant), so a path of first components lifts
def wpath {X Y : Word} (p : Path Nat (fst X) (fst Y)) : Path Word X Y := \i -> (p i, snd X)
def wadd_zero_r : (a : Word) -> Path Word (wadd a 0) a :=
  \a -> wpath (compPath Nat (mod (add (fst a) 0) M64) (mod (fst a) M64) (fst a)
          (cong Nat Nat (\x -> mod x M64) (add (fst a) 0) (fst a) (add_zero_r (fst a)))
          (mod_small M63 (fst a) (snd a)))
def wadd_zero_l : (a : Word) -> Path Word (wadd 0 a) a :=
  \a -> wpath (compPath Nat (mod (add 0 (fst a)) M64) (mod (fst a) M64) (fst a)
          (cong Nat Nat (\x -> mod x M64) (add 0 (fst a)) (fst a) (add_zero_l (fst a)))
          (mod_small M63 (fst a) (snd a)))
def mk_word_nat : (y : Nat) -> Path Nat (fst (mkw y)) (mod y M64) := \y -> prefl Nat (mod y M64)
-- the semiring laws modulo 2^64: the fst components are mod-expressions, so mod's homomorphism laws decide them
def wadd_comm : (a b : Word) -> Path Word (wadd a b) (wadd b a) :=
  \a b -> wpath (cong Nat Nat (\w -> mod w M64) (add (fst a) (fst b)) (add (fst b) (fst a)) (add_comm (fst a) (fst b)))
def wadd_assoc : (a b c : Word) -> Path Word (wadd (wadd a b) c) (wadd a (wadd b c)) :=
  \a b c -> wpath (compPath Nat
    (mod (add (mod (add (fst a) (fst b)) M64) (fst c)) M64)
    (mod (add (add (fst a) (fst b)) (fst c)) M64)
    (mod (add (fst a) (mod (add (fst b) (fst c)) M64)) M64)
    (sym Nat (mod (add (add (fst a) (fst b)) (fst c)) M64) (mod (add (mod (add (fst a) (fst b)) M64) (fst c)) M64)
       (mod_add_mod1 (add (fst a) (fst b)) (fst c) M63))
    (compPath Nat
       (mod (add (add (fst a) (fst b)) (fst c)) M64)
       (mod (add (fst a) (add (fst b) (fst c))) M64)
       (mod (add (fst a) (mod (add (fst b) (fst c)) M64)) M64)
       (cong Nat Nat (\w -> mod w M64) (add (add (fst a) (fst b)) (fst c)) (add (fst a) (add (fst b) (fst c))) (add_assoc (fst a) (fst b) (fst c)))
       (mod_add_mod2 (fst a) (add (fst b) (fst c)) M63)))
def wmul_comm : (a b : Word) -> Path Word (wmul a b) (wmul b a) :=
  \a b -> wpath (cong Nat Nat (\w -> mod w M64) (mul (fst a) (fst b)) (mul (fst b) (fst a)) (mul_comm (fst a) (fst b)))
def wmul_assoc : (a b c : Word) -> Path Word (wmul (wmul a b) c) (wmul a (wmul b c)) :=
  \a b c -> wpath (compPath Nat
    (mod (mul (mod (mul (fst a) (fst b)) M64) (fst c)) M64)
    (mod (mul (mul (fst a) (fst b)) (fst c)) M64)
    (mod (mul (fst a) (mod (mul (fst b) (fst c)) M64)) M64)
    (sym Nat (mod (mul (mul (fst a) (fst b)) (fst c)) M64) (mod (mul (mod (mul (fst a) (fst b)) M64) (fst c)) M64)
       (mod_mul_mod1 (mul (fst a) (fst b)) (fst c) M63))
    (compPath Nat
       (mod (mul (mul (fst a) (fst b)) (fst c)) M64)
       (mod (mul (fst a) (mul (fst b) (fst c))) M64)
       (mod (mul (fst a) (mod (mul (fst b) (fst c)) M64)) M64)
       (cong Nat Nat (\w -> mod w M64) (mul (mul (fst a) (fst b)) (fst c)) (mul (fst a) (mul (fst b) (fst c))) (mul_assoc (fst a) (fst b) (fst c)))
       (mod_mul_mod2 (fst a) (mul (fst b) (fst c)) M63)))

-- the additive inverse: x*(2^64-1) = x*2^64 - x = -x modulo 2^64 (no truncated subtraction needed)
def wneg : Word -> Word := \a -> wmul a 18446744073709551615   -- x*(2^64-1) = -x; the wmul primitive erases to the runtime's, so negation is native
def add_mul_pow : (x : Nat) -> Path Nat (add x (mul x M63)) (mul x M64) :=
  \x -> compPath Nat (add x (mul x M63)) (add (mul x 1) (mul x M63)) (mul x M64)
     (cong Nat Nat (\w -> add w (mul x M63)) x (mul x 1) (sym Nat (mul x 1) x (mul_one_r x)))
     (compPath Nat (add (mul x 1) (mul x M63)) (mul x (add 1 M63)) (mul x M64)
        (sym Nat (mul x (add 1 M63)) (add (mul x 1) (mul x M63)) (mul_dist_l x 1 M63))
        (prefl Nat (mul x M64)))
def wadd_neg : (a : Word) -> Path Word (wadd a (wneg a)) 0 :=
  \a -> wpath (compPath Nat
     (mod (add (fst a) (mod (mul (fst a) M63) M64)) M64)
     (mod (add (fst a) (mul (fst a) M63)) M64)
     (mod 0 M64)
     (sym Nat (mod (add (fst a) (mul (fst a) M63)) M64) (mod (add (fst a) (mod (mul (fst a) M63) M64)) M64)
        (mod_add_mod2 (fst a) (mul (fst a) M63) M63))
     (compPath Nat
     (mod (add (fst a) (mul (fst a) M63)) M64)
     (mod (mul (fst a) M64) M64)
     (mod 0 M64)
     (cong Nat Nat (\w -> mod w M64) (add (fst a) (mul (fst a) M63)) (mul (fst a) M64) (add_mul_pow (fst a)))
     (compPath Nat (mod (mul (fst a) M64) M64) (mod (mul (mod (fst a) M64) 0) M64) (mod 0 M64)
        (mod_mul (fst a) M64 M63)
        (cong Nat Nat (\w -> mod w M64) (mul (mod (fst a) M64) 0) 0 (mul_zero_r (mod (fst a) M64))))))
def wadd_neg_l : (a : Word) -> Path Word (wadd (wneg a) a) 0 :=
  \a -> compPath Word (wadd (wneg a) a) (wadd a (wneg a)) 0 (wadd_comm (wneg a) a) (wadd_neg a)
def wmul_one_r : (a : Word) -> Path Word (wmul a 1) a :=
  \a -> wpath (compPath Nat (mod (mul (fst a) 1) M64) (mod (fst a) M64) (fst a)
     (cong Nat Nat (\w -> mod w M64) (mul (fst a) 1) (fst a) (mul_one_r (fst a)))
     (mod_small M63 (fst a) (snd a)))
def wmul_one_l : (a : Word) -> Path Word (wmul 1 a) a :=
  \a -> compPath Word (wmul 1 a) (wmul a 1) a (wmul_comm 1 a) (wmul_one_r a)
def wmul_zero_r : (a : Word) -> Path Word (wmul a 0) 0 :=
  \a -> wpath (cong Nat Nat (\w -> mod w M64) (mul (fst a) 0) 0 (mul_zero_r (fst a)))
def wmul_zero_l : (a : Word) -> Path Word (wmul 0 a) 0 :=
  \a -> compPath Word (wmul 0 a) (wmul a 0) 0 (wmul_comm 0 a) (wmul_zero_r a)
def wmul_dist_l : (a b c : Word) -> Path Word (wmul a (wadd b c)) (wadd (wmul a b) (wmul a c)) :=
  \a b c -> wpath (compPath Nat
    (mod (mul (fst a) (mod (add (fst b) (fst c)) M64)) M64)
    (mod (mul (fst a) (add (fst b) (fst c))) M64)
    (mod (add (mod (mul (fst a) (fst b)) M64) (mod (mul (fst a) (fst c)) M64)) M64)
    (sym Nat (mod (mul (fst a) (add (fst b) (fst c))) M64) (mod (mul (fst a) (mod (add (fst b) (fst c)) M64)) M64)
       (mod_mul_mod2 (fst a) (add (fst b) (fst c)) M63))
    (compPath Nat
       (mod (mul (fst a) (add (fst b) (fst c))) M64)
       (mod (add (mul (fst a) (fst b)) (mul (fst a) (fst c))) M64)
       (mod (add (mod (mul (fst a) (fst b)) M64) (mod (mul (fst a) (fst c)) M64)) M64)
       (cong Nat Nat (\w -> mod w M64) (mul (fst a) (add (fst b) (fst c))) (add (mul (fst a) (fst b)) (mul (fst a) (fst c))) (mul_dist_l (fst a) (fst b) (fst c)))
       (mod_add (mul (fst a) (fst b)) (mul (fst a) (fst c)) M63)))
def wmul_dist_r : (a b c : Word) -> Path Word (wmul (wadd a b) c) (wadd (wmul a c) (wmul b c)) :=
  \a b c -> compPath Word (wmul (wadd a b) c) (wmul c (wadd a b)) (wadd (wmul a c) (wmul b c))
     (wmul_comm (wadd a b) c)
     (compPath Word (wmul c (wadd a b)) (wadd (wmul c a) (wmul c b)) (wadd (wmul a c) (wmul b c))
        (wmul_dist_l c a b)
        (compPath Word (wadd (wmul c a) (wmul c b)) (wadd (wmul a c) (wmul c b)) (wadd (wmul a c) (wmul b c))
           (cong Word Word (\w -> wadd w (wmul c b)) (wmul c a) (wmul a c) (wmul_comm c a))
           (cong Word Word (\w -> wadd (wmul a c) w) (wmul c b) (wmul b c) (wmul_comm c b))))

-- mod of a number that is at most one is that number: the wrap a word column needs, and cheap because the decision
-- comes from the bound rather than from inverting a computation. add (suc k) d reduces to suc (add k d) on its own,
-- so injSuc plus add_zero_both give k = 0 with no case split over the witness at all.
def mod_le_one : (q : Nat) -> Le q 1 -> Path Nat (mod q M64) q :=
  \q -> elim Nat (\q -> Le q 1 -> Path Nat (mod q M64) q)
    (\_ -> prefl Nat 0)
    (\k ih h -> compPath Nat (mod (suc k) M64) (mod 1 M64) (suc k)
       (cong Nat Nat (\w -> mod w M64) (suc k) 1 (cong Nat Nat suc k 0 (add_zero_both k (fst h) (injSuc (snd h)))))
       (compPath Nat (mod 1 M64) 1 (suc k)
          (prefl Nat 1)
          (sym Nat (suc k) 1 (cong Nat Nat suc k 0 (add_zero_both k (fst h) (injSuc (snd h)))))))
    q

-- the column's value law: a word sum's carry and digit reconstruct it. The sum's size bound is a HYPOTHESIS - the
-- consumer supplies it (from the words' own bounds), so nothing here decides anything against a literal: the
-- quotient is at most one (dm_q_le_one, a witness) and mod_le_one unwraps the carry's mod with no inversion.
def waddc_val : (a b : Word) -> Le (suc (add (fst a) (fst b))) (mul 2 M64)
             -> Path Nat (add (mul (fst (snd (waddc a b))) M64) (fst (fst (waddc a b)))) (add (fst a) (fst b)) :=
  \a b h -> compPath Nat
    (add (mul (mod (div (add (fst a) (fst b)) M64) M64) M64) (mod (add (fst a) (fst b)) M64))
    (add (mul (div (add (fst a) (fst b)) M64) M64) (mod (add (fst a) (fst b)) M64))
    (add (fst a) (fst b))
    (cong Nat Nat (\w -> add (mul w M64) (mod (add (fst a) (fst b)) M64))
       (mod (div (add (fst a) (fst b)) M64) M64) (div (add (fst a) (fst b)) M64)
       (mod_le_one (div (add (fst a) (fst b)) M64) (dm_q_le_one M63 (add (fst a) (fst b)) h)))
    (divmod_spec (add (fst a) (fst b)) M63)

-- ---- the Word-limb fold (M16b b5) ----
-- The Nat-limb layer's shapes, over words: an accumulator value, a column that returns (carry, digit), and the fold
-- that threads the carry back from the less significant side. The VALUE law for this fold is the next piece; it needs
-- the limbs' bounds as hypotheses, and the second waddc of a column needs a WITNESS bound on mod - which is exactly
-- what the slack iteration can supply and the blt decision cannot.
def WB : U := List Word
-- a limb's value, declared so the fold's step can apply it: a projection on a binder whose type is still a meta is
-- rejected (the elim's element type is only solved later), an application pins it here
def wlimb (w : Word) : Nat := fst w
def wbvalAux (acc : Nat) (x : WB) : Nat :=
  elim List (\_ -> Nat -> Nat) (\acc -> acc) (\l rest ih -> \acc -> ih (add (mul acc M64) (wlimb l))) x acc
def wbval (x : WB) : Nat := wbvalAux 0 x
-- one column: the carry in from the less significant side, two limbs; (carry out, digit). The carry in is added by a
-- second waddc, and the two carries are themselves words 0/1 whose sum is the column's carry out.
def wcol (c a b : Word) : Sigma Word (\_ -> Word) :=
  let s : Sigma Word (\_ -> Word) := waddc (fst (waddc a b)) c in
  (wadd (snd (waddc a b)) (snd s), fst s)
def waddGo (x y : WB) : Sigma Word (\_ -> WB) :=
  elim List (\_ -> WB -> Sigma Word (\_ -> WB))
    (\y -> elim List (\_ -> Sigma Word (\_ -> WB))
       (0, lnil {Word})
       (\b bs ihb -> (fst (wcol (fst ihb) 0 b), lcons (snd (wcol (fst ihb) 0 b)) (snd ihb)))
       y)
    (\a as iha -> \y -> elim List (\_ -> Sigma Word (\_ -> WB))
       (fst (wcol (fst (iha (lnil {Word}))) a 0), lcons (snd (wcol (fst (iha (lnil {Word}))) a 0)) (snd (iha (lnil {Word}))))
       (\b bs ihb -> (fst (wcol (fst (iha bs)) a b), lcons (snd (wcol (fst (iha bs)) a b)) (snd (iha bs))))
       y)
    x y

-- ---- the fold's value law ----
-- The base is a PARAMETER, not the literal: an inductive lemma applied at a literal is work proportional to
-- that literal and the elaborator walks it (the tripwire names the definition when it does). M64 is an
-- instance at the bottom, where nothing walks.
def wpowK : Nat -> Nat -> Nat := \K -> elim Nat (\_ -> Nat) 1 (\_ ih -> mul ih K)
def wpowK_suc : (K n : Nat) -> Path Nat (wpowK K (suc n)) (mul (wpowK K n) K) := \K n -> prefl Nat (mul (wpowK K n) K)
def wlen : WB -> Nat := elim List (\_ -> Nat) 0 (\_ r ih -> suc ih)
def wlen_cons : (l : Word) (r : WB) -> Path Nat (wlen (lcons l r)) (suc (wlen r)) := \l r -> prefl Nat (suc (wlen r))
def wbvalAuxK (K : Nat) (acc : Nat) (x : WB) : Nat :=
  elim List (\_ -> Nat -> Nat) (\acc -> acc) (\l rest ih -> \acc -> ih (add (mul acc K) (wlimb l))) x acc
def mul_shuffle : (K acc l P : Nat) -> Path Nat (mul (add (mul acc K) l) P) (add (mul acc (mul P K)) (mul l P)) :=
  \K acc l P -> compPath Nat
    (mul (add (mul acc K) l) P)
    (add (mul (mul acc K) P) (mul l P))
    (add (mul acc (mul P K)) (mul l P))
    (mul_dist_r (mul acc K) l P)
    (cong Nat Nat (\w -> add w (mul l P))
       (mul (mul acc K) P) (mul acc (mul P K))
       (compPath Nat (mul (mul acc K) P) (mul acc (mul K P)) (mul acc (mul P K))
          (mul_assoc acc K P)
          (cong Nat Nat (\w -> mul acc w) (mul K P) (mul P K) (mul_comm K P))))
-- wbvalAuxK K acc x = acc * K^len x + wbvalAuxK K 0 x
def wbvalAuxK_val : (K : Nat) (x : WB) (acc : Nat)
    -> Path Nat (wbvalAuxK K acc x) (add (mul acc (wpowK K (wlen x))) (wbvalAuxK K 0 x)) :=
  \K x -> elim List (\x -> (acc : Nat) -> Path Nat (wbvalAuxK K acc x) (add (mul acc (wpowK K (wlen x))) (wbvalAuxK K 0 x)))
    (\acc -> compPath Nat acc (mul acc 1) (add (mul acc 1) 0)
       (sym Nat (mul acc 1) acc (mul_one_r acc))
       (sym Nat (add (mul acc 1) 0) (mul acc 1) (add_zero_r (mul acc 1))))
    (\l r ih -> \acc ->
       compPath Nat
         (wbvalAuxK K (add (mul acc K) (wlimb l)) r)
         (add (add (mul acc (mul (wpowK K (wlen r)) K)) (mul (wlimb l) (wpowK K (wlen r)))) (wbvalAuxK K 0 r))
         (add (mul acc (wpowK K (suc (wlen r)))) (wbvalAuxK K 0 (lcons l r)))
         (compPath Nat
            (wbvalAuxK K (add (mul acc K) (wlimb l)) r)
            (add (mul (add (mul acc K) (wlimb l)) (wpowK K (wlen r))) (wbvalAuxK K 0 r))
            (add (add (mul acc (mul (wpowK K (wlen r)) K)) (mul (wlimb l) (wpowK K (wlen r)))) (wbvalAuxK K 0 r))
            (ih (add (mul acc K) (wlimb l)))
            (cong Nat Nat (\w -> add w (wbvalAuxK K 0 r))
               (mul (add (mul acc K) (wlimb l)) (wpowK K (wlen r)))
               (add (mul acc (mul (wpowK K (wlen r)) K)) (mul (wlimb l) (wpowK K (wlen r))))
               (mul_shuffle K acc (wlimb l) (wpowK K (wlen r)))))
         (compPath Nat
            (add (add (mul acc (mul (wpowK K (wlen r)) K)) (mul (wlimb l) (wpowK K (wlen r)))) (wbvalAuxK K 0 r))
            (add (mul acc (wpowK K (suc (wlen r)))) (add (mul (wlimb l) (wpowK K (wlen r))) (wbvalAuxK K 0 r)))
            (add (mul acc (wpowK K (suc (wlen r)))) (wbvalAuxK K 0 (lcons l r)))
            (compPath Nat
               (add (add (mul acc (mul (wpowK K (wlen r)) K)) (mul (wlimb l) (wpowK K (wlen r)))) (wbvalAuxK K 0 r))
               (add (mul acc (mul (wpowK K (wlen r)) K)) (add (mul (wlimb l) (wpowK K (wlen r))) (wbvalAuxK K 0 r)))
               (add (mul acc (wpowK K (suc (wlen r)))) (add (mul (wlimb l) (wpowK K (wlen r))) (wbvalAuxK K 0 r)))
               (add_assoc (mul acc (mul (wpowK K (wlen r)) K)) (mul (wlimb l) (wpowK K (wlen r))) (wbvalAuxK K 0 r))
               (cong Nat Nat (\w -> add w (add (mul (wlimb l) (wpowK K (wlen r))) (wbvalAuxK K 0 r)))
                  (mul acc (mul (wpowK K (wlen r)) K)) (mul acc (wpowK K (suc (wlen r))))
                  (sym Nat (mul acc (wpowK K (suc (wlen r)))) (mul acc (mul (wpowK K (wlen r)) K))
                     (cong Nat Nat (\w -> mul acc w) (wpowK K (suc (wlen r))) (mul (wpowK K (wlen r)) K) (wpowK_suc K (wlen r))))))
            (cong Nat Nat (\w -> add (mul acc (wpowK K (suc (wlen r)))) w)
               (add (mul (wlimb l) (wpowK K (wlen r))) (wbvalAuxK K 0 r))
               (wbvalAuxK K 0 (lcons l r))
               (sym Nat (wbvalAuxK K 0 (lcons l r)) (add (mul (wlimb l) (wpowK K (wlen r))) (wbvalAuxK K 0 r))
                  (ih (wlimb l))))))
    x

-- at the machine base: wbvalAux and wbval ARE wbvalAuxK M64, so the law instantiates by conversion
def wpow : Nat -> Nat := \n -> wpowK M64 n
def wpow_suc : (n : Nat) -> Path Nat (wpow (suc n)) (mul (wpow n) M64) := \n -> wpowK_suc M64 n
def wbvalAux_val : (x : WB) (acc : Nat) -> Path Nat (wbvalAux acc x) (add (mul acc (wpow (wlen x))) (wbval x)) :=
  \x acc -> wbvalAuxK_val M64 x acc
def wbval_cons : (l : Word) (r : WB) -> Path Nat (wbval (lcons l r)) (add (mul (wlimb l) (wpow (wlen r))) (wbval r)) :=
  \l r -> wbvalAuxK_val M64 r (wlimb l)

-- ---- the column's value law ----
-- A column is (carry out, digit) and the law is digit + M64 * carry = a + b + c, the carry out at most one so the
-- next column may take it as its carry in. Every decision here is against a VARIABLE - the two carries, the limbs -
-- and never against a literal: the carry is at most one because the quotient bound says so (dm_q_le_one), and its
-- word value is its natural because mod_le_one unwraps it. The one thing that is not local is the column's total
-- a + b + c fitting a word plus a carry, which is a HYPOTHESIS - the fold's own invariant supplies it.
-- the carry of a waddc is at most one: the quotient bound (dm_q_le_one, a witness), then mod_le_one unwrapping the
-- Word's own mod around it - by substId, so nothing inverts anything
def waddc_carry_le : (a b : Word) -> Le (suc (add (fst a) (fst b))) (mul 2 M64) -> Le (fst (snd (waddc a b))) 1 :=
  \a b h -> substId (\y -> Le y 1)
    (pathToId (sym Nat (mod (div (add (fst a) (fst b)) M64) M64) (div (add (fst a) (fst b)) M64)
       (mod_le_one (div (add (fst a) (fst b)) M64) (dm_q_le_one M63 (add (fst a) (fst b)) h))))
    (dm_q_le_one M63 (add (fst a) (fst b)) h)
-- suc of both sides of a witness bound
def le_suc_both : (x y : Nat) -> Le x y -> Le (suc x) (suc y) :=
  \x y h -> let d : Nat := fst h in (d, cong Nat Nat suc (add x d) y (snd h))
-- the column identity, as arithmetic on the digits and carries alone: (c1 M64 + d1) + Y = X + Y with d1 + Y split
def col_id : (c1 d1 c2 d2 X Y : Nat)
    -> Path Nat (add (mul c1 M64) d1) X -> Path Nat (add (mul c2 M64) d2) (add d1 Y)
    -> Path Nat (add (mul (add c1 c2) M64) d2) (add X Y) :=
  \c1 d1 c2 d2 X Y e1 e2 -> compPath Nat
    (add (mul (add c1 c2) M64) d2)
    (add (add (mul c1 M64) (mul c2 M64)) d2)
    (add X Y)
    (cong Nat Nat (\w -> add w d2) (mul (add c1 c2) M64) (add (mul c1 M64) (mul c2 M64)) (mul_dist_r c1 c2 M64))
    (compPath Nat
       (add (add (mul c1 M64) (mul c2 M64)) d2)
       (add (add (mul c1 M64) d1) Y)
       (add X Y)
       (compPath Nat
          (add (add (mul c1 M64) (mul c2 M64)) d2)
          (add (mul c1 M64) (add (mul c2 M64) d2))
          (add (add (mul c1 M64) d1) Y)
          (add_assoc (mul c1 M64) (mul c2 M64) d2)
          (compPath Nat
             (add (mul c1 M64) (add (mul c2 M64) d2))
             (add (mul c1 M64) (add d1 Y))
             (add (add (mul c1 M64) d1) Y)
             (cong Nat Nat (\w -> add (mul c1 M64) w) (add (mul c2 M64) d2) (add d1 Y) e2)
             (sym Nat (add (add (mul c1 M64) d1) Y) (add (mul c1 M64) (add d1 Y)) (add_assoc (mul c1 M64) d1 Y))))
       (cong Nat Nat (\w -> add w Y) (add (mul c1 M64) d1) X e1))

-- the column's value law: digit + M64 * carry = a + b + c, the carry out at most one. The size bound is a
-- HYPOTHESIS on the column's total, which is what the fold's invariant supplies; every decision below is against a
-- variable (the carries, the limbs), never against a literal.
def wcol_val : (c a b : Word) -> Le (suc (add (add (fst a) (fst b)) (fst c))) (mul 2 M64)
    -> Path Nat (add (wlimb (snd (wcol c a b))) (mul (wlimb (fst (wcol c a b))) M64))
               (add (add (fst a) (fst b)) (fst c)) :=
  \c a b H ->
  let X : Nat := add (fst a) (fst b) in
  let Y : Nat := fst c in
  let p : Sigma Word (\_ -> Word) := waddc a b in
  let c1 : Nat := fst (snd p) in
  let d1 : Nat := fst (fst p) in
  let s : Sigma Word (\_ -> Word) := waddc (fst p) c in
  let c2 : Nat := fst (snd s) in
  let d2 : Nat := fst (fst s) in
  let h1 : Le (suc X) (mul 2 M64) :=
     le_trans (suc X) (suc (add X Y)) (mul 2 M64)
        (le_suc_both X (add X Y) (Y, prefl Nat (add X Y))) H in
  let e1 : Path Nat (add (mul c1 M64) d1) X := waddc_val a b h1 in
  let d1X : Le d1 X := (mul c1 M64, compPath Nat (add d1 (mul c1 M64)) (add (mul c1 M64) d1) X (add_comm d1 (mul c1 M64)) e1) in
  let h2 : Le (suc (add d1 Y)) (mul 2 M64) :=
     le_trans (suc (add d1 Y)) (suc (add X Y)) (mul 2 M64)
        (le_suc_both (add d1 Y) (add X Y) (add_mono_r d1 X Y d1X)) H in
  let e2 : Path Nat (add (mul c2 M64) d2) (add d1 Y) := waddc_val (fst p) c h2 in
  let carry_le : Le (add c1 c2) 1 := le_one_of_not_le_two (add c1 c2)
    (\hbig -> lt_self_absurd (add X Y)
       (le_trans (suc (add X Y)) (mul 2 M64) (add X Y) H
          (le_trans (mul 2 M64) (add (mul (add c1 c2) M64) d2) (add X Y)
             (le_trans (mul 2 M64) (mul (add c1 c2) M64) (add (mul (add c1 c2) M64) d2)
                (le_mul_r 2 (add c1 c2) M64 hbig)
                (d2, prefl Nat (add (mul (add c1 c2) M64) d2)))
             (d2, col_id c1 d1 c2 d2 X Y e1 e2)))) in
  compPath Nat
    (add d2 (mul (fst (wadd (snd p) (snd s))) M64))
    (add d2 (mul (add c1 c2) M64))
    (add X Y)
    (cong Nat Nat (\w -> add d2 (mul w M64)) (fst (wadd (snd p) (snd s))) (add c1 c2) (mod_le_one (add c1 c2) carry_le))
    (compPath Nat
       (add d2 (mul (add c1 c2) M64))
       (add (mul (add c1 c2) M64) d2)
       (add X Y)
       (add_comm d2 (mul (add c1 c2) M64))
       (col_id c1 d1 c2 d2 X Y e1 e2))

-- the carry out of a column is at most one, so the next column may take it as its carry in
def wcol_carry_le : (c a b : Word) -> Le (suc (add (add (fst a) (fst b)) (fst c))) (mul 2 M64)
    -> Le (wlimb (fst (wcol c a b))) 1 :=
  \c a b H ->
  let X : Nat := add (fst a) (fst b) in
  let Y : Nat := fst c in
  let p : Sigma Word (\_ -> Word) := waddc a b in
  let c1 : Nat := fst (snd p) in
  let d1 : Nat := fst (fst p) in
  let s : Sigma Word (\_ -> Word) := waddc (fst p) c in
  let c2 : Nat := fst (snd s) in
  let d2 : Nat := fst (fst s) in
  let h1 : Le (suc X) (mul 2 M64) :=
     le_trans (suc X) (suc (add X Y)) (mul 2 M64)
        (le_suc_both X (add X Y) (Y, prefl Nat (add X Y))) H in
  let e1 : Path Nat (add (mul c1 M64) d1) X := waddc_val a b h1 in
  let d1X : Le d1 X := (mul c1 M64, compPath Nat (add d1 (mul c1 M64)) (add (mul c1 M64) d1) X (add_comm d1 (mul c1 M64)) e1) in
  let h2 : Le (suc (add d1 Y)) (mul 2 M64) :=
     le_trans (suc (add d1 Y)) (suc (add X Y)) (mul 2 M64)
        (le_suc_both (add d1 Y) (add X Y) (add_mono_r d1 X Y d1X)) H in
  let e2 : Path Nat (add (mul c2 M64) d2) (add d1 Y) := waddc_val (fst p) c h2 in
  let carry_le : Le (add c1 c2) 1 := le_one_of_not_le_two (add c1 c2)
    (\hbig -> lt_self_absurd (add X Y)
       (le_trans (suc (add X Y)) (mul 2 M64) (add X Y) H
          (le_trans (mul 2 M64) (add (mul (add c1 c2) M64) d2) (add X Y)
             (le_trans (mul 2 M64) (mul (add c1 c2) M64) (add (mul (add c1 c2) M64) d2)
                (le_mul_r 2 (add c1 c2) M64 hbig)
                (d2, prefl Nat (add (mul (add c1 c2) M64) d2)))
             (d2, col_id c1 d1 c2 d2 X Y e1 e2)))) in
  substId (\y -> Le y 1)
    (pathToId (sym Nat (mod (add c1 c2) M64) (add c1 c2) (mod_le_one (add c1 c2) carry_le)))
    carry_le

-- ---- the fold's value law: the bound arithmetic its step needs ----
-- A bound is a Sigma, so moving one along a path means rebuilding the witness (le_rewrite). The column's total fits
-- a word plus a carry given the limbs' own bounds and the carry in at most one - and that is what the fold's step
-- supplies to wcol_val, which is why wcol_val can take its size bound as a hypothesis.
def le_rewrite : (X X' Y Y' : Nat) -> Path Nat X X' -> Path Nat Y Y' -> Le X Y -> Le X' Y' :=
  \X X' Y Y' p q h -> substId (\z -> Le X' z) (pathToId q)
      (substId (\z -> Le z Y) (pathToId p) h)
def add_one_r : (x : Nat) -> Path Nat (add x 1) (suc x) :=
  \x -> compPath Nat (add x 1) (suc (add x 0)) (suc x) (add_suc_r x 0) (cong Nat Nat suc (add x 0) x (add_zero_r x))
def le_add_le : (a b c d : Nat) -> Le a b -> Le c d -> Le (add a c) (add b d) :=
  \a b c d p q -> let dp : Nat := fst p in let dq : Nat := fst q in
    (add dp dq,
     compPath Nat (add (add a c) (add dp dq)) (add (add a dp) (add c dq)) (add b d)
        (add_interchange a c dp dq)
        (compPath Nat (add (add a dp) (add c dq)) (add b (add c dq)) (add b d)
           (cong Nat Nat (\w -> add w (add c dq)) (add a dp) b (snd p))
           (cong Nat Nat (\w -> add b w) (add c dq) d (snd q))))
def word_le63 : (w : Word) -> Le (fst w) M63 :=
  \w -> let h : Le (suc (fst w)) M64 := lt_le (fst w) M64 (snd w) in
        (fst h, cong Nat Nat pred (add (suc (fst w)) (fst h)) M64 (snd h))
def col_bound : (a b c : Word) -> Le (wlimb c) 1 -> Le (suc (add (add (fst a) (fst b)) (fst c))) (mul 2 M64) :=
  \a b c hc ->
  let A : Nat := fst a in
  let B : Nat := fst b in
  let C : Nat := wlimb c in
  let hA : Le (suc A) M64 := lt_le (fst a) M64 (snd a) in
  let hB : Le (suc B) M64 := lt_le (fst b) M64 (snd b) in
  let hBC : Le (add B C) (suc B) :=
     le_rewrite (add B C) (add B C) (add B 1) (suc B)
        (prefl Nat (add B C)) (add_one_r B)
        (add_mono_l C 1 B hc) in
  let hBC64 : Le (add B C) M64 := le_trans (add B C) (suc B) M64 hBC hB in
  let hsum : Le (add (suc A) (add B C)) (add M64 M64) := le_add_le (suc A) M64 (add B C) M64 hA hBC64 in
  le_rewrite (add (suc A) (add B C)) (suc (add (add A B) C)) (add M64 M64) (mul 2 M64)
     (cong Nat Nat suc (add A (add B C)) (add (add A B) C) (sym Nat (add (add A B) C) (add A (add B C)) (add_assoc A B C)))
     (mul_two M64)
     hsum

-- ---- the fold's value law ----
-- The step, in pieces: the result's value at a column and a tail (wstep_lhs), the middle - two head weights, the
-- column times V, and the IH's relation (fold_step_mid, pure arithmetic on Nat) - and the two heads' weight rewrite
-- with the cons law (wstep_rhs). wstep_val assembles them around the column law and the IH, and waddGo_val is the
-- induction: the limbs pair off, the lnil cases are the ones the length hypothesis rules out, and the carry out of
-- each column is at most one, which is what lets the next column take it as its carry in.
def wstep_lhs : (z : WB) (d co : Word)
    -> Path Nat (add (wbval (lcons d z)) (mul (wlimb co) (wpow (wlen (lcons d z)))))
               (add (add (mul (wlimb d) (wpow (wlen z))) (wbval z)) (mul (wlimb co) (mul (wpow (wlen z)) M64))) :=
  \z d co -> compPath Nat
    (add (wbval (lcons d z)) (mul (wlimb co) (wpow (wlen (lcons d z)))))
    (add (add (mul (wlimb d) (wpow (wlen z))) (wbval z)) (mul (wlimb co) (wpow (wlen (lcons d z)))))
    (add (add (mul (wlimb d) (wpow (wlen z))) (wbval z)) (mul (wlimb co) (mul (wpow (wlen z)) M64)))
    (cong Nat Nat (\w -> add w (mul (wlimb co) (wpow (wlen (lcons d z))))) (wbval (lcons d z)) (add (mul (wlimb d) (wpow (wlen z))) (wbval z)) (wbval_cons d z))
    (cong Nat Nat (\w -> add (add (mul (wlimb d) (wpow (wlen z))) (wbval z)) (mul (wlimb co) w)) (wpow (wlen (lcons d z))) (mul (wpow (wlen z)) M64) (wpow_suc (wlen z)))
def fold_step_mid : (A1 B1 X UA UB W CV D1 C1 : Nat)
    -> Path Nat X (add A1 B1)
    -> Path Nat (add X CV) (add D1 C1)
    -> Path Nat (add W CV) (add UA UB)
    -> Path Nat (add (add D1 W) C1) (add (add A1 UA) (add B1 UB)) :=
  \A1 B1 X UA UB W CV D1 C1 hX hcol ih -> compPath Nat
    (add (add D1 W) C1)
    (add W (add X CV))
    (add (add A1 UA) (add B1 UB))
    (compPath Nat
       (add (add D1 W) C1)
       (add D1 (add W C1))
       (add W (add X CV))
       (add_assoc D1 W C1)
       (compPath Nat
          (add D1 (add W C1))
          (add W (add D1 C1))
          (add W (add X CV))
          (add_swap D1 W C1)
          (cong Nat Nat (\w -> add W w) (add D1 C1) (add X CV) (sym Nat (add X CV) (add D1 C1) hcol))))
    (compPath Nat
       (add W (add X CV))
       (add X (add W CV))
       (add (add A1 UA) (add B1 UB))
       (add_swap W X CV)
       (compPath Nat
          (add X (add W CV))
          (add X (add UA UB))
          (add (add A1 UA) (add B1 UB))
          (cong Nat Nat (\w -> add X w) (add W CV) (add UA UB) ih)
          (compPath Nat
             (add X (add UA UB))
             (add (add A1 B1) (add UA UB))
             (add (add A1 UA) (add B1 UB))
             (cong Nat Nat (\w -> add w (add UA UB)) X (add A1 B1) hX)
             (add_interchange A1 B1 UA UB))))
def wstep_rhs : (a b : Word) (as bs : WB) (V : Nat)
    -> Path Nat V (wpow (wlen as)) -> Path Nat V (wpow (wlen bs))
    -> Path Nat (add (add (mul (wlimb a) V) (wbval as)) (add (mul (wlimb b) V) (wbval bs)))
               (add (wbval (lcons a as)) (wbval (lcons b bs))) :=
  \a b as bs V hVP hVQ ->
  let P : Nat := wpow (wlen as) in
  let Q : Nat := wpow (wlen bs) in
  compPath Nat
    (add (add (mul (wlimb a) V) (wbval as)) (add (mul (wlimb b) V) (wbval bs)))
    (add (add (mul (wlimb a) P) (wbval as)) (add (mul (wlimb b) Q) (wbval bs)))
    (add (wbval (lcons a as)) (wbval (lcons b bs)))
    (compPath Nat
       (add (add (mul (wlimb a) V) (wbval as)) (add (mul (wlimb b) V) (wbval bs)))
       (add (add (mul (wlimb a) P) (wbval as)) (add (mul (wlimb b) V) (wbval bs)))
       (add (add (mul (wlimb a) P) (wbval as)) (add (mul (wlimb b) Q) (wbval bs)))
       (cong Nat Nat (\w -> add (add w (wbval as)) (add (mul (wlimb b) V) (wbval bs))) (mul (wlimb a) V) (mul (wlimb a) P)
          (cong Nat Nat (\v -> mul (wlimb a) v) V P hVP))
       (cong Nat Nat (\w -> add (add (mul (wlimb a) P) (wbval as)) (add w (wbval bs))) (mul (wlimb b) V) (mul (wlimb b) Q)
          (cong Nat Nat (\v -> mul (wlimb b) v) V Q hVQ)))
    (compPath Nat
       (add (add (mul (wlimb a) P) (wbval as)) (add (mul (wlimb b) Q) (wbval bs)))
       (add (wbval (lcons a as)) (add (mul (wlimb b) Q) (wbval bs)))
       (add (wbval (lcons a as)) (wbval (lcons b bs)))
       (cong Nat Nat (\w -> add w (add (mul (wlimb b) Q) (wbval bs))) (add (mul (wlimb a) P) (wbval as)) (wbval (lcons a as))
          (sym Nat (wbval (lcons a as)) (add (mul (wlimb a) P) (wbval as)) (wbval_cons a as)))
       (cong Nat Nat (\w -> add (wbval (lcons a as)) w) (add (mul (wlimb b) Q) (wbval bs)) (wbval (lcons b bs))
          (sym Nat (wbval (lcons b bs)) (add (mul (wlimb b) Q) (wbval bs)) (wbval_cons b bs))))

-- the step's value law, assembled: the result's value at the head column, the column law times V, and the IH
def wstep_val : (a b : Word) (as bs : WB) (r : Sigma Word (\_ -> WB))
    -> Le (wlimb (fst r)) 1
    -> Path Nat (wlen as) (wlen bs)
    -> Path Nat (wlen (snd r)) (wlen as)
    -> Path Nat (add (wbval (snd r)) (mul (wlimb (fst r)) (wpow (wlen (snd r))))) (add (wbval as) (wbval bs))
    -> Path Nat (add (wbval (lcons (snd (wcol (fst r) a b)) (snd r))) (mul (wlimb (fst (wcol (fst r) a b))) (wpow (wlen (lcons (snd (wcol (fst r) a b)) (snd r))))))
               (add (wbval (lcons a as)) (wbval (lcons b bs))) :=
  \a b as bs r hcarry hlen hL ihval ->
  let c : Nat := wlimb (fst r) in
  let z : WB := snd r in
  let V : Nat := wpow (wlen z) in
  let hPV : Path Nat V (wpow (wlen as)) := cong Nat Nat wpow (wlen z) (wlen as) hL in
  let hVQ : Path Nat V (wpow (wlen bs)) :=
     compPath Nat V (wpow (wlen as)) (wpow (wlen bs)) hPV (cong Nat Nat wpow (wlen as) (wlen bs) hlen) in
  let d : Word := snd (wcol (fst r) a b) in
  let co : Word := fst (wcol (fst r) a b) in
  let A1 : Nat := mul (wlimb a) V in
  let B1 : Nat := mul (wlimb b) V in
  let D1 : Nat := mul (wlimb d) V in
  let C1 : Nat := mul (wlimb co) (mul V M64) in
  let W : Nat := wbval z in
  let UA : Nat := wbval as in
  let UB : Nat := wbval bs in
  let CV : Nat := mul c V in
  let X : Nat := mul (add (wlimb a) (wlimb b)) V in
  let hX : Path Nat X (add A1 B1) := mul_dist_r (wlimb a) (wlimb b) V in
  let hwcol : Path Nat (mul (add (wlimb d) (mul (wlimb co) M64)) V) (add D1 C1) :=
    compPath Nat (mul (add (wlimb d) (mul (wlimb co) M64)) V) (add (mul (wlimb d) V) (mul (mul (wlimb co) M64) V)) (add D1 C1)
      (mul_dist_r (wlimb d) (mul (wlimb co) M64) V)
      (cong Nat Nat (\w -> add D1 w) (mul (mul (wlimb co) M64) V) C1
         (compPath Nat (mul (mul (wlimb co) M64) V) (mul (wlimb co) (mul M64 V)) (mul (wlimb co) (mul V M64))
            (mul_assoc (wlimb co) M64 V)
            (cong Nat Nat (\w -> mul (wlimb co) w) (mul M64 V) (mul V M64) (mul_comm M64 V)))) in
  let hXCV : Path Nat (add X CV) (add D1 C1) :=
    compPath Nat (add X CV) (mul (add (add (wlimb a) (wlimb b)) c) V) (add D1 C1)
      (sym Nat (mul (add (add (wlimb a) (wlimb b)) c) V) (add (mul (add (wlimb a) (wlimb b)) V) (mul c V))
         (mul_dist_r (add (wlimb a) (wlimb b)) c V))
      (compPath Nat (mul (add (add (wlimb a) (wlimb b)) c) V) (mul (add (wlimb d) (mul (wlimb co) M64)) V) (add D1 C1)
         (cong Nat Nat (\w -> mul w V) (add (add (wlimb a) (wlimb b)) c) (add (wlimb d) (mul (wlimb co) M64))
            (sym Nat (add (wlimb d) (mul (wlimb co) M64)) (add (add (wlimb a) (wlimb b)) c)
               (wcol_val (fst r) a b (col_bound a b (fst r) hcarry))))
         hwcol) in
  compPath Nat
    (add (wbval (lcons d z)) (mul (wlimb co) (wpow (wlen (lcons d z)))))
    (add (add A1 UA) (add B1 UB))
    (add (wbval (lcons a as)) (wbval (lcons b bs)))
    (compPath Nat
       (add (wbval (lcons d z)) (mul (wlimb co) (wpow (wlen (lcons d z)))))
       (add (add D1 W) C1)
       (add (add A1 UA) (add B1 UB))
       (wstep_lhs z d co)
       (fold_step_mid A1 B1 X UA UB W CV D1 C1 hX hXCV ihval))
    (wstep_rhs a b as bs V hPV hVQ)

-- what the fold is worth, bundled: the value, the carry out, and the length of the result
def WInv (x y : WB) : U :=
  Sigma (Path Nat (add (wbval (snd (waddGo x y))) (mul (wlimb (fst (waddGo x y))) (wpow (wlen (snd (waddGo x y)))))) (add (wbval x) (wbval y)))
    (\_ -> Sigma (Le (wlimb (fst (waddGo x y))) 1) (\_ -> Path Nat (wlen (snd (waddGo x y))) (wlen x)))
-- the fold's value law: equal lengths in, and the limbs' digits reconstruct the sum
def waddGo_val : (x y : WB) -> Path Nat (wlen x) (wlen y) -> WInv x y :=
  \x -> elim List (\x -> (y : WB) -> Path Nat (wlen x) (wlen y) -> WInv x y)
    (\y -> elim List (\y -> Path Nat (wlen (lnil {Word})) (wlen y) -> WInv (lnil {Word}) y)
       (\h -> (prefl Nat 0, ((1, prefl Nat 1), prefl Nat 0)))
       (\b bs ihb h -> elim Empty (\_ -> WInv (lnil {Word}) (lcons b bs)) (znots h))
       y)
    (\a as iha -> \y -> elim List (\y -> Path Nat (wlen (lcons a as)) (wlen y) -> WInv (lcons a as) y)
       (\h -> elim Empty (\_ -> WInv (lcons a as) (lnil {Word})) (snotz h))
       (\b bs ihb h ->
          let hs : Path Nat (wlen as) (wlen bs) := injSuc h in
          let r : Sigma Word (\_ -> WB) := waddGo as bs in
          let ihv : WInv as bs := iha bs hs in
          let hcarry : Le (wlimb (fst r)) 1 := fst (snd ihv) in
          ( wstep_val a b as bs r hcarry hs (snd (snd ihv)) (fst ihv),
            ( wcol_carry_le (fst r) a b (col_bound a b (fst r) hcarry),
              cong Nat Nat suc (wlen (snd r)) (wlen as) (snd (snd ihv)) ) ))
       y)
    x

-- ---- the comparison scan's order toolkit ----
-- Lt is a decision (an Id over blt), so a witness comes out of it with lt_le and goes back in with le_lt: the
-- companions of le_trans and add_mono_* that the Lt calculus was missing. lt_rewrite moves a decision along two
-- paths, the way le_rewrite moves a bound.
-- the comparison scan's order toolkit: Lt is a decision, so witnesses come from lt_le and go back with le_lt
def lt_le_trans : (a b c : Nat) -> .(hl : Lt a b) -> Le b c -> Lt a c :=
  \a b c hl hle -> le_lt a c (le_trans (suc a) b c (lt_le a b hl) hle)
def lt_add_mono_r : (a b c : Nat) -> .(hl : Lt a b) -> Lt (add a c) (add b c) :=
  \a b c hl -> le_lt (add a c) (add b c) (add_mono_r (suc a) b c (lt_le a b hl))
def lt_add_mono_l : (a b c : Nat) -> .(hl : Lt a b) -> Lt (add c a) (add c b) :=
  \a b c hl -> le_lt (add c a) (add c b)
     (le_rewrite (add c (suc a)) (suc (add c a)) (add c b) (add c b)
        (add_suc_r c a) (prefl Nat (add c b))
        (add_mono_l (suc a) b c (lt_le a b hl)))
def lt_rewrite : (X X' Y Y' : Nat) -> Path Nat X X' -> Path Nat Y Y' -> Lt X Y -> Lt X' Y' :=
  \X X' Y Y' p q h -> substId (\z -> Lt X' z) (pathToId q) (substId (\z -> Lt z Y) (pathToId p) h)
-- a limb list is strictly below its own weight: the head's limb is below M64 and the tail below its own weight
def wbval_lt_wpow : (x : WB) -> Lt (wbval x) (wpow (wlen x)) :=
  \x -> elim List (\x -> Lt (wbval x) (wpow (wlen x)))
    (refl)
    (\a as iha ->
       lt_rewrite (add (mul (wlimb a) (wpow (wlen as))) (wbval as)) (wbval (lcons a as)) (mul (wpow (wlen as)) M64) (wpow (wlen (lcons a as)))
          (sym Nat (wbval (lcons a as)) (add (mul (wlimb a) (wpow (wlen as))) (wbval as)) (wbval_cons a as)) (prefl Nat (mul (wpow (wlen as)) M64))
          (lt_le_trans (add (mul (wlimb a) (wpow (wlen as))) (wbval as)) (add (mul (wlimb a) (wpow (wlen as))) (wpow (wlen as))) (mul (wpow (wlen as)) M64)
             (lt_add_mono_l (wbval as) (wpow (wlen as)) (mul (wlimb a) (wpow (wlen as))) iha)
             (le_rewrite (mul (suc (wlimb a)) (wpow (wlen as))) (add (mul (wlimb a) (wpow (wlen as))) (wpow (wlen as))) (mul M64 (wpow (wlen as))) (mul (wpow (wlen as)) M64)
                (compPath Nat (mul (suc (wlimb a)) (wpow (wlen as))) (add (wpow (wlen as)) (mul (wlimb a) (wpow (wlen as)))) (add (mul (wlimb a) (wpow (wlen as))) (wpow (wlen as)))
                   (prefl Nat (add (wpow (wlen as)) (mul (wlimb a) (wpow (wlen as)))))
                   (add_comm (wpow (wlen as)) (mul (wlimb a) (wpow (wlen as)))))
                (mul_comm M64 (wpow (wlen as)))
                (le_mul_r (suc (wlimb a)) M64 (wpow (wlen as)) (lt_le (wlimb a) M64 (snd a))))))
    x

-- ---- the comparison scan's head lemmas ----
-- A head limb decides on its own when it is strictly smaller - its weight alone already exceeds the other side,
-- whatever the tails are - and when the heads are equal the two weights cancel and the tails decide. Together these
-- are the recursion step: read the two heads, and only if they agree does the decision pass down.
def cmp_head_lt : (a b V A B : Nat) -> .(h : Lt a b) -> Lt A V -> Lt (add (mul a V) A) (add (mul b V) B) :=
  \a b V A B h hA ->
  lt_le_trans (add (mul a V) A) (mul b V) (add (mul b V) B)
     (lt_le_trans (add (mul a V) A) (add (mul a V) V) (mul b V)
        (lt_add_mono_l A V (mul a V) hA)
        (le_rewrite (mul (suc a) V) (add (mul a V) V) (mul b V) (mul b V)
           (compPath Nat (mul (suc a) V) (add V (mul a V)) (add (mul a V) V)
              (prefl Nat (add V (mul a V))) (add_comm V (mul a V)))
           (prefl Nat (mul b V))
           (le_mul_r (suc a) b V (lt_le a b h))))
     (B, prefl Nat (add (mul b V) B))
def lt_cancel_add : (X A B : Nat) -> Lt (add X A) (add X B) -> Lt A B :=
  \X A B h ->
  let hl : Le (suc (add X A)) (add X B) := lt_le (add X A) (add X B) h in
  let d : Nat := fst hl in
  le_lt A B (d,
    compPath Nat (add (suc A) d) (suc (add A d)) B
       (prefl Nat (suc (add A d)))
       (add_cancel_l X (suc (add A d)) B
          (compPath Nat (add X (suc (add A d))) (suc (add X (add A d))) (add X B)
             (add_suc_r X (add A d))
             (compPath Nat (suc (add X (add A d))) (suc (add (add X A) d)) (add X B)
                (cong Nat Nat suc (add X (add A d)) (add (add X A) d) (sym Nat (add (add X A) d) (add X (add A d)) (add_assoc X A d)))
                (snd hl)))))
def cmp_eq_lt : (a b V A B : Nat) -> Path Nat a b -> Lt A V -> Lt B V
    -> Lt (add (mul a V) A) (add (mul b V) B) -> Lt A B :=
  \a b V A B h hA hB hs ->
  lt_cancel_add (mul a V) A B
     (lt_rewrite (add (mul a V) A) (add (mul a V) A) (add (mul b V) B) (add (mul a V) B)
        (prefl Nat (add (mul a V) A))
        (sym Nat (add (mul a V) B) (add (mul b V) B) (cong Nat Nat (\w -> add (mul w V) B) a b h))
        hs)

-- ---- the comparison scan ----
-- A decision has two values, so ble_cases splits on it by the structure ble's own definition recurses on: that is
-- the case analysis a decision-valued proof needs, and it is structural rather than a walk. ble_not and ble_zero_not
-- are the two readings of a zero - the value that is NOT one - and lt_asym is what makes the scan's third case
-- (the head is greater) a zero. The scan itself is wltGoN, and wltGo is its Bool face; the law tying them to
-- blt of the values is what makes them a comparison.
-- decisions have two values: split on ble by the structure its own definition recurses on
def ble_cases : (x y : Nat) -> (P : U) -> (Id Nat (ble x y) 1 -> P) -> (Id Nat (ble x y) 0 -> P) -> P :=
  \x -> elim Nat (\x -> (y : Nat) -> (P : U) -> (Id Nat (ble x y) 1 -> P) -> (Id Nat (ble x y) 0 -> P) -> P)
    (\y P h1 h0 -> h1 (refl))
    (\k ih -> \y -> elim Nat
       (\y -> (P : U) -> (Id Nat (ble (suc k) y) 1 -> P) -> (Id Nat (ble (suc k) y) 0 -> P) -> P)
       (\P h1 h0 -> h0 (refl))
       (\n _ -> \P h1 h0 -> ih n P h1 h0)
       y)
    x
def ble_zero_not : (x y : Nat) -> Id Nat (ble x y) 0 -> Le x y -> Empty :=
  \x y h0 hle -> zeroNotOne (pathToId (compPath Nat 0 (ble x y) 1 (sym Nat (ble x y) 0 h0) (le_ble x y hle)))
def ble_not : (x y : Nat) -> Id Nat (ble x y) 0 -> Le (suc y) x :=
  \x -> elim Nat (\x -> (y : Nat) -> Id Nat (ble x y) 0 -> Le (suc y) x)
    (\y h -> elim Empty (\_ -> Le (suc y) 0) (zeroNotOne (pathToId (compPath Nat 0 (ble 0 y) 1 (sym Nat (ble 0 y) 0 h) (prefl Nat 1)))))
    (\k ih -> \y h -> elim Nat (\y -> Id Nat (ble (suc k) y) 0 -> Le (suc y) (suc k))
       (\_ -> (k, prefl Nat (suc k)))
       (\n _ -> \h -> le_suc_both (suc n) k (ih n h))
       y h)
    x
def lt_asym : (a b : Nat) -> .(h1 : Lt a b) -> .(h2 : Lt b a) -> Empty :=
  \a b h1 h2 -> lt_self_absurd a
     (le_trans (suc a) b a (lt_le a b h1) (le_of_le_suc b a (lt_le b a h2)))
def wltGoN (x y : WB) : Nat :=
  elim List (\_ -> WB -> Nat)
    (\y -> 0)
    (\a as iha -> \y -> elim List (\_ -> Nat)
       (0)
       (\b bs ihb -> if01 (ble (suc (wlimb a)) (wlimb b)) 1 (if01 (ble (suc (wlimb b)) (wlimb a)) 0 (iha bs)))
       y)
    x y
def wltGo (x y : WB) : Bool := n2b (wltGoN x y)

-- ---- the comparison scan's step ----
-- The step is arithmetic on the two head limbs and the two tails: a smaller head decides on its own, a greater head
-- decides against, and equal heads cancel their common weight so the tails decide. Equal weights cancel in DECISION
-- form (blt_cancel_add) - one direction from the monotonicity, the converse from the cancellation - which is what
-- lets the equal case hand over to the tails' own comparison.
def blt_cancel_add : (X A B : Nat) -> Path Nat (blt A B) (blt (add X A) (add X B)) :=
  \X A B -> ble_cases (suc A) B (Path Nat (blt A B) (blt (add X A) (add X B)))
    (\h1 -> compPath Nat (blt A B) 1 (blt (add X A) (add X B))
        (idToPath h1)
        (sym Nat (blt (add X A) (add X B)) 1 (idToPath (lt_add_mono_l A B X h1))))
    (\h0 -> ble_cases (suc (add X A)) (add X B) (Path Nat (blt A B) (blt (add X A) (add X B)))
        (\hbig -> elim Empty (\_ -> Path Nat (blt A B) (blt (add X A) (add X B)))
            (ble_zero_not (suc A) B h0 (lt_le A B (lt_cancel_add X A B hbig))))
        (\hsmall -> compPath Nat (blt A B) 0 (blt (add X A) (add X B))
            (idToPath h0)
            (sym Nat (blt (add X A) (add X B)) 0 (idToPath hsmall))))
def le_suc_suc : (a b : Nat) -> Le (suc a) (suc b) -> Le a b :=
  \a b h -> let d : Nat := fst h in (d, injSuc (snd h))
def wltGoN_step : (a' b' P A B : Nat) -> (hA : Lt A P) -> (hB : Lt B P)
    -> Path Nat (if01 (ble (suc a') b') 1 (if01 (ble (suc b') a') 0 (blt A B)))
               (blt (add (mul a' P) A) (add (mul b' P) B)) :=
  \a' b' P A B hA hB ->
  let L : Nat := if01 (ble (suc a') b') 1 (if01 (ble (suc b') a') 0 (blt A B)) in
  let R : Nat := blt (add (mul a' P) A) (add (mul b' P) B) in
  ble_cases (suc a') b' (Path Nat L R)
    (\h1 -> compPath Nat L 1 R
       (cong Nat Nat (\v -> if01 v 1 (if01 (ble (suc b') a') 0 (blt A B))) (ble (suc a') b') 1 (idToPath h1))
       (sym Nat R 1 (idToPath (cmp_head_lt a' b' P A B h1 hA))))
    (\h0 -> ble_cases (suc b') a' (Path Nat L R)
       (\h2 -> compPath Nat L (if01 (ble (suc b') a') 0 (blt A B)) R
          (cong Nat Nat (\v -> if01 v 1 (if01 (ble (suc b') a') 0 (blt A B))) (ble (suc a') b') 0 (idToPath h0))
          (compPath Nat (if01 (ble (suc b') a') 0 (blt A B)) 0 R
             (cong Nat Nat (\v -> if01 v 0 (blt A B)) (ble (suc b') a') 1 (idToPath h2))
             (ble_cases (suc (add (mul a' P) A)) (add (mul b' P) B) (Path Nat 0 R)
                (\hbig -> elim Empty (\_ -> Path Nat 0 R)
                   (lt_asym (add (mul a' P) A) (add (mul b' P) B) hbig (cmp_head_lt b' a' P B A h2 hB)))
                (\hsmall -> sym Nat R 0 (idToPath hsmall)))))
       (\h20 -> compPath Nat L (blt A B) R
          (compPath Nat L (if01 (ble (suc b') a') 0 (blt A B)) (blt A B)
             (cong Nat Nat (\v -> if01 v 1 (if01 (ble (suc b') a') 0 (blt A B))) (ble (suc a') b') 0 (idToPath h0))
             (cong Nat Nat (\v -> if01 v 0 (blt A B)) (ble (suc b') a') 0 (idToPath h20)))
          (compPath Nat (blt A B) (blt (add (mul b' P) A) (add (mul b' P) B)) R
             (blt_cancel_add (mul b' P) A B)
             (cong Nat Nat (\w -> blt (add (mul w P) A) (add (mul b' P) B)) b' a'
                (sym Nat a' b' (le_antisym a' b' (le_suc_suc a' b' (ble_not (suc b') a' h20)) (le_suc_suc b' a' (ble_not (suc a') b' h0))))))))

-- ---- the comparison scan's law ----
-- The step at the limb level rewrites the branches to the tails' own comparison and the heads to their weights, and
-- the induction is the same shape as the fold's: the lnil cases are the ones the length hypothesis rules out.
-- NOTE for whoever writes the next scan: the step applies the OUTER induction hypothesis (iha bs, as the fold's own
-- step does) rather than the inner eliminator's ihb. A lazy induction hypothesis is convertible with the recursive
-- call only once applied, so a step that uses its inner ihb bare does not unfold to the same thing.
def wltGoN_step_wb : (a b : Word) (as bs : WB)
    -> Path Nat (wpow (wlen bs)) (wpow (wlen as))
    -> Path Nat (wltGoN as bs) (blt (wbval as) (wbval bs))
    -> Path Nat (wltGoN (lcons a as) (lcons b bs)) (blt (wbval (lcons a as)) (wbval (lcons b bs))) :=
  \a b as bs hPQ ihv ->
  let a' : Nat := wlimb a in
  let b' : Nat := wlimb b in
  let P : Nat := wpow (wlen as) in
  let A : Nat := wbval as in
  let B : Nat := wbval bs in
  let Lg : Nat := if01 (ble (suc a') b') 1 (if01 (ble (suc b') a') 0 (blt A B)) in
  let Rg : Nat := blt (add (mul a' P) A) (add (mul b' P) B) in
  let hR : Path Nat Rg (blt (wbval (lcons a as)) (wbval (lcons b bs))) :=
     compPath Nat Rg
        (blt (add (mul a' P) A) (add (mul b' (wpow (wlen bs))) B))
        (blt (wbval (lcons a as)) (wbval (lcons b bs)))
        (cong Nat Nat (\w -> blt (add (mul a' P) A) (add (mul b' w) B)) P (wpow (wlen bs)) (sym Nat (wpow (wlen bs)) P hPQ))
        (compPath Nat
           (blt (add (mul a' P) A) (add (mul b' (wpow (wlen bs))) B))
           (blt (add (mul a' P) A) (wbval (lcons b bs)))
           (blt (wbval (lcons a as)) (wbval (lcons b bs)))
           (cong Nat Nat (\w -> blt (add (mul a' P) A) w) (add (mul b' (wpow (wlen bs))) B) (wbval (lcons b bs))
              (sym Nat (wbval (lcons b bs)) (add (mul (wlimb b) (wpow (wlen bs))) (wbval bs)) (wbval_cons b bs)))
           (cong Nat Nat (\w -> blt w (wbval (lcons b bs))) (add (mul a' P) A) (wbval (lcons a as))
              (sym Nat (wbval (lcons a as)) (add (mul (wlimb a) (wpow (wlen as))) (wbval as)) (wbval_cons a as)))) in
  compPath Nat
    (wltGoN (lcons a as) (lcons b bs))
    Lg
    (blt (wbval (lcons a as)) (wbval (lcons b bs)))
    (cong Nat Nat (\w -> if01 (ble (suc a') b') 1 (if01 (ble (suc b') a') 0 w)) (wltGoN as bs) (blt A B) ihv)
    (compPath Nat Lg Rg (blt (wbval (lcons a as)) (wbval (lcons b bs)))
       (wltGoN_step a' b' P A B (wbval_lt_wpow as) (lt_rewrite (wbval bs) (wbval bs) (wpow (wlen bs)) (wpow (wlen as)) (prefl Nat (wbval bs)) hPQ (wbval_lt_wpow bs)))
       hR)
-- the scan's law: equal lengths in, and the limbs' comparison is blt of the values
def wltGo_val : (x y : WB) -> Path Nat (wlen x) (wlen y) -> Path Nat (wltGoN x y) (blt (wbval x) (wbval y)) :=
  \x -> elim List (\x -> (y : WB) -> Path Nat (wlen x) (wlen y) -> Path Nat (wltGoN x y) (blt (wbval x) (wbval y)))
    (\y -> elim List (\y -> Path Nat (wlen (lnil {Word})) (wlen y) -> Path Nat (wltGoN (lnil {Word}) y) (blt (wbval (lnil {Word})) (wbval y)))
       (\h -> prefl Nat 0)
       (\b bs _ h -> elim Empty (\_ -> Path Nat (wltGoN (lnil {Word}) (lcons b bs)) (blt (wbval (lnil {Word})) (wbval (lcons b bs)))) (znots h))
       y)
    (\a as iha -> \y -> elim List
       (\y -> Path Nat (wlen (lcons a as)) (wlen y) -> Path Nat (wltGoN (lcons a as) y) (blt (wbval (lcons a as)) (wbval y)))
       (\h -> elim Empty (\_ -> Path Nat (wltGoN (lcons a as) (lnil {Word})) (blt (wbval (lcons a as)) (wbval (lnil {Word})))) (snotz h))
       (\b bs ihb h -> wltGoN_step_wb a b as bs
          (cong Nat Nat wpow (wlen bs) (wlen as) (sym Nat (wlen as) (wlen bs) (injSuc h)))
          (iha bs (injSuc h)))
       y)
    x

-- ---- b6: the borrow scan ----
-- The mirror of the carry scan, for the subtraction the erased Nat will need. wsubb gives a digit and a borrow of one
-- subtraction; the borrow in is subtracted from that digit by a second wsubb, and the two borrows are words 0/1 whose
-- sum is the column's borrow out. As in the carry scan, the step applies the OUTER induction hypothesis (iha bs) -
-- a lazy IH is convertible with the recursive call only once applied.
-- The value laws (the borrow analogue of waddGo_val, and the limb-level divmod that the Nat erasure also needs) are
-- the next pieces; the scan is defined here so the laws have their subject.
-- the borrowing column: (borrow out, digit), the mirror of wcol. wsubb gives the digit and the borrow of one
-- subtraction, and the borrow in is subtracted from that digit - its own borrow is the second borrow out.
def wsubl (b x y : Word) : Sigma Word (\_ -> Word) :=
  let s : Sigma Word (\_ -> Word) := wsubb x y in
  let t : Sigma Word (\_ -> Word) := wsubb (fst s) b in
  (wadd (snd s) (snd t), fst t)
-- the borrow scan: the borrows come back from the less significant side, exactly as the carries do
def wsubGo (x y : WB) : Sigma Word (\_ -> WB) :=
  elim List (\_ -> WB -> Sigma Word (\_ -> WB))
    (\y -> (0, lnil {Word}))
    (\a as iha -> \y -> elim List (\_ -> Sigma Word (\_ -> WB))
       (fst (wsubl (fst (iha (lnil {Word}))) a 0), lcons (snd (wsubl (fst (iha (lnil {Word}))) a 0)) (snd (iha (lnil {Word}))))
       (\b bs ihb -> (fst (wsubl (fst (iha bs)) a b), lcons (snd (wsubl (fst (iha bs)) a b)) (snd (iha bs))))
       y)
    x y

-- a wsubb's borrow is at most one: it is blt of the two limbs, split by ble_cases and unwrapped by mod_le_one
def wsubb_borrow_le : (x y : Word) -> Le (wlimb (snd (wsubb x y))) 1 :=
  \x y -> ble_cases (suc (fst x)) (fst y) (Le (wlimb (snd (wsubb x y))) 1)
     (\h1 -> le_rewrite (mod 1 M64) (mod (ble (suc (fst x)) (fst y)) M64) 1 1
        (sym Nat (mod (ble (suc (fst x)) (fst y)) M64) (mod 1 M64)
           (cong Nat Nat (\w -> mod w M64) (ble (suc (fst x)) (fst y)) 1 (idToPath h1)))
        (prefl Nat 1)
        (0, prefl Nat 1))
     (\h0 -> le_rewrite (mod 0 M64) (mod (ble (suc (fst x)) (fst y)) M64) 1 1
        (sym Nat (mod (ble (suc (fst x)) (fst y)) M64) (mod 0 M64)
           (cong Nat Nat (\w -> mod w M64) (ble (suc (fst x)) (fst y)) 0 (idToPath h0)))
        (prefl Nat 1)
        (1, prefl Nat 1))

-- ---- the borrow column's value law ----
-- d + y = x + borrow * M64: one wsubb's digit and borrow reconstruct the difference. ble_cases splits on the
-- comparison the borrow decides, add_sub_lt and add_sub_ge are the two halves of the two's complement identity for
-- the digit, and le_cancel_l reads the bound the negative half needs. Everything is stated over a symbolic bound
-- and every shuffle is a symbolic lemma (sub_add_shift): at a literal modulus the shuffles' own statements would
-- force add (mul 1 M64) r, which walks.
-- a wsubb's digit and borrow reconstruct the two limbs: d + y = x + borrow * M64
def wsubb_val : (x y : Word) -> Path Nat (add (wlimb (fst (wsubb x y))) (fst y)) (add (fst x) (mul (wlimb (snd (wsubb x y))) M64)) :=
  \x y -> ble_cases (suc (fst x)) (fst y)
     (Path Nat (add (wlimb (fst (wsubb x y))) (fst y)) (add (fst x) (mul (wlimb (snd (wsubb x y))) M64)))
     (\h1 ->
       let A : Nat := fst x in
       let B : Nat := fst y in
       let H : Le (suc A) B := lt_le A B h1 in
       let X : Nat := sub B A in
       let hBM64 : Le B M64 := le_of_le_suc B M64 (lt_le B M64 (snd y)) in
       let hXM : Le X M64 := le_trans X B M64 (sub_le B A) hBM64 in
       let eX : Path Nat (add A X) B :=
          compPath Nat (add A X) (add X A) B (sym Nat (add X A) (add A X) (add_comm X A)) (sub_add_le B A (le_of_le_suc A B H)) in
       let h1X : Le 1 X := le_cancel_l A 1 X
          (le_rewrite (suc A) (add A 1) B (add A X)
             (sym Nat (add A 1) (suc A) (add_one_r A)) (sym Nat (add A X) B eX) H) in
       let eLt : Lt (sub M64 X) M64 := le_lt (sub M64 X) M64
          (le_rewrite (add (sub M64 X) 1) (suc (sub M64 X)) M64 M64 (add_one_r (sub M64 X)) (prefl Nat M64)
             (le_trans (add (sub M64 X) 1) (add (sub M64 X) X) M64
                (add_mono_l 1 X (sub M64 X) h1X)
                (0, compPath Nat (add (add (sub M64 X) X) 0) (add (sub M64 X) X) M64
                   (add_zero_r (add (sub M64 X) X)) (sub_add_le M64 X hXM)))) in
       let eD : Path Nat (wlimb (fst (wsubb x y))) (sub M64 X) :=
          compPath Nat (wlimb (fst (wsubb x y))) (mod (add A (sub M64 B)) M64) (sub M64 X)
             (prefl Nat (mod (add A (sub M64 B)) M64))
             (compPath Nat (mod (add A (sub M64 B)) M64) (mod (sub M64 X) M64) (sub M64 X)
                (cong Nat Nat (\w -> mod w M64) (add A (sub M64 B)) (sub M64 X) (add_sub_lt M64 A B H hBM64))
                (mod_small M63 (sub M64 X) eLt)) in
       let eB : Path Nat (wlimb (snd (wsubb x y))) 1 :=
          compPath Nat (wlimb (snd (wsubb x y))) (mod (ble (suc A) B) M64) 1
             (prefl Nat (mod (ble (suc A) B) M64))
             (compPath Nat (mod (ble (suc A) B) M64) (mod 1 M64) 1
                (cong Nat Nat (\w -> mod w M64) (ble (suc A) B) 1 (idToPath h1))
                (prefl Nat 1)) in
       compPath Nat (add (wlimb (fst (wsubb x y))) B) (add (sub M64 X) B) (add A (mul (wlimb (snd (wsubb x y))) M64))
          (cong Nat Nat (\w -> add w B) (wlimb (fst (wsubb x y))) (sub M64 X) eD)
          (compPath Nat (add (sub M64 X) B) (add (sub M64 X) (add A X)) (add A (mul (wlimb (snd (wsubb x y))) M64))
             (cong Nat Nat (\w -> add (sub M64 X) w) B (add A X) (sym Nat (add A X) B eX))
             (compPath Nat (add (sub M64 X) (add A X)) (add A M64) (add A (mul (wlimb (snd (wsubb x y))) M64))
                (sub_add_shift M64 X A hXM)
                (compPath Nat (add A M64) (add A (mul 1 M64)) (add A (mul (wlimb (snd (wsubb x y))) M64))
                   (cong Nat Nat (\w -> add A w) M64 (mul 1 M64) (prefl Nat M64))
                   (cong Nat Nat (\w -> add A (mul w M64)) 1 (wlimb (snd (wsubb x y))) (sym Nat (wlimb (snd (wsubb x y))) 1 eB))))))
     (\h0 ->
       let A : Nat := fst x in
       let B : Nat := fst y in
       let hBA : Le B A := le_suc_suc B A (ble_not (suc A) B h0) in
       let hBM64 : Le B M64 := le_of_le_suc B M64 (lt_le B M64 (snd y)) in
       let eAdd : Path Nat (add A (sub M64 B)) (add (sub A B) M64) := add_sub_ge M64 A B hBA hBM64 in
       let eLt : Lt (sub A B) M64 := lt_le_trans (sub A B) A M64 (sub_le A B) (le_of_le_suc A M64 (lt_le A M64 (snd x))) in
       let eD : Path Nat (wlimb (fst (wsubb x y))) (sub A B) :=
          compPath Nat (wlimb (fst (wsubb x y))) (mod (add A (sub M64 B)) M64) (sub A B)
             (prefl Nat (mod (add A (sub M64 B)) M64))
             (compPath Nat (mod (add A (sub M64 B)) M64) (mod (add (sub A B) M64) M64) (sub A B)
                (cong Nat Nat (\w -> mod w M64) (add A (sub M64 B)) (add (sub A B) M64) eAdd)
                (compPath Nat (mod (add (sub A B) M64) M64) (mod (sub A B) M64) (sub A B)
                   (mod_add_mul (sub A B) 1 M63)
                   (mod_small M63 (sub A B) eLt))) in
       let eB0 : Path Nat (wlimb (snd (wsubb x y))) 0 :=
          compPath Nat (wlimb (snd (wsubb x y))) (mod (ble (suc A) B) M64) 0
             (prefl Nat (mod (ble (suc A) B) M64))
             (compPath Nat (mod (ble (suc A) B) M64) (mod 0 M64) 0
                (cong Nat Nat (\w -> mod w M64) (ble (suc A) B) 0 (idToPath h0))
                (prefl Nat 0)) in
       compPath Nat (add (wlimb (fst (wsubb x y))) B) (add (sub A B) B) (add A (mul (wlimb (snd (wsubb x y))) M64))
          (cong Nat Nat (\w -> add w B) (wlimb (fst (wsubb x y))) (sub A B) eD)
          (compPath Nat (add (sub A B) B) A (add A (mul (wlimb (snd (wsubb x y))) M64))
             (sub_add_le A B hBA)
             (sym Nat (add A (mul (wlimb (snd (wsubb x y))) M64)) A (compPath Nat (add A (mul (wlimb (snd (wsubb x y))) M64)) (add A (mul 0 M64)) A
                (cong Nat Nat (\w -> add A (mul w M64)) (wlimb (snd (wsubb x y))) 0 eB0)
                ((compPath Nat (add A (mul 0 M64)) (add A 0) A
                (cong Nat Nat (\w -> add A w) (mul 0 M64) 0 (prefl Nat 0))
                (add_zero_r A)))))))

-- ---- the borrow column's identity ----
-- A single wsubb gives a digit and a borrow, named here so the column's algebra stays readable. The column subtracts
-- twice - the borrow in from the first digit - and its identity is (digit + borrow in) + y = x + (b1 + b2) * M64,
-- with the borrow out's mod still unwrapped: that is wsubl_val's job, and it needs the two single-subtraction
-- borrows bounded first (they cannot both be one, or the column's total would exceed two machine words).
-- the two things a single wsubb gives: its digit and its borrow, named
def wdigit (x y : Word) : Nat := wlimb (fst (wsubb x y))
def wborrow (x y : Word) : Nat := wlimb (snd (wsubb x y))
-- and the column's own: the digit of the second subtraction, and the borrow it leaves
def wsubl_digit (b x y : Word) : Nat := wdigit (fst (wsubb x y)) b
def wsubl_bo (b x y : Word) : Nat := wlimb (fst (wsubl b x y))
-- the column's identity, before the borrow out's mod is unwrapped:
-- (digit + borrow in) + y = x + (the two single-subtraction borrows, summed) * M64
def wsubl_shift : (b x y : Word) -> Path Nat
    (add (add (wsubl_digit b x y) (fst b)) (fst y))
    (add (fst x) (mul (add (wborrow x y) (wborrow (fst (wsubb x y)) b)) M64)) :=
  \b x y ->
  let d1 : Nat := wdigit x y in
  let e : Nat := wborrow (fst (wsubb x y)) b in
  let c : Nat := fst b in
  let b1 : Nat := wborrow x y in
  compPath Nat
    (add (add (wsubl_digit b x y) c) (fst y))
    (add (add d1 (mul e M64)) (fst y))
    (add (fst x) (mul (add b1 e) M64))
    (cong Nat Nat (\w -> add w (fst y)) (add (wsubl_digit b x y) c) (add d1 (mul e M64)) (wsubb_val (fst (wsubb x y)) b))
    (compPath Nat
       (add (add d1 (mul e M64)) (fst y))
       (add d1 (add (mul e M64) (fst y)))
       (add (fst x) (mul (add b1 e) M64))
       (add_assoc d1 (mul e M64) (fst y))
       (compPath Nat
          (add d1 (add (mul e M64) (fst y)))
          (add d1 (add (fst y) (mul e M64)))
          (add (fst x) (mul (add b1 e) M64))
          (cong Nat Nat (\w -> add d1 w) (add (mul e M64) (fst y)) (add (fst y) (mul e M64)) (add_comm (mul e M64) (fst y)))
          (compPath Nat
             (add d1 (add (fst y) (mul e M64)))
             (add (add d1 (fst y)) (mul e M64))
             (add (fst x) (mul (add b1 e) M64))
             (sym Nat (add (add d1 (fst y)) (mul e M64)) (add d1 (add (fst y) (mul e M64))) (add_assoc d1 (fst y) (mul e M64)))
             (compPath Nat
                (add (add d1 (fst y)) (mul e M64))
                (add (add (fst x) (mul b1 M64)) (mul e M64))
                (add (fst x) (mul (add b1 e) M64))
                (cong Nat Nat (\w -> add w (mul e M64)) (add d1 (fst y)) (add (fst x) (mul b1 M64)) (wsubb_val x y))
                (compPath Nat
                   (add (add (fst x) (mul b1 M64)) (mul e M64))
                   (add (fst x) (add (mul b1 M64) (mul e M64)))
                   (add (fst x) (mul (add b1 e) M64))
                   (add_assoc (fst x) (mul b1 M64) (mul e M64))
                   (cong Nat Nat (\w -> add (fst x) w)
                      (add (mul b1 M64) (mul e M64))
                      (mul (add b1 e) M64)
                      (sym Nat (mul (add b1 e) M64) (add (mul b1 M64) (mul e M64)) (mul_dist_r b1 e M64))))))))

-- ---- the three-term bound ----
-- suc (m + (m - 1)) is 2m once m is at least one, and a bound below m survives pred. With le_pred_one they give the
-- bound the borrow column's exclusion needs, stated OVER A SYMBOLIC MODULUS: at the machine word the same bound
-- cannot be assembled from the literal lemmas, because mul_two M64 and any add with M64 in its first position walk.
def suc_pred_self : (X : Nat) -> Le 1 X -> Path Nat (suc (sub X 1)) X :=
  \X h -> let d : Nat := fst h in
    compPath Nat (suc (sub X 1)) (suc d) X
       (cong Nat Nat suc (pred X) d (sym Nat d (pred X) (cong Nat Nat pred (add 1 d) X (snd h))))
       (snd h)
def two_mul_pred : (m : Nat) -> Le 1 m -> Path Nat (suc (add m (sub m 1))) (mul 2 m) :=
  \m -> elim Nat (\m -> Le 1 m -> Path Nat (suc (add m (sub m 1))) (mul 2 m))
    (\h -> elim Empty (\_ -> Path Nat (suc (add 0 (sub 0 1))) (mul 2 0)) (lt_self_absurd 0 h))
    (\k _ -> \h -> compPath Nat
       (suc (add (suc k) (sub (suc k) 1)))
       (suc (add (suc k) k))
       (mul 2 (suc k))
       (prefl Nat (suc (add (suc k) k)))
       (compPath Nat (suc (add (suc k) k)) (suc (add k (suc k))) (mul 2 (suc k))
          (cong Nat Nat suc (add (suc k) k) (add k (suc k)) (add_comm (suc k) k))
          (sym Nat (mul 2 (suc k)) (suc (add k (suc k))) (mul_two (suc k)))))
    m
-- two words' worth of bound from three terms: a below m, b at most one, c below m
def lt_add_three_le : (a b c m : Nat) -> Le (suc a) m -> Le b 1 -> Le (suc c) m -> Le (suc (add (add a b) c)) (mul 2 m) :=
  \a b c m ha hb hc ->
  let hab : Le (add a b) (suc a) :=
     le_rewrite (add a b) (add a b) (add a 1) (suc a) (prefl Nat (add a b)) (add_one_r a)
        (add_mono_l b 1 a hb) in
  let hm : Le (add a b) m := le_trans (add a b) (suc a) m hab ha in
  let hc' : Le c (sub m 1) := le_pred_one c m hc in
  let hsum : Le (add (add a b) c) (add m (sub m 1)) := le_add_le (add a b) m c (sub m 1) hm hc' in
  let hm1 : Le 1 m := le_trans 1 (suc a) m (a, prefl Nat (suc a)) ha in
  le_rewrite (suc (add (add a b) c)) (suc (add (add a b) c)) (suc (add m (sub m 1))) (mul 2 m)
     (prefl Nat (suc (add (add a b) c))) (two_mul_pred m hm1)
     (le_suc_both (add (add a b) c) (add m (sub m 1)) hsum)

-- the borrow column's exclusion, upper half: (digit + borrow in) + y is within two words of the limbs'
-- own bounds, by the three-term bound stated over a symbolic modulus.
def wsubl_bo_upper : (b x y : Word) -> Le (wlimb b) 1 ->
    Le (suc (add (add (wsubl_digit b x y) (fst b)) (fst y))) (mul 2 M64) :=
  \b x y hc -> lt_add_three_le (wsubl_digit b x y) (fst b) (fst y) M64
     (lt_le (fst (fst (wsubb (fst (wsubb x y)) b))) M64 (snd (fst (wsubb (fst (wsubb x y)) b)))) hc
     (lt_le (fst y) M64 (snd y))

-- the exclusion's lower half: if the two borrows summed to two, the column's total would reach two words, and the
-- shift is what says so - read backwards through the rewrite, with the witness commuted into place.
def wsubl_bo_lower : (b x y : Word) -> Le 2 (add (wborrow x y) (wborrow (fst (wsubb x y)) b)) ->
    Le (mul 2 M64) (add (add (wsubl_digit b x y) (fst b)) (fst y)) :=
  \b x y h2 -> le_rewrite (mul 2 M64) (mul 2 M64)
     (add (fst x) (mul (add (wborrow x y) (wborrow (fst (wsubb x y)) b)) M64))
     (add (add (wsubl_digit b x y) (fst b)) (fst y))
     (prefl Nat (mul 2 M64))
     (sym Nat (add (add (wsubl_digit b x y) (fst b)) (fst y)) (add (fst x) (mul (add (wborrow x y) (wborrow (fst (wsubb x y)) b)) M64)) (wsubl_shift b x y))
     (le_trans (mul 2 M64) (mul (add (wborrow x y) (wborrow (fst (wsubb x y)) b)) M64)
        (add (fst x) (mul (add (wborrow x y) (wborrow (fst (wsubb x y)) b)) M64))
        (le_mul_r 2 (add (wborrow x y) (wborrow (fst (wsubb x y)) b)) M64 h2)
        (fst x, add_comm (mul (add (wborrow x y) (wborrow (fst (wsubb x y)) b)) M64) (fst x)))

-- ---- the borrow column's value law ----
-- The column subtracts twice, and this is what it is worth: (digit + borrow in) + y = x + borrow out * M64. It is the
-- shift with the borrow out's mod unwrapped, and the unwrap is licensed by the exclusion - the two single-subtraction
-- borrows cannot both be one, or the column's total would reach two words while the limbs cap it below.
-- the exclusion, as the fact about the two borrows' sum that both the bound and the law want
def wsubl_bo_sum_le : (b x y : Word) -> Le (wlimb b) 1 ->
    Le (add (wborrow x y) (wborrow (fst (wsubb x y)) b)) 1 :=
  \b x y hc ->
  let bo : Nat := add (wborrow x y) (wborrow (fst (wsubb x y)) b) in
  let Z : Nat := add (add (wsubl_digit b x y) (fst b)) (fst y) in
  le_one_of_not_le_two bo
     (\h2 -> lt_self_absurd Z
        (le_trans (suc Z) (mul 2 M64) Z (wsubl_bo_upper b x y hc) (wsubl_bo_lower b x y h2)))
def wsubl_bo_le : (b x y : Word) -> Le (wlimb b) 1 -> Le (wsubl_bo b x y) 1 :=
  \b x y hc ->
  let bo : Nat := add (wborrow x y) (wborrow (fst (wsubb x y)) b) in
  let hle : Le bo 1 := wsubl_bo_sum_le b x y hc in
  le_rewrite bo (mod bo M64) 1 1 (sym Nat (mod bo M64) bo (mod_le_one bo hle)) (prefl Nat 1) hle
-- the column's value law: digit + borrow in, plus y, is x plus the borrow out's weight
def wsubl_val : (b x y : Word) -> Le (wlimb b) 1 ->
    Path Nat (add (add (wsubl_digit b x y) (fst b)) (fst y)) (add (fst x) (mul (wsubl_bo b x y) M64)) :=
  \b x y hc ->
  let bo : Nat := add (wborrow x y) (wborrow (fst (wsubb x y)) b) in
  compPath Nat
    (add (add (wsubl_digit b x y) (fst b)) (fst y))
    (add (fst x) (mul bo M64))
    (add (fst x) (mul (wsubl_bo b x y) M64))
    (wsubl_shift b x y)
    (cong Nat Nat (\w -> add (fst x) (mul w M64)) bo (wsubl_bo b x y)
       (compPath Nat bo (mod bo M64) (wsubl_bo b x y)
          (sym Nat (mod bo M64) bo (mod_le_one bo (wsubl_bo_sum_le b x y hc)))
          (prefl Nat (wsubl_bo b x y))))

-- the borrow counterpart of fold_step_mid: the column's law and the IH, shuffled.
-- Pure Nat, so it can be checked on its own, and symbolic, so nothing forces a literal.
def sub_step_mid : (dl c bl al bol V Z UB UA : Nat)
    -> Path Nat (add (add dl c) bl) (add al (mul bol M64))
    -> Path Nat (add Z UB) (add UA (mul c V))
    -> Path Nat (add (add (mul dl V) Z) (add (mul bl V) UB)) (add (add (mul al V) UA) (mul bol (mul V M64))) :=
  \dl c bl al bol V Z UB UA hcol ih -> compPath Nat
    (add (add (mul dl V) Z) (add (mul bl V) UB))
    (add (add (mul dl V) (mul bl V)) (add Z UB))
    (add (add (mul al V) UA) (mul bol (mul V M64)))
    (add_interchange (mul dl V) Z (mul bl V) UB)
    (compPath Nat
       (add (add (mul dl V) (mul bl V)) (add Z UB))
       (add (mul (add dl bl) V) (add Z UB))
       (add (add (mul al V) UA) (mul bol (mul V M64)))
       (cong Nat Nat (\w -> add w (add Z UB)) (add (mul dl V) (mul bl V)) (mul (add dl bl) V)
          (sym Nat (mul (add dl bl) V) (add (mul dl V) (mul bl V)) (mul_dist_r dl bl V)))
       (compPath Nat
          (add (mul (add dl bl) V) (add Z UB))
          (add UA (add (mul (add dl bl) V) (mul c V)))
          (add (add (mul al V) UA) (mul bol (mul V M64)))
          (compPath Nat
             (add (mul (add dl bl) V) (add Z UB))
             (add (mul (add dl bl) V) (add UA (mul c V)))
             (add UA (add (mul (add dl bl) V) (mul c V)))
             (cong Nat Nat (\w -> add (mul (add dl bl) V) w) (add Z UB) (add UA (mul c V)) ih)
             (add_swap (mul (add dl bl) V) UA (mul c V)))
          (compPath Nat
             (add UA (add (mul (add dl bl) V) (mul c V)))
             (add UA (mul (add (add dl c) bl) V))
             (add (add (mul al V) UA) (mul bol (mul V M64)))
             (cong Nat Nat (\w -> add UA w)
                (add (mul (add dl bl) V) (mul c V))
                (mul (add (add dl c) bl) V)
                (compPath Nat
                   (add (mul (add dl bl) V) (mul c V))
                   (mul (add (add dl bl) c) V)
                   (mul (add (add dl c) bl) V)
                   (sym Nat (mul (add (add dl bl) c) V) (add (mul (add dl bl) V) (mul c V)) (mul_dist_r (add dl bl) c V))
                   (cong Nat Nat (\w -> mul w V) (add (add dl bl) c) (add (add dl c) bl)
                      (compPath Nat (add (add dl bl) c) (add dl (add bl c)) (add (add dl c) bl)
                         (add_assoc dl bl c)
                         (compPath Nat (add dl (add bl c)) (add dl (add c bl)) (add (add dl c) bl)
                            (cong Nat Nat (\w -> add dl w) (add bl c) (add c bl) (add_comm bl c))
                            (sym Nat (add (add dl c) bl) (add dl (add c bl)) (add_assoc dl c bl)))))))
             (compPath Nat
                (add UA (mul (add (add dl c) bl) V))
                (add UA (mul (add al (mul bol M64)) V))
                (add (add (mul al V) UA) (mul bol (mul V M64)))
                (cong Nat Nat (\w -> add UA w) (mul (add (add dl c) bl) V) (mul (add al (mul bol M64)) V)
                   (cong Nat Nat (\w -> mul w V) (add (add dl c) bl) (add al (mul bol M64)) hcol))
                (compPath Nat
                   (add UA (mul (add al (mul bol M64)) V))
                   (add UA (add (mul al V) (mul (mul bol M64) V)))
                   (add (add (mul al V) UA) (mul bol (mul V M64)))
                   (cong Nat Nat (\w -> add UA w) (mul (add al (mul bol M64)) V) (add (mul al V) (mul (mul bol M64) V)) (mul_dist_r al (mul bol M64) V))
                   (compPath Nat
                      (add UA (add (mul al V) (mul (mul bol M64) V)))
                      (add UA (add (mul al V) (mul bol (mul V M64))))
                      (add (add (mul al V) UA) (mul bol (mul V M64)))
                      (cong Nat Nat (\w -> add UA w) (add (mul al V) (mul (mul bol M64) V)) (add (mul al V) (mul bol (mul V M64)))
                         (cong Nat Nat (\w -> add (mul al V) w) (mul (mul bol M64) V) (mul bol (mul V M64))
                            (compPath Nat (mul (mul bol M64) V) (mul bol (mul M64 V)) (mul bol (mul V M64))
                               (mul_assoc bol M64 V)
                               (cong Nat Nat (\w -> mul bol w) (mul M64 V) (mul V M64) (mul_comm M64 V)))))
                      (sym Nat (add (add (mul al V) UA) (mul bol (mul V M64))) (add UA (add (mul al V) (mul bol (mul V M64)))) (compPath Nat (add (add (mul al V) UA) (mul bol (mul V M64))) (add (mul al V) (add UA (mul bol (mul V M64)))) (add UA (add (mul al V) (mul bol (mul V M64)))) (add_assoc (mul al V) UA (mul bol (mul V M64))) (add_swap (mul al V) UA (mul bol (mul V M64)))))))))))

-- ---- the borrow scan's law ----
-- The step is wstep_val's shape (the two cons laws and the weight alignment) around sub_step_mid, which is the
-- column's law and the IH shuffled. The invariant carries the value law in the mirror orientation - z + y =
-- x + borrow * 2^(64 len) - the borrow out, and the result's length; wsubl_bo_le is what hands the borrow to
-- the next column, exactly as the carry's bound did.
-- the borrow scan's step: the limb-level rewrites (two cons laws, the weight alignment) around sub_step_mid, which
-- is the column's law and the IH shuffled. The mirror of wstep_val.
def wsubGo_step_val : (a b : Word) (as bs : WB) (r : Sigma Word (\_ -> WB))
    -> Le (wlimb (fst r)) 1
    -> Path Nat (wlen as) (wlen bs)
    -> Path Nat (wlen (snd r)) (wlen as)
    -> Path Nat (add (wbval (snd r)) (wbval bs)) (add (wbval as) (mul (wlimb (fst r)) (wpow (wlen (snd r)))))
    -> Path Nat (add (wbval (lcons (snd (wsubl (fst r) a b)) (snd r))) (wbval (lcons b bs)))
               (add (wbval (lcons a as)) (mul (wlimb (fst (wsubl (fst r) a b))) (wpow (wlen (lcons (snd (wsubl (fst r) a b)) (snd r)))))) :=
  \a b as bs r hc hlen hL ihv ->
  let c : Nat := wlimb (fst r) in
  let z : WB := snd r in
  let V : Nat := wpow (wlen z) in
  let P : Nat := wpow (wlen as) in
  let Q : Nat := wpow (wlen bs) in
  let hPV : Path Nat V P := cong Nat Nat wpow (wlen z) (wlen as) hL in
  let hVQ : Path Nat V Q := compPath Nat V P Q hPV (cong Nat Nat wpow (wlen as) (wlen bs) hlen) in
  let d : Word := snd (wsubl (fst r) a b) in
  let bo : Word := fst (wsubl (fst r) a b) in
  let A1 : Nat := mul (wlimb a) V in
  let Z : Nat := wbval z in
  let UA : Nat := wbval as in
  let UB : Nat := wbval bs in
  let hcol : Path Nat (add (add (wlimb d) c) (wlimb b)) (add (wlimb a) (mul (wlimb bo) M64)) :=
     wsubl_val (fst r) a b hc in
  compPath Nat
    (add (wbval (lcons d z)) (wbval (lcons b bs)))
    (add (add (mul (wlimb d) V) Z) (add (mul (wlimb b) V) UB))
    (add (wbval (lcons a as)) (mul (wlimb bo) (wpow (wlen (lcons d z)))))
    (compPath Nat
       (add (wbval (lcons d z)) (wbval (lcons b bs)))
       (add (add (mul (wlimb d) (wpow (wlen z))) (wbval z)) (add (mul (wlimb b) Q) (wbval bs)))
       (add (add (mul (wlimb d) V) Z) (add (mul (wlimb b) V) UB))
       (compPath Nat
          (add (wbval (lcons d z)) (wbval (lcons b bs)))
          (add (add (mul (wlimb d) (wpow (wlen z))) (wbval z)) (wbval (lcons b bs)))
          (add (add (mul (wlimb d) (wpow (wlen z))) (wbval z)) (add (mul (wlimb b) Q) (wbval bs)))
          (cong Nat Nat (\w -> add w (wbval (lcons b bs))) (wbval (lcons d z)) (add (mul (wlimb d) (wpow (wlen z))) (wbval z)) (wbval_cons d z))
          (cong Nat Nat (\w -> add (add (mul (wlimb d) (wpow (wlen z))) (wbval z)) w) (wbval (lcons b bs)) (add (mul (wlimb b) Q) (wbval bs)) (wbval_cons b bs)))
       (cong Nat Nat (\w -> add (add (mul (wlimb d) (wpow (wlen z))) (wbval z)) (add (mul (wlimb b) w) (wbval bs))) Q V (sym Nat V Q hVQ)))
    (compPath Nat
       (add (add (mul (wlimb d) V) Z) (add (mul (wlimb b) V) UB))
       (add (add A1 UA) (mul (wlimb bo) (mul V M64)))
       (add (wbval (lcons a as)) (mul (wlimb bo) (wpow (wlen (lcons d z)))))
       (sub_step_mid (wlimb d) c (wlimb b) (wlimb a) (wlimb bo) V Z UB UA hcol ihv)
       (compPath Nat
          (add (add A1 UA) (mul (wlimb bo) (mul V M64)))
          (add (wbval (lcons a as)) (mul (wlimb bo) (mul V M64)))
          (add (wbval (lcons a as)) (mul (wlimb bo) (wpow (wlen (lcons d z)))))
          (cong Nat Nat (\w -> add w (mul (wlimb bo) (mul V M64))) (add A1 UA) (wbval (lcons a as))
             (compPath Nat (add A1 UA) (add (mul (wlimb a) P) UA) (wbval (lcons a as))
                (cong Nat Nat (\w -> add w UA) A1 (mul (wlimb a) P) (cong Nat Nat (\w -> mul (wlimb a) w) V P hPV))
                (sym Nat (wbval (lcons a as)) (add (mul (wlimb a) P) (wbval as)) (wbval_cons a as))))
          (cong Nat Nat (\w -> add (wbval (lcons a as)) (mul (wlimb bo) w)) (mul V M64) (wpow (wlen (lcons d z))) (prefl Nat (wpow (wlen (lcons d z)))))))
-- what the borrow scan is worth, bundled: the value law in the mirror orientation, the borrow out, and the length
def WSubInv (x y : WB) : U :=
  Sigma (Path Nat (add (wbval (snd (wsubGo x y))) (wbval y)) (add (wbval x) (mul (wlimb (fst (wsubGo x y))) (wpow (wlen (snd (wsubGo x y)))))))
    (\_ -> Sigma (Le (wlimb (fst (wsubGo x y))) 1) (\_ -> Path Nat (wlen (snd (wsubGo x y))) (wlen x)))
def wsubGo_val : (x y : WB) -> Path Nat (wlen x) (wlen y) -> WSubInv x y :=
  \x -> elim List (\x -> (y : WB) -> Path Nat (wlen x) (wlen y) -> WSubInv x y)
    (\y -> elim List (\y -> Path Nat (wlen (lnil {Word})) (wlen y) -> WSubInv (lnil {Word}) y)
       (\h -> (prefl Nat 0, ((1, prefl Nat 1), prefl Nat 0)))
       (\b bs _ h -> elim Empty (\_ -> WSubInv (lnil {Word}) (lcons b bs)) (znots h))
       y)
    (\a as iha -> \y -> elim List (\y -> Path Nat (wlen (lcons a as)) (wlen y) -> WSubInv (lcons a as) y)
       (\h -> elim Empty (\_ -> WSubInv (lcons a as) (lnil {Word})) (snotz h))
       (\b bs ihb h ->
          let hs : Path Nat (wlen as) (wlen bs) := injSuc h in
          let r : Sigma Word (\_ -> WB) := wsubGo as bs in
          let ihv : WSubInv as bs := iha bs hs in
          let hc : Le (wlimb (fst r)) 1 := fst (snd ihv) in
          ( wsubGo_step_val a b as bs r hc hs (snd (snd ihv)) (fst ihv),
            ( wsubl_bo_le (fst r) a b hc,
              cong Nat Nat suc (wlen (snd r)) (wlen as) (snd (snd ihv)) ) ))
       y)
    x

-- ---- the pad, and the value laws it keeps (M16b, 2026-09-16) ----
-- A limb chain reads most significant limb first (waddGo's carry comes back from the tail, which is the low end),
-- so padding a chain to a length is PREPENDING zero limbs: the value is untouched, and the length grows by one per
-- limb. The chain operations that need both operands at one length (the addition and subtraction of the Nat layer)
-- go through this.
def wzap (k : Nat) (x : WB) : WB := elim Nat (\_ -> WB -> WB) (\x -> x) (\_ ih -> \x -> ih (lcons 0 x)) k x
def mul_zero_l : (n : Nat) -> Path Nat (mul 0 n) 0 :=
  \n -> compPath Nat (mul 0 n) (mul n 0) 0 (mul_comm 0 n) (mul_zero_r n)
def wbval_lcons0 : (x : WB) -> Path Nat (wbval (lcons 0 x)) (wbval x) :=
  \x -> compPath Nat (wbval (lcons 0 x)) (add (mul 0 (wpow (wlen x))) (wbval x)) (wbval x)
    (wbval_cons 0 x)
    (compPath Nat (add (mul 0 (wpow (wlen x))) (wbval x)) (add 0 (wbval x)) (wbval x)
       (cong Nat Nat (\w -> add w (wbval x)) (mul 0 (wpow (wlen x))) 0 (mul_zero_l (wpow (wlen x))))
       (add_zero_l (wbval x)))
def wbval_zap : (k : Nat) (x : WB) -> Path Nat (wbval (wzap k x)) (wbval x) :=
  \k -> elim Nat (\k -> (x : WB) -> Path Nat (wbval (wzap k x)) (wbval x))
    (\x -> prefl Nat (wbval x))
    (\k ih -> \x -> compPath Nat (wbval (wzap (suc k) x)) (wbval (wzap k (lcons 0 x))) (wbval x)
       (prefl Nat (wbval (wzap k (lcons 0 x))))
       (compPath Nat (wbval (wzap k (lcons 0 x))) (wbval (lcons 0 x)) (wbval x)
          (ih (lcons 0 x))
          (wbval_lcons0 x)))
    k
-- The chain operations the Nat layer's arithmetic is, and the C list's own primitives. Each operand is padded by
-- one more than the OTHER's length, so both reach a common length with no subtraction, and each value stays below
-- M64^(its own length), hence below M64^N for N the two lengths' sum - so the sum is below twice M64^N, which is
-- at most M64^(N+1), the padded length. That is what makes the top column's carry out zero, and the value laws
-- below are the obligations the C list's badd and bsub must meet. The bodies are the definitions;
-- what they owe the run time is that the chain's value is the naturals' sum (and, for the difference, monus) -
-- those value laws are the next laws of this file. The subtraction keeps the difference only when the fold did not
-- borrow: a borrow out of the top column means the subtrahend was the larger, and the answer is the empty chain.
def badd (x y : WB) : WB := snd (waddGo (wzap (suc (wlen y)) x) (wzap (suc (wlen x)) y))
def bsub (x y : WB) : WB :=
  let r : Sigma Word (\_ -> WB) := wsubGo (wzap (suc (wlen y)) x) (wzap (suc (wlen x)) y) in
  elim Nat (\_ -> WB) (snd r) (\_ _ -> lnil {Word}) (wlimb (fst r))
def wlen_zap : (k : Nat) (x : WB) -> Path Nat (wlen (wzap k x)) (add k (wlen x)) :=
  \k -> elim Nat (\k -> (x : WB) -> Path Nat (wlen (wzap k x)) (add k (wlen x)))
    (\x -> prefl Nat (wlen x))
    (\k ih -> \x -> compPath Nat (wlen (wzap (suc k) x)) (wlen (wzap k (lcons 0 x))) (suc (add k (wlen x)))
       (prefl Nat (wlen (wzap k (lcons 0 x))))
       (compPath Nat (wlen (wzap k (lcons 0 x))) (add k (wlen (lcons 0 x))) (suc (add k (wlen x)))
          (ih (lcons 0 x))
          (compPath Nat (add k (wlen (lcons 0 x))) (add k (suc (wlen x))) (suc (add k (wlen x)))
             (cong Nat Nat (\w -> add k w) (wlen (lcons 0 x)) (suc (wlen x)) (wlen_cons 0 x))
             (add_suc_r k (wlen x)))))
    k

-- ---- the arithmetic the sum bound needs (M16b, 2026-09-16) ----
-- The carry out of a padded fold is zero because the two values are strictly below M64^n between them. Getting
-- there needs the base's own arithmetic, and every lemma here is stated over a SYMBOLIC base: wpow's base is a
-- parameter (wpowK), so a proof by induction on the exponent never chews a literal.
def wpow_add : (a b : Nat) -> Path Nat (wpow (add a b)) (mul (wpow a) (wpow b)) :=
  \a b -> elim Nat (\c -> Path Nat (wpow (add a c)) (mul (wpow a) (wpow c)))
    (compPath Nat (wpow (add a 0)) (wpow a) (mul (wpow a) (wpow 0))
       (cong Nat Nat wpow (add a 0) a (add_zero_r a))
       (compPath Nat (wpow a) (mul (wpow a) 1) (mul (wpow a) (wpow 0))
          (sym Nat (mul (wpow a) 1) (wpow a) (mul_one_r (wpow a)))
          (prefl Nat (mul (wpow a) 1))))
    (\k ih -> compPath Nat (wpow (add a (suc k))) (mul (wpow (add a k)) M64) (mul (wpow a) (mul (wpow k) M64))
       (compPath Nat (wpow (add a (suc k))) (wpow (suc (add a k))) (mul (wpow (add a k)) M64)
          (cong Nat Nat wpow (add a (suc k)) (suc (add a k)) (add_suc_r a k))
          (wpow_suc (add a k)))
       (compPath Nat (mul (wpow (add a k)) M64) (mul (mul (wpow a) (wpow k)) M64) (mul (wpow a) (mul (wpow k) M64))
          (cong Nat Nat (\w -> mul w M64) (wpow (add a k)) (mul (wpow a) (wpow k)) ih)
          (mul_assoc (wpow a) (wpow k) M64)))
    b
def le_one_m64 : Le 1 M64 := lt_le 0 M64 refl
def le_two_m64 : Le 2 M64 := lt_le 1 M64 refl
def one_le_mul : (x y : Nat) -> Le 1 x -> Le 1 y -> Le 1 (mul x y) :=
  \x y hx hy -> le_trans 1 y (mul x y) hy
    (le_rewrite (mul 1 y) y (mul x y) (mul x y) (add_zero_r y) (prefl Nat (mul x y)) (le_mul_r 1 x y hx))
def one_le_wpowK : (K k : Nat) -> Le 1 K -> Le 1 (wpowK K k) :=
  \K k hK -> elim Nat (\j -> Le 1 (wpowK K j)) (le_refl 1)
    (\j ih -> le_rewrite 1 1 (mul (wpowK K j) K) (wpowK K (suc j))
       (prefl Nat 1)
       (sym Nat (wpowK K (suc j)) (mul (wpowK K j) K) (wpowK_suc K j))
       (one_le_mul (wpowK K j) K ih hK))
    k
def one_le_wpow : (k : Nat) -> Le 1 (wpow k) := \k -> one_le_wpowK M64 k le_one_m64
def le_two_wpow_suc : (k : Nat) -> Le 2 (wpow (suc k)) :=
  \k -> le_trans 2 M64 (wpow (suc k)) le_two_m64
    (le_rewrite (mul 1 M64) M64 (wpow (suc k)) (mul (wpow k) M64)
       (prefl Nat M64)
       (sym Nat (wpow (suc k)) (mul (wpow k) M64) (wpow_suc k))
       (le_mul_r 1 (wpow k) M64 (one_le_wpow k)))

-- ---- the padded sum's bound (M16b, 2026-09-16) ----
-- The carry out of the padded fold is zero because the two operands, at their own lengths, are below wpow (wlen
-- x) and wpow (wlen y), whose sum is at most wpow (wlen x + wlen y) - the pair inequality, since both powers are
-- at least 2 - and the padded length is one above that sum. 2^A + 2^B <= 2^A * 2^B = 2^(A+B) needs u + v <= u * v
-- for u, v >= 2, which comes from v <= 2 * (v - 1) <= u * (v - 1), the case split being the shape Le 2 v exhibits.
-- the pair inequality's arithmetic: v >= 2 gives v <= 2 * (v - 1), hence u + v <= u * v for u, v >= 2
def v_le_two_v : (v : Nat) -> Le 2 v -> Le v (mul 2 (sub v 1)) :=
  \v h -> substId (\c -> Le c (mul 2 (sub c 1))) (pathToId (snd h))
    ( (fst h),
      compPath Nat (add (suc (suc (fst h))) (fst h)) (add (suc (fst h)) (suc (fst h))) (mul 2 (sub (suc (suc (fst h))) 1))
        (compPath Nat (add (suc (suc (fst h))) (fst h)) (suc (add (suc (fst h)) (fst h))) (add (suc (fst h)) (suc (fst h)))
           (prefl Nat (suc (add (suc (fst h)) (fst h))))
           (compPath Nat (suc (add (suc (fst h)) (fst h))) (suc (add (fst h) (suc (fst h)))) (add (suc (fst h)) (suc (fst h)))
              (cong Nat Nat suc (add (suc (fst h)) (fst h)) (add (fst h) (suc (fst h))) (add_comm (suc (fst h)) (fst h)))
              (prefl Nat (suc (add (fst h) (suc (fst h)))))))
        (sym Nat (mul 2 (sub (suc (suc (fst h))) 1)) (add (suc (fst h)) (suc (fst h))) (mul_two (suc (fst h)))))
def add_le_mul_of_two : (u v : Nat) -> Le 2 u -> Le 2 v -> Le (add u v) (mul u v) :=
  \u v hu hv ->
    let hv1 : Le 1 v := le_trans 1 2 v (1, prefl Nat 2) hv in
    le_rewrite (add u v) (add u v) (add u (mul u (sub v 1))) (mul u v)
      (prefl Nat (add u v))
      (compPath Nat (add u (mul u (sub v 1))) (mul u (suc (sub v 1))) (mul u v)
         (sym Nat (mul u (suc (sub v 1))) (add u (mul u (sub v 1))) (mul_suc_r u (sub v 1)))
         (cong Nat Nat (mul u) (suc (sub v 1)) v (suc_pred_self v hv1)))
      (le_add_le u u v (mul u (sub v 1)) (le_refl u)
         (le_trans v (mul 2 (sub v 1)) (mul u (sub v 1))
            (v_le_two_v v hv)
            (le_rewrite (mul 2 (sub v 1)) (mul 2 (sub v 1)) (mul u (sub v 1)) (mul u (sub v 1))
               (prefl Nat (mul 2 (sub v 1)))
               (prefl Nat (mul u (sub v 1)))
               (le_mul_r 2 u (sub v 1) hu))))
-- 2^A + 2^B <= 2^(A+B) for A, B >= 1: the two powers are at least two, so their sum is at most their product
def wpow_pair_le : (A B : Nat) -> Le 1 A -> Le 1 B -> Le (add (wpow A) (wpow B)) (wpow (add A B)) :=
  \A B hA hB ->
    le_rewrite (add (wpow A) (wpow B)) (add (wpow A) (wpow B)) (mul (wpow A) (wpow B)) (wpow (add A B))
      (prefl Nat (add (wpow A) (wpow B)))
      (sym Nat (wpow (add A B)) (mul (wpow A) (wpow B)) (wpow_add A B))
      (add_le_mul_of_two (wpow A) (wpow B)
         (le_rewrite 2 2 (wpow (suc (sub A 1))) (wpow A)
            (prefl Nat 2)
            (cong Nat Nat wpow (suc (sub A 1)) A (suc_pred_self A hA))
            (le_two_wpow_suc (sub A 1)))
         (le_rewrite 2 2 (wpow (suc (sub B 1))) (wpow B)
            (prefl Nat 2)
            (cong Nat Nat wpow (suc (sub B 1)) B (suc_pred_self B hB))
            (le_two_wpow_suc (sub B 1))))
-- the padded lengths meet: both are suc (wlen x + wlen y)
def wlen_badd_l : (x y : WB) -> Path Nat (wlen (wzap (suc (wlen y)) x)) (suc (add (wlen x) (wlen y))) :=
  \x y -> compPath Nat (wlen (wzap (suc (wlen y)) x)) (add (suc (wlen y)) (wlen x)) (suc (add (wlen x) (wlen y)))
    (wlen_zap (suc (wlen y)) x)
    (compPath Nat (add (suc (wlen y)) (wlen x)) (suc (add (wlen y) (wlen x))) (suc (add (wlen x) (wlen y)))
       (prefl Nat (suc (add (wlen y) (wlen x))))
       (cong Nat Nat suc (add (wlen y) (wlen x)) (add (wlen x) (wlen y)) (add_comm (wlen y) (wlen x))))
def wlen_badd_r : (x y : WB) -> Path Nat (wlen (wzap (suc (wlen x)) y)) (suc (add (wlen x) (wlen y))) :=
  \x y -> compPath Nat (wlen (wzap (suc (wlen x)) y)) (add (suc (wlen x)) (wlen y)) (suc (add (wlen x) (wlen y)))
    (wlen_zap (suc (wlen x)) y)
    (prefl Nat (suc (add (wlen x) (wlen y))))
-- one padded operand stays below the power of its own length (its value bound, transported along the zap)
def badd_lt_l : (x y : WB) -> Lt (wbval (wzap (suc (wlen y)) x)) (wpow (wlen x)) :=
  \x y -> substId (\v -> Lt v (wpow (wlen x)))
    (pathToId (sym Nat (wbval (wzap (suc (wlen y)) x)) (wbval x) (wbval_zap (suc (wlen y)) x)))
    (wbval_lt_wpow x)
def badd_lt_r : (x y : WB) -> Lt (wbval (wzap (suc (wlen x)) y)) (wpow (wlen y)) :=
  \x y -> substId (\v -> Lt v (wpow (wlen y)))
    (pathToId (sym Nat (wbval (wzap (suc (wlen x)) y)) (wbval y) (wbval_zap (suc (wlen x)) y)))
    (wbval_lt_wpow y)

-- wpow is monotone in the exponent, over a symbolic base (wpow_add)
def wpow_add_le : (a d : Nat) -> Le (wpow a) (wpow (add a d)) :=
  \a d ->
    let w : Nat := mul (wpow a) (sub (wpow d) 1) in
    ( w,
      compPath Nat (add (wpow a) w) (mul (wpow a) (wpow d)) (wpow (add a d))
        (compPath Nat (add (wpow a) w) (mul (wpow a) (suc (sub (wpow d) 1))) (mul (wpow a) (wpow d))
           (sym Nat (mul (wpow a) (suc (sub (wpow d) 1))) (add (wpow a) w) (mul_suc_r (wpow a) (sub (wpow d) 1)))
           (cong Nat Nat (\u -> mul (wpow a) u) (suc (sub (wpow d) 1)) (wpow d) (suc_pred_self (wpow d) (one_le_wpow d))))
        (sym Nat (wpow (add a d)) (mul (wpow a) (wpow d)) (wpow_add a d)) )
def wpow_le : (a b : Nat) -> Le a b -> Le (wpow a) (wpow b) :=
  \a b h -> substId (\c -> Le (wpow a) (wpow c)) (pathToId (snd h)) (wpow_add_le a (fst h))

def badd_sum_lt_nill : (y : WB) -> Lt (add (wbval (wzap (suc (wlen y)) (lnil {Word}))) (wbval (wzap (suc (wlen (lnil {Word}))) y))) (wpow (suc (add (wlen (lnil {Word})) (wlen y)))) :=
  \y -> lt_le_trans (add (wbval (wzap (suc (wlen y)) (lnil {Word}))) (wbval (wzap (suc (wlen (lnil {Word}))) y))) (wpow (wlen y)) (wpow (suc (add (wlen (lnil {Word})) (wlen y))))
    (substId (\s -> Lt s (wpow (wlen y)))
       (pathToId (sym Nat (wbval (wzap (suc (wlen (lnil {Word}))) y)) (add (wbval (wzap (suc (wlen y)) (lnil {Word}))) (wbval (wzap (suc (wlen (lnil {Word}))) y)))
          (compPath Nat (add (wbval (wzap (suc (wlen y)) (lnil {Word}))) (wbval (wzap (suc (wlen (lnil {Word}))) y))) (add 0 (wbval (wzap (suc (wlen (lnil {Word}))) y))) (wbval (wzap (suc (wlen (lnil {Word}))) y))
             (cong Nat Nat (\s -> add s (wbval (wzap (suc (wlen (lnil {Word}))) y))) (wbval (wzap (suc (wlen y)) (lnil {Word}))) 0 (compPath Nat (wbval (wzap (suc (wlen y)) (lnil {Word}))) (wbval (lnil {Word})) 0 (wbval_zap (suc (wlen y)) (lnil {Word})) (prefl Nat 0)))
             (add_zero_l (wbval (wzap (suc (wlen (lnil {Word}))) y))))))
       (badd_lt_r (lnil {Word}) y))
    (wpow_le (wlen y) (suc (add (wlen (lnil {Word})) (wlen y))) (1, add_one_r (wlen y)))
def badd_sum_lt_nilr : (u : WB) -> Lt (add (wbval (wzap (suc (wlen (lnil {Word}))) u)) (wbval (wzap (suc (wlen u)) (lnil {Word})))) (wpow (suc (add (wlen u) (wlen (lnil {Word}))))) :=
  \u -> lt_le_trans (add (wbval (wzap (suc (wlen (lnil {Word}))) u)) (wbval (wzap (suc (wlen u)) (lnil {Word})))) (wpow (wlen u)) (wpow (suc (add (wlen u) (wlen (lnil {Word})))))
    (substId (\s -> Lt s (wpow (wlen u)))
       (pathToId (sym Nat (wbval (wzap (suc (wlen (lnil {Word}))) u)) (add (wbval (wzap (suc (wlen (lnil {Word}))) u)) (wbval (wzap (suc (wlen u)) (lnil {Word}))))
          (compPath Nat (add (wbval (wzap (suc (wlen (lnil {Word}))) u)) (wbval (wzap (suc (wlen u)) (lnil {Word})))) (add (wbval (wzap (suc (wlen (lnil {Word}))) u)) 0) (wbval (wzap (suc (wlen (lnil {Word}))) u))
             (cong Nat Nat (\s -> add (wbval (wzap (suc (wlen (lnil {Word}))) u)) s) (wbval (wzap (suc (wlen u)) (lnil {Word}))) 0 (compPath Nat (wbval (wzap (suc (wlen u)) (lnil {Word}))) (wbval (lnil {Word})) 0 (wbval_zap (suc (wlen u)) (lnil {Word})) (prefl Nat 0)))
             (add_zero_r (wbval (wzap (suc (wlen (lnil {Word}))) u))))))
       (badd_lt_l u (lnil {Word})))
    (wpow_le (wlen u) (suc (add (wlen u) (wlen (lnil {Word})))) (1, (compPath Nat (add (wlen u) 1) (suc (wlen u)) (suc (add (wlen u) (wlen (lnil {Word})))) (add_one_r (wlen u)) (cong Nat Nat suc (wlen u) (add (wlen u) (wlen (lnil {Word}))) (sym Nat (add (wlen u) (wlen (lnil {Word}))) (wlen u) (add_zero_r (wlen u)))))))
def badd_sum_lt_lr : (l : Word) (r : WB) -> (y : WB) -> Lt (add (wbval (wzap (suc (wlen y)) (lcons l r))) (wbval (wzap (suc (wlen (lcons l r))) y))) (wpow (suc (add (wlen (lcons l r)) (wlen y)))) :=
  \l r -> elim List (\w -> Lt (add (wbval (wzap (suc (wlen w)) (lcons l r))) (wbval (wzap (suc (wlen (lcons l r))) w))) (wpow (suc (add (wlen (lcons l r)) (wlen w)))))
    (badd_sum_lt_nilr (lcons l r))
    (\k s ih -> lt_le_trans (add (wbval (wzap (suc (wlen (lcons k s))) (lcons l r))) (wbval (wzap (suc (wlen (lcons l r))) (lcons k s)))) (wpow (add (wlen (lcons l r)) (wlen (lcons k s)))) (wpow (suc (add (wlen (lcons l r)) (wlen (lcons k s)))))
       (lt_le_trans (add (wbval (wzap (suc (wlen (lcons k s))) (lcons l r))) (wbval (wzap (suc (wlen (lcons l r))) (lcons k s)))) (add (wpow (wlen (lcons l r))) (wpow (wlen (lcons k s)))) (wpow (add (wlen (lcons l r)) (wlen (lcons k s))))
          (lt_add_mono_l (wbval (wzap (suc (wlen (lcons l r))) (lcons k s))) (wpow (wlen (lcons k s))) (wbval (wzap (suc (wlen (lcons k s))) (lcons l r)))
             (lt_add_mono_r (wbval (wzap (suc (wlen (lcons k s))) (lcons l r))) (wpow (wlen (lcons l r))) (wbval (wzap (suc (wlen (lcons l r))) (lcons k s))) (badd_lt_l (lcons l r) (lcons k s))))
          (wpow_pair_le (wlen (lcons l r)) (wlen (lcons k s)) (wlen r, prefl Nat (suc (wlen r))) (wlen s, prefl Nat (suc (wlen s)))))
       (wpow_le (add (wlen (lcons l r)) (wlen (lcons k s))) (suc (add (wlen (lcons l r)) (wlen (lcons k s)))) (1, add_one_r (add (wlen (lcons l r)) (wlen (lcons k s))))))
def badd_sum_lt : (x y : WB) -> Lt (add (wbval (wzap (suc (wlen y)) x)) (wbval (wzap (suc (wlen x)) y))) (wpow (suc (add (wlen x) (wlen y)))) :=
  \x y -> elim List (\u -> Lt (add (wbval (wzap (suc (wlen y)) u)) (wbval (wzap (suc (wlen u)) y))) (wpow (suc (add (wlen u) (wlen y)))))
    (badd_sum_lt_nill y)
    (\l r ih -> badd_sum_lt_lr l r y)
    x

-- the value law of the padded add: the sum bounds the carry out at zero, so the fold is the plain sum
def le_add_inner : (a b c : Nat) -> Le a (add b (add a c)) :=
  \a b c -> (add b c, compPath Nat (add a (add b c)) (add (add a b) c) (add b (add a c))
     (sym Nat (add (add a b) c) (add a (add b c)) (add_assoc a b c))
     (compPath Nat (add (add a b) c) (add (add b a) c) (add b (add a c))
        (cong Nat Nat (\s -> add s c) (add a b) (add b a) (add_comm a b))
        (add_assoc b a c)))
def badd_val : (x y : WB) -> Path Nat (wbval (badd x y)) (add (wbval x) (wbval y)) :=
  \x y ->
  let x' : WB := wzap (suc (wlen y)) x in
  let y' : WB := wzap (suc (wlen x)) y in
  let N : Nat := suc (add (wlen x) (wlen y)) in
  let hs : Path Nat (wlen x') (wlen y') :=
     compPath Nat (wlen x') N (wlen y') (wlen_badd_l x y) (sym Nat (wlen y') N (wlen_badd_r x y)) in
  let inv : WInv x' y' := waddGo_val x' y' hs in
  let z : WB := snd (waddGo x' y') in
  let c : Word := fst (waddGo x' y') in
  let e1 : Path Nat (add (wbval z) (mul (wlimb c) (wpow (wlen z)))) (add (wbval x') (wbval y')) := fst inv in
  let hz : Path Nat (wlen z) (wlen x') := snd (snd inv) in
  let hK : Path Nat (wpow (wlen z)) (wpow N) :=
     cong Nat Nat wpow (wlen z) N (compPath Nat (wlen z) (wlen x') N hz (wlen_badd_l x y)) in
  let bd : Lt (add (wbval x') (wbval y')) (wpow (wlen z)) :=
     substId (\v -> Lt (add (wbval x') (wbval y')) v) (pathToId (sym Nat (wpow (wlen z)) (wpow N) hK)) (badd_sum_lt x y) in
  let goal : Path Nat (wbval z) (add (wbval x') (wbval y')) :=
    elim Nat (\m -> Path Nat (wlimb c) m -> Path Nat (wbval z) (add (wbval x') (wbval y')))
      (\h0 -> compPath Nat (wbval z) (add (wbval z) 0) (add (wbval x') (wbval y'))
         (sym Nat (add (wbval z) 0) (wbval z) (add_zero_r (wbval z)))
         (substId (\v -> Path Nat (add (wbval z) (mul v (wpow (wlen z)))) (add (wbval x') (wbval y'))) (pathToId h0) e1))
      (\k ih -> \hk ->
         let e2 : Path Nat (add (wbval z) (mul (suc k) (wpow (wlen z)))) (add (wbval x') (wbval y')) :=
            substId (\v -> Path Nat (add (wbval z) (mul v (wpow (wlen z)))) (add (wbval x') (wbval y'))) (pathToId hk) e1 in
         let hle : Le (wpow (wlen z)) (add (wbval x') (wbval y')) :=
            le_rewrite (wpow (wlen z)) (wpow (wlen z)) (add (wbval z) (add (wpow (wlen z)) (mul k (wpow (wlen z))))) (add (wbval x') (wbval y')) (prefl Nat (wpow (wlen z))) e2 (le_add_inner (wpow (wlen z)) (wbval z) (mul k (wpow (wlen z)))) in
         elim Empty (\_ -> Path Nat (wbval z) (add (wbval x') (wbval y')))
            (lt_self_absurd (wpow (wlen z)) (le_trans (suc (wpow (wlen z))) (add (wbval x') (wbval y')) (wpow (wlen z)) (lt_le (wpow (wlen z)) (add (wbval x') (wbval y')) bd) hle)))
      (wlimb c) (prefl Nat (wlimb c)) in
  compPath Nat (wbval (badd x y)) (add (wbval x') (wbval y')) (add (wbval x) (wbval y))
    goal
    (compPath Nat (add (wbval x') (wbval y')) (add (wbval x) (wbval y')) (add (wbval x) (wbval y))
       (cong Nat Nat (\s -> add s (wbval y')) (wbval x') (wbval x) (wbval_zap (suc (wlen y)) x))
       (cong Nat Nat (\s -> add (wbval x) s) (wbval y') (wbval y) (wbval_zap (suc (wlen x)) y)))

-- n - (n + m) = 0: the truncated subtraction of a sum of itself, by induction on the added part
def sub_add_self_zero : (n m : Nat) -> Path Nat (sub n (add n m)) 0 :=
  \n m -> elim Nat (\k -> Path Nat (sub n (add n k)) 0)
    (compPath Nat (sub n (add n 0)) (sub n n) 0
       (cong Nat Nat (\w -> sub n w) (add n 0) n (add_zero_r n))
       (sub_self n))
    (\k ih -> compPath Nat (sub n (add n (suc k))) (pred (sub n (add n k))) 0
       (compPath Nat (sub n (add n (suc k))) (sub n (suc (add n k))) (pred (sub n (add n k)))
          (cong Nat Nat (\w -> sub n w) (add n (suc k)) (suc (add n k)) (add_suc_r n k))
          (prefl Nat (pred (sub n (add n k)))))
       (cong Nat Nat pred (sub n (add n k)) 0 ih))
    m

-- the value law of the padded subtract: the borrow out of the top column is zero or one, and it says which
def sub_eq_zero : (a b : Nat) -> Le a b -> Path Nat (sub a b) 0 :=
  \a b h -> compPath Nat (sub a b) (sub a (add a (fst h))) 0
    (cong Nat Nat (\w -> sub a w) b (add a (fst h)) (sym Nat (add a (fst h)) b (snd h)))
    (sub_add_self_zero a (fst h))
def le_of_add_eq : (z y x u : Nat) -> Le (suc z) u -> Path Nat (add z y) (add x u) -> Le x y :=
  \z y x u hlt heq ->
    let hz : Le z u := le_of_le_suc z u hlt in
    let D : Nat := sub u z in
    let h1 : Path Nat (add x u) (add x (add D z)) :=
       cong Nat Nat (\w -> add x w) u (add D z) (sym Nat (add D z) u (sub_add_le u z hz)) in
    let h2 : Path Nat (add z y) (add x (add D z)) :=
       compPath Nat (add z y) (add x u) (add x (add D z)) heq h1 in
    let h3 : Path Nat (add x (add D z)) (add z (add x D)) :=
       compPath Nat (add x (add D z)) (add (add x D) z) (add z (add x D))
          (sym Nat (add (add x D) z) (add x (add D z)) (add_assoc x D z))
          (add_comm (add x D) z) in
    let h4 : Path Nat (add z y) (add z (add x D)) :=
       compPath Nat (add z y) (add x (add D z)) (add z (add x D)) h2 h3 in
    let hle : Le (add z y) (add z (add x D)) :=
       (0, compPath Nat (add (add z y) 0) (add z y) (add z (add x D)) (add_zero_r (add z y)) h4) in
    let hle2 : Le (add z (add x D)) (add z y) :=
       (0, compPath Nat (add (add z (add x D)) 0) (add z (add x D)) (add z y) (add_zero_r (add z (add x D))) (sym Nat (add z y) (add z (add x D)) h4)) in
    le_rewrite x x (add x D) y (prefl Nat x)
      (le_antisym (add x D) y (le_cancel_l z (add x D) y hle2) (le_cancel_l z y (add x D) hle))
      (D, prefl Nat (add x D))
def bsub_val : (x y : WB) -> Path Nat (wbval (bsub x y)) (sub (wbval x) (wbval y)) :=
  \x y ->
  let x' : WB := wzap (suc (wlen y)) x in
  let y' : WB := wzap (suc (wlen x)) y in
  let N : Nat := suc (add (wlen x) (wlen y)) in
  let r : Sigma Word (\_ -> WB) := wsubGo x' y' in
  let z : WB := snd r in
  let bo : Word := fst r in
  let X : Nat := wpow (wlen z) in
  let hs : Path Nat (wlen x') (wlen y') :=
     compPath Nat (wlen x') N (wlen y') (wlen_badd_l x y) (sym Nat (wlen y') N (wlen_badd_r x y)) in
  let inv : WSubInv x' y' := wsubGo_val x' y' hs in
  let e1 : Path Nat (add (wbval z) (wbval y')) (add (wbval x') (mul (wlimb bo) (wpow (wlen z)))) := fst inv in
  let hz : Path Nat (wlen z) (wlen x') := snd (snd inv) in
  let hK : Path Nat (wpow (wlen z)) (wpow N) :=
     cong Nat Nat wpow (wlen z) N (compPath Nat (wlen z) (wlen x') N hz (wlen_badd_l x y)) in
  let sumlt : Lt (add (wbval x') (wbval y')) (wpow (wlen z)) :=
     substId (\v -> Lt (add (wbval x') (wbval y')) v) (pathToId (sym Nat (wpow (wlen z)) (wpow N) hK)) (badd_sum_lt x y) in
  let goal : Path Nat (wbval (elim Nat (\_ -> WB) (snd r) (\_ _ -> lnil {Word}) (wlimb bo))) (sub (wbval x') (wbval y')) :=
    elim Nat (\m -> Path Nat (wlimb bo) m -> Path Nat (wbval (elim Nat (\_ -> WB) (snd r) (\_ _ -> lnil {Word}) m)) (sub (wbval x') (wbval y')))
      (\h0 -> let heq0 : Path Nat (add (wbval z) (wbval y')) (wbval x') :=
       compPath Nat (add (wbval z) (wbval y')) (add (wbval x') 0) (wbval x')
          (substId (\v -> Path Nat (add (wbval z) (wbval y')) (add (wbval x') (mul v (wpow (wlen z))))) (pathToId h0) e1)
          (add_zero_r (wbval x')) in
         sym Nat (sub (wbval x') (wbval y')) (wbval z)
         (substId (\v -> Path Nat (sub v (wbval y')) (wbval z)) (pathToId heq0)
            (compPath Nat (sub (add (wbval z) (wbval y')) (wbval y')) (sub (add (wbval y') (wbval z)) (wbval y')) (wbval z)
               (cong Nat Nat (\v -> sub v (wbval y')) (add (wbval z) (wbval y')) (add (wbval y') (wbval z)) (add_comm (wbval z) (wbval y')))
               (sub_add_d (wbval y') (wbval z)))))
      (\k ih -> \hk ->
         let hk1 : Path Nat (add (wbval z) (wbval y')) (add (wbval x') (add (wpow (wlen z)) (mul k (wpow (wlen z))))) :=
            substId (\v -> Path Nat (add (wbval z) (wbval y')) (add (wbval x') (mul v (wpow (wlen z))))) (pathToId hk) e1 in
         let hlt : Le (suc (wbval z)) (add (wpow (wlen z)) (mul k (wpow (wlen z)))) :=
            le_trans (suc (wbval z)) (wpow (wlen z)) (add (wpow (wlen z)) (mul k (wpow (wlen z))))
               (lt_le (wbval z) (wpow (wlen z)) (wbval_lt_wpow z))
               ((mul k (wpow (wlen z))), prefl Nat (add (wpow (wlen z)) (mul k (wpow (wlen z))))) in
         let hle : Le (wbval x') (wbval y') := le_of_add_eq (wbval z) (wbval y') (wbval x') (add (wpow (wlen z)) (mul k (wpow (wlen z)))) hlt hk1 in
         sym Nat (sub (wbval x') (wbval y')) 0 (sub_eq_zero (wbval x') (wbval y') hle))
      (wlimb bo) (prefl Nat (wlimb bo)) in
  compPath Nat (wbval (bsub x y)) (sub (wbval x') (wbval y')) (sub (wbval x) (wbval y))
    goal
    (compPath Nat (sub (wbval x') (wbval y')) (sub (wbval x) (wbval y')) (sub (wbval x) (wbval y))
       (cong Nat Nat (\s -> sub s (wbval y')) (wbval x') (wbval x) (wbval_zap (suc (wlen y)) x))
       (cong Nat Nat (\s -> sub (wbval x) s) (wbval y') (wbval y) (wbval_zap (suc (wlen x)) y)))

-- ---- the limb-arithmetic the schoolbook multiply needs (M16b, 2026-09-16) ----
-- A limb times a limb is two limbs, so the multiply's columns live at the M64^2 scale: div and mod unwrap
-- there, and div never exceeds M64 when the value does not exceed M64^2.
def le_div_mul : (a : Nat) -> Le a (mul a M64) :=
  \a -> le_rewrite a a (add a (mul a (sub M64 1))) (mul a M64)
     (prefl Nat a)
     (compPath Nat (add a (mul a (sub M64 1))) (mul a (suc (sub M64 1))) (mul a M64)
        (sym Nat (mul a (suc (sub M64 1))) (add a (mul a (sub M64 1))) (mul_suc_r a (sub M64 1)))
        (cong Nat Nat (mul a) (suc (sub M64 1)) M64 (suc_pred_self M64 le_one_m64)))
     (mul a (sub M64 1), prefl Nat (add a (mul a (sub M64 1))))
def le_mul_div : (X : Nat) -> Le (mul (div X M64) M64) X :=
  \X -> (mod X M64, divmod_spec X M63)
def div_le_self : (X : Nat) -> Le (div X M64) X :=
  \X -> le_trans (div X M64) (mul (div X M64) M64) X (le_div_mul (div X M64)) (le_mul_div X)
def div_lt_of_lt : (X : Nat) -> Lt X (mul M64 M64) -> Lt (div X M64) M64 :=
  \X H -> ble_cases (suc (div X M64)) M64 (Lt (div X M64) M64)
    (\h1 -> le_lt (div X M64) M64 (ble_le (suc (div X M64)) M64 h1))
    (\h0 -> elim Empty (\_ -> Lt (div X M64) M64)
       (lt_self_absurd (mul M64 M64)
          (lt_le_trans (mul M64 M64) (mul (div X M64) M64) (mul M64 M64)
             (le_mul_r M64 (div X M64) M64 (le_suc_suc M64 (div X M64) (ble_not (suc (div X M64)) M64 h0)))
             (le_trans (mul (div X M64) M64) X (mul M64 M64) (le_mul_div X) (lt_le X (mul M64 M64) H)))))
def mod_lt_id : (X : Nat) -> Lt X M64 -> Path Nat (mod X M64) X :=
  \X H -> ble_cases 1 (div X M64) (Path Nat (mod X M64) X)
    (\h1 -> elim Empty (\_ -> Path Nat (mod X M64) X)
       (lt_self_absurd M64
          (lt_le_trans M64 (mul (div X M64) M64) M64
             (le_rewrite (mul 1 M64) M64 (mul (div X M64) M64) (mul (div X M64) M64)
                (prefl Nat M64) (prefl Nat (mul (div X M64) M64))
                (le_mul_r 1 (div X M64) M64 (ble_le 1 (div X M64) h1)))
             (le_trans (mul (div X M64) M64) X M64 (le_mul_div X) (lt_le X M64 H)))))
    (\h0 ->
      let d : Nat := div X M64 in
      let hd : Path Nat d 0 := injSuc (le_antisym (suc d) 1 (ble_not 1 d h0) (d, prefl Nat (suc d))) in
      substId (\v -> Path Nat (add (mul v M64) (mod X M64)) X) (pathToId hd) (divmod_spec X M63))
def lt_mul_suc_l : (a c : Nat) -> Le 1 c -> Lt (mul a c) (mul (suc a) c) :=
  \a c hc ->
    let X : Nat := mul a c in
    le_lt X (mul (suc a) c)
      (le_rewrite (suc X) (add 1 X) (mul (suc a) c) (add c X)
         (prefl Nat (suc X))
         (prefl Nat (add c X))
         (le_add_le 1 c X X hc (le_refl X)))

-- ---- the schoolbook multiply (M16b, 2026-09-16) ----
-- x * y folds over y's limbs, each contribution placed at its limb's weight: a row x * h is the same fold with
-- the limb products as rows, and each product is a limb times a limb (two limbs, below M64^2). The bounds the
-- products need come from the words themselves through wlimb_le, which hands the Word's irrelevant witness to
-- lt_le's irrelevant binder - the one position an irrelevant component may occupy.
def wapp0 (x : WB) : WB := elim List (\_ -> WB) (lcons 0 (lnil {Word})) (\l r ih -> lcons l ih) x
def wlen_app0 : (x : WB) -> Path Nat (wlen (wapp0 x)) (suc (wlen x)) :=
  \x -> elim List (\x -> Path Nat (wlen (wapp0 x)) (suc (wlen x))) (prefl Nat 1)
    (\l r ih -> compPath Nat (wlen (wapp0 (lcons l r))) (suc (wlen (wapp0 r))) (suc (suc (wlen r)))
       (prefl Nat (suc (wlen (wapp0 r))))
       (cong Nat Nat suc (wlen (wapp0 r)) (suc (wlen r)) ih))
    x
def wbval_app0 : (x : WB) -> Path Nat (wbval (wapp0 x)) (mul (wbval x) M64) :=
  \x -> elim List (\x -> Path Nat (wbval (wapp0 x)) (mul (wbval x) M64)) (prefl Nat 0)
    (\l r ih ->
      let m1 : Nat := add (mul (wlimb l) (wpow (wlen (wapp0 r)))) (wbval (wapp0 r)) in
      let m2 : Nat := add (mul (wlimb l) (wpow (suc (wlen r)))) (wbval (wapp0 r)) in
      let m3 : Nat := add (mul (wlimb l) (wpow (suc (wlen r)))) (mul (wbval r) M64) in
      let m4 : Nat := add (mul (wlimb l) (mul (wpow (wlen r)) M64)) (mul (wbval r) M64) in
      let m5 : Nat := add (mul (mul (wlimb l) (wpow (wlen r))) M64) (mul (wbval r) M64) in
      let m6 : Nat := mul (add (mul (wlimb l) (wpow (wlen r))) (wbval r)) M64 in
      let s1 : Path Nat (wbval (wapp0 (lcons l r))) m1 := wbval_cons l (wapp0 r) in
      let s2 : Path Nat m1 m2 := cong Nat Nat (\w -> add (mul (wlimb l) (wpow w)) (wbval (wapp0 r))) (wlen (wapp0 r)) (suc (wlen r)) (wlen_app0 r) in
      let s3 : Path Nat m2 m3 := cong Nat Nat (\w -> add (mul (wlimb l) (wpow (suc (wlen r)))) w) (wbval (wapp0 r)) (mul (wbval r) M64) ih in
      let s4 : Path Nat m3 m4 := cong Nat Nat (\w -> add (mul (wlimb l) w) (mul (wbval r) M64)) (wpow (suc (wlen r))) (mul (wpow (wlen r)) M64) (wpow_suc (wlen r)) in
      let s5 : Path Nat m4 m5 := cong Nat Nat (\w -> add w (mul (wbval r) M64)) (mul (wlimb l) (mul (wpow (wlen r)) M64)) (mul (mul (wlimb l) (wpow (wlen r))) M64) (sym Nat (mul (mul (wlimb l) (wpow (wlen r))) M64) (mul (wlimb l) (mul (wpow (wlen r)) M64)) (mul_assoc (wlimb l) (wpow (wlen r)) M64)) in
      let s6 : Path Nat m5 m6 := sym Nat m6 m5 (mul_dist_r (mul (wlimb l) (wpow (wlen r))) (wbval r) M64) in
      let s7 : Path Nat m6 (mul (wbval (lcons l r)) M64) := cong Nat Nat (\w -> mul w M64) (add (mul (wlimb l) (wpow (wlen r))) (wbval r)) (wbval (lcons l r)) (sym Nat (wbval (lcons l r)) (add (mul (wlimb l) (wpow (wlen r))) (wbval r)) (wbval_cons l r)) in
      compPath Nat (wbval (wapp0 (lcons l r))) m1 (mul (wbval (lcons l r)) M64) s1
        (compPath Nat m1 m2 (mul (wbval (lcons l r)) M64) s2
          (compPath Nat m2 m3 (mul (wbval (lcons l r)) M64) s3
            (compPath Nat m3 m4 (mul (wbval (lcons l r)) M64) s4
              (compPath Nat m4 m5 (mul (wbval (lcons l r)) M64) s5
                (compPath Nat m5 m6 (mul (wbval (lcons l r)) M64) s6 s7))))))
    x
def wappk (k : Nat) (x : WB) : WB := elim Nat (\_ -> WB -> WB) (\x -> x) (\_ ih -> \x -> wapp0 (ih x)) k x
def wlen_appk : (k : Nat) (x : WB) -> Path Nat (wlen (wappk k x)) (add (wlen x) k) :=
  \k -> elim Nat (\k -> (x : WB) -> Path Nat (wlen (wappk k x)) (add (wlen x) k))
    (\x -> sym Nat (add (wlen x) 0) (wlen x) (add_zero_r (wlen x)))
    (\k ih -> \x -> compPath Nat (wlen (wappk (suc k) x)) (suc (wlen (wappk k x))) (add (wlen x) (suc k))
       (wlen_app0 (wappk k x))
       (compPath Nat (suc (wlen (wappk k x))) (suc (add (wlen x) k)) (add (wlen x) (suc k))
          (cong Nat Nat suc (wlen (wappk k x)) (add (wlen x) k) (ih x))
          (sym Nat (add (wlen x) (suc k)) (suc (add (wlen x) k)) (add_suc_r (wlen x) k))))
    k
def wbval_appk : (k : Nat) (x : WB) -> Path Nat (wbval (wappk k x)) (mul (wbval x) (wpow k)) :=
  \k -> elim Nat (\k -> (x : WB) -> Path Nat (wbval (wappk k x)) (mul (wbval x) (wpow k)))
    (\x -> compPath Nat (wbval (wappk 0 x)) (wbval x) (mul (wbval x) (wpow 0))
       (prefl Nat (wbval x))
       (sym Nat (mul (wbval x) (wpow 0)) (wbval x) (mul_one_r (wbval x))))
    (\k ih -> \x -> compPath Nat (wbval (wappk (suc k) x)) (mul (wbval (wappk k x)) M64) (mul (wbval x) (wpow (suc k)))
       (wbval_app0 (wappk k x))
       (compPath Nat (mul (wbval (wappk k x)) M64) (mul (mul (wbval x) (wpow k)) M64) (mul (wbval x) (wpow (suc k)))
          (cong Nat Nat (\w -> mul w M64) (wbval (wappk k x)) (mul (wbval x) (wpow k)) (ih x))
          (compPath Nat (mul (mul (wbval x) (wpow k)) M64) (mul (wbval x) (mul (wpow k) M64)) (mul (wbval x) (wpow (suc k)))
             (mul_assoc (wbval x) (wpow k) M64)
             (cong Nat Nat (mul (wbval x)) (mul (wpow k) M64) (wpow (suc k)) (sym Nat (wpow (suc k)) (mul (wpow k) M64) (wpow_suc k))))))
    k
def mul_lt_M64M64 : (b c : Nat) -> Le (suc b) M64 -> Le (suc c) M64 -> Lt (mul b c) (mul M64 M64) :=
  \b c hb hc -> elim Nat (\c -> Le (suc c) M64 -> Lt (mul b c) (mul M64 M64))
    (\_ -> substId (\v -> Lt v (mul M64 M64)) (pathToId (sym Nat (mul b 0) 0 (mul_zero_r b)))
       (le_lt 0 (mul M64 M64) (one_le_mul M64 M64 le_one_m64 le_one_m64)))
    (\k ih -> \hk ->
       lt_le_trans (mul b (suc k)) (mul (suc b) (suc k)) (mul M64 M64)
          (lt_mul_suc_l b (suc k) (k, prefl Nat (suc k)))
          (le_trans (mul (suc b) (suc k)) (mul M64 (suc k)) (mul M64 M64)
             (le_mul_r (suc b) M64 (suc k) hb)
             (le_rewrite (mul (suc k) M64) (mul M64 (suc k)) (mul M64 M64) (mul M64 M64)
                (mul_comm (suc k) M64) (prefl Nat (mul M64 M64))
                (le_mul_r (suc k) M64 M64 (le_of_le_suc (suc k) M64 hk)))))
    c hc
def wlimb_le : (w : Word) -> Le (suc (wlimb w)) M64 := \w -> lt_le (wlimb w) M64 (snd w)
def wsmul1 (a h : Word) : WB := lcons (snd (wmull a h)) (lcons (fst (wmull a h)) (lnil {Word}))
def wsmul1_val : (a h : Word) -> Path Nat (wbval (wsmul1 a h)) (mul (wlimb a) (wlimb h)) :=
  \a h ->
    let Z : Nat := mul (fst a) (fst h) in
    let hi : Nat := div Z M64 in
    let lo : Nat := mod Z M64 in
    let hiW : Word := snd (wmull a h) in
    let loW : Word := fst (wmull a h) in
    let pw : Nat := wpow (wlen (lcons loW (lnil {Word}))) in
    let hhi : Path Nat (wlimb hiW) hi := mod_lt_id (div Z M64) (div_lt_of_lt Z (mul_lt_M64M64 (fst a) (fst h) (wlimb_le a) (wlimb_le h))) in
    let e0 : Nat := wbval (lcons loW (lnil {Word})) in
    let e1 : Nat := add (mul (wlimb loW) (wpow (wlen (lnil {Word})))) (wbval (lnil {Word})) in
    let e2 : Nat := add (mul (wlimb loW) 1) 0 in
    let e3 : Nat := add (wlimb loW) 0 in
    let e4 : Nat := wlimb loW in
    let r0 : Path Nat e0 e1 := wbval_cons loW (lnil {Word}) in
    let r1 : Path Nat e1 e2 := prefl Nat e2 in
    let r2 : Path Nat e2 e3 := cong Nat Nat (\v -> add v 0) (mul (wlimb loW) 1) (wlimb loW) (mul_one_r (wlimb loW)) in
    let r3 : Path Nat e3 e4 := add_zero_r (wlimb loW) in
    let r4 : Path Nat e4 lo := prefl Nat lo in
    let hinner : Path Nat e0 lo :=
       compPath Nat e0 e1 lo r0 (compPath Nat e1 e2 lo r1 (compPath Nat e2 e3 lo r2 (compPath Nat e3 e4 lo r3 r4))) in
    let s0 : Nat := wbval (lcons hiW (lcons loW (lnil {Word}))) in
    let s1 : Nat := add (mul (wlimb hiW) pw) (wbval (lcons loW (lnil {Word}))) in
    let s2 : Nat := add (mul hi pw) (wbval (lcons loW (lnil {Word}))) in
    let s3 : Nat := add (mul hi M64) (wbval (lcons loW (lnil {Word}))) in
    let s4 : Nat := add (mul hi M64) lo in
    let s5 : Nat := add (mul (div Z M64) M64) (mod Z M64) in
    let p0 : Path Nat s0 s1 := wbval_cons hiW (lcons loW (lnil {Word})) in
    let p1 : Path Nat s1 s2 := cong Nat Nat (\v -> add (mul v pw) (wbval (lcons loW (lnil {Word})))) (wlimb hiW) hi hhi in
    let p2 : Path Nat s2 s3 := cong Nat Nat (\v -> add (mul hi v) (wbval (lcons loW (lnil {Word})))) pw M64 (prefl Nat M64) in
    let p3 : Path Nat s3 s4 := cong Nat Nat (\v -> add (mul hi M64) v) (wbval (lcons loW (lnil {Word}))) lo hinner in
    let p4 : Path Nat s4 s5 := prefl Nat (add (mul (div Z M64) M64) (mod Z M64)) in
    let p5 : Path Nat s5 Z := divmod_spec Z M63 in
    compPath Nat s0 s1 Z p0
      (compPath Nat s1 s2 Z p1
        (compPath Nat s2 s3 Z p2
          (compPath Nat s3 s4 Z p3
            (compPath Nat s4 s5 Z p4 p5))))
def wrow (x : WB) (h : Word) : WB :=
  elim List (\_ -> WB) (lnil {Word}) (\a as ih -> badd (wappk (wlen as) (wsmul1 a h)) ih) x
def wrow_step : (a : Word) (as : WB) (h : Word) -> Path Nat (wbval (wrow as h)) (mul (wbval as) (wlimb h))
    -> Path Nat (wbval (wrow (lcons a as) h)) (mul (wbval (lcons a as)) (wlimb h)) :=
  \a as h ih ->
    let A : Nat := wbval (wappk (wlen as) (wsmul1 a h)) in
    let B : Nat := wbval (wrow as h) in
    let C : Nat := mul (wbval (wsmul1 a h)) (wpow (wlen as)) in
    let D : Nat := mul (wbval as) (wlimb h) in
    let E : Nat := mul (wbval (lcons a as)) (wlimb h) in
    let F : Nat := mul (wlimb a) (wpow (wlen as)) in
    let q1 : Path Nat (wbval (wrow (lcons a as) h)) (add A B) := badd_val (wappk (wlen as) (wsmul1 a h)) (wrow as h) in
    let q2 : Path Nat (add A B) (add C D) :=
       compPath Nat (add A B) (add C B) (add C D)
          (cong Nat Nat (\v -> add v B) A C (wbval_appk (wlen as) (wsmul1 a h)))
          (cong Nat Nat (\v -> add C v) B D ih) in
    let qc : Path Nat C (mul F (wlimb h)) :=
       compPath Nat C (mul (mul (wlimb a) (wlimb h)) (wpow (wlen as))) (mul F (wlimb h))
          (cong Nat Nat (\v -> mul v (wpow (wlen as))) (wbval (wsmul1 a h)) (mul (wlimb a) (wlimb h)) (wsmul1_val a h))
          (compPath Nat (mul (mul (wlimb a) (wlimb h)) (wpow (wlen as))) (mul (wlimb a) (mul (wlimb h) (wpow (wlen as)))) (mul F (wlimb h))
             (mul_assoc (wlimb a) (wlimb h) (wpow (wlen as)))
             (compPath Nat (mul (wlimb a) (mul (wlimb h) (wpow (wlen as)))) (mul (wlimb a) (mul (wpow (wlen as)) (wlimb h))) (mul F (wlimb h))
                (cong Nat Nat (mul (wlimb a)) (mul (wlimb h) (wpow (wlen as))) (mul (wpow (wlen as)) (wlimb h)) (mul_comm (wlimb h) (wpow (wlen as))))
                (sym Nat (mul F (wlimb h)) (mul (wlimb a) (mul (wpow (wlen as)) (wlimb h))) (mul_assoc (wlimb a) (wpow (wlen as)) (wlimb h))))) in
    let q3 : Path Nat (add C D) (add (mul F (wlimb h)) D) := cong Nat Nat (\v -> add v D) C (mul F (wlimb h)) qc in
    let q4 : Path Nat (add (mul F (wlimb h)) D) E :=
       compPath Nat (add (mul F (wlimb h)) D) (mul (add F (wbval as)) (wlimb h)) E
          (sym Nat (mul (add F (wbval as)) (wlimb h)) (add (mul F (wlimb h)) D) (mul_dist_r F (wbval as) (wlimb h)))
          (cong Nat Nat (\v -> mul v (wlimb h)) (add F (wbval as)) (wbval (lcons a as)) (sym Nat (wbval (lcons a as)) (add F (wbval as)) (wbval_cons a as))) in
    let q5 : Path Nat (add C D) E := compPath Nat (add C D) (add (mul F (wlimb h)) D) E q3 q4 in
    let q6 : Path Nat (add A B) E := compPath Nat (add A B) (add C D) E q2 q5 in
    compPath Nat (wbval (wrow (lcons a as) h)) (add A B) E q1 q6
def wrow_val : (x : WB) (h : Word) -> Path Nat (wbval (wrow x h)) (mul (wbval x) (wlimb h)) :=
  \x h -> elim List (\x -> Path Nat (wbval (wrow x h)) (mul (wbval x) (wlimb h)))
    (prefl Nat 0)
    (\a as ih -> wrow_step a as h ih)
    x
def bmul (x y : WB) : WB :=
  elim List (\_ -> WB) (lnil {Word}) (\h t ih -> badd (wappk (wlen t) (wrow x h)) ih) y
def bmul_step : (x : WB) (h : Word) (t : WB) -> Path Nat (wbval (bmul x t)) (mul (wbval x) (wbval t))
    -> Path Nat (wbval (bmul x (lcons h t))) (mul (wbval x) (wbval (lcons h t))) :=
  \x h t ih ->
    let X : Nat := wbval x in
    let H : Nat := wlimb h in
    let P : Nat := wpow (wlen t) in
    let Vt : Nat := wbval t in
    let A : Nat := wbval (wappk (wlen t) (wrow x h)) in
    let B : Nat := wbval (bmul x t) in
    let C : Nat := mul (wbval (wrow x h)) P in
    let D : Nat := mul X Vt in
    let E : Nat := mul X (wbval (lcons h t)) in
    let F : Nat := mul X H in
    let T : Nat := mul H P in
    let q1 : Path Nat (wbval (bmul x (lcons h t))) (add A B) := badd_val (wappk (wlen t) (wrow x h)) (bmul x t) in
    let q2 : Path Nat (add A B) (add C D) :=
       compPath Nat (add A B) (add C B) (add C D)
          (cong Nat Nat (\v -> add v B) A C (wbval_appk (wlen t) (wrow x h)))
          (cong Nat Nat (\v -> add C v) B D ih) in
    let q3 : Path Nat (add C D) (add (mul F P) D) :=
       cong Nat Nat (\v -> add (mul v P) D) (wbval (wrow x h)) F
          (compPath Nat (wbval (wrow x h)) (mul X H) F
             (wrow_val x h)
             (prefl Nat (mul X H))) in
    let q4 : Path Nat (add (mul F P) D) E :=
       compPath Nat (add (mul F P) D) (add (mul X T) D) E
          (cong Nat Nat (\v -> add v D) (mul F P) (mul X T) (mul_assoc X H P))
          (compPath Nat (add (mul X T) D) (mul X (add T Vt)) E
             (sym Nat (mul X (add T Vt)) (add (mul X T) D) (mul_dist_l X T Vt))
             (compPath Nat (mul X (add T Vt)) (mul X (wbval (lcons h t))) E
                (cong Nat Nat (mul X) (add T Vt) (wbval (lcons h t)) (sym Nat (wbval (lcons h t)) (add T Vt) (wbval_cons h t)))
                (prefl Nat E))) in
    let q5 : Path Nat (add C D) E := compPath Nat (add C D) (add (mul F P) D) E q3 q4 in
    let q6 : Path Nat (add A B) E := compPath Nat (add A B) (add C D) E q2 q5 in
    compPath Nat (wbval (bmul x (lcons h t))) (add A B) E q1 q6
def bmul_val : (x y : WB) -> Path Nat (wbval (bmul x y)) (mul (wbval x) (wbval y)) :=
  \x y -> elim List (\y -> Path Nat (wbval (bmul x y)) (mul (wbval x) (wbval y)))
    (sym Nat (mul (wbval x) 0) 0 (mul_zero_r (wbval x)))
    (\h t ih -> bmul_step x h t ih)
    y
