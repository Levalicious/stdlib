                 (cong Nat Nat (\v -> mul (pow A (mul M64 K)) v) (mul (pow X (mul L K)) (pow X R)) (pow X (add (mul L K) R)) (sym Nat (pow X (add (mul L K) R)) (mul (pow X (mul L K)) (pow X R)) (pow_add X (mul L K) R)))
                 (compPath Nat (mul (pow A (mul M64 K)) (pow X (add (mul L K) R))) (mul (pow A (wpow (suc (wlen r)))) (pow X (add (mul L K) R))) (mul (pow A (wpow (suc (wlen r)))) (pow X (wbval (lcons l r))))
