          (compPath Nat (mul (pow A (mul M64 K)) (pow X (add (mul L K) R))) (mul (pow A (wpow (suc (wlen r)))) (pow X (add (mul L K) R))) (mul (pow A (wpow (suc (wlen r)))) (pow X (wbval (lcons l r))))
             (cong Nat Nat (\v -> mul (pow A v) (pow X (add (mul L K) R))) (mul M64 K) (wpow (suc (wlen r)))
                (compPath Nat (mul M64 K) (mul K M64) (wpow (suc (wlen r))) (mul_comm M64 K) (sym Nat (wpow (suc (wlen r))) (mul K M64) (wpow_suc (wlen r)))))
             (cong Nat Nat (\v -> mul (pow A (wpow (suc (wlen r)))) (pow X v)) (add (mul L K) R) (wbval (lcons l r)) (sym Nat (wbval (lcons l r)) (add (mul L K) R) (wbval_cons l r))))))
-- the bit loop under reduction: the same invariant as the plain power's, taken modulo m at every step
def limbPowModGo_val : (x m : WB) (m' : Nat) -> Path Nat (suc m') (wbval m) -> (f : Nat) (t w : Word) (acc : WB)
    -> Path Nat (wlimb t) (pow 2 f) -> .(hw : Lt (wlimb w) (pow 2 (suc f)))
    -> Path Nat (wbval (limbPowModGo x m (suc f) t w acc)) (mod (mul (pow (wbval acc) (pow 2 (suc f))) (pow (wbval x) (wlimb w))) (suc m')) :=
  \x m m' hm -> elim Nat (\f -> (t w : Word) (acc : WB) -> Path Nat (wlimb t) (pow 2 f) -> .(hw : Lt (wlimb w) (pow 2 (suc f)))
                        -> Path Nat (wbval (limbPowModGo x m (suc f) t w acc)) (mod (mul (pow (wbval acc) (pow 2 (suc f))) (pow (wbval x) (wlimb w))) (suc m')))
    (\t w acc ht hw ->
      let T : Nat := wlimb t in
      let W : Nat := wlimb w in
      let A : Nat := wbval acc in
      let X : Nat := wbval x in
      let M : Nat := suc m' in
      let hsq : Path Nat (wbval (bmod_wb (nmul acc acc) m)) (mod (mul A A) M) :=
