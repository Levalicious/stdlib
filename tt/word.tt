  \y qr w V hI hR -> divLimbGo_inv y 63 9223372036854775808 w qr V (prefl Nat 9223372036854775808) (snd w) hI hR
-- the limbs from the head: Horner's rule on the dividend, the pair carrying the invariant
def divGo_inv : (y x : WB) (qr : Sigma WB (\_ -> WB)) (V : Nat)
    -> Path Nat (add (mul (wbval (fst qr)) (wbval y)) (wbval (snd qr))) V -> Lt (wbval (snd qr)) (wbval y)
    -> Sigma (Path Nat (add (mul (wbval (fst (divGo y x qr))) (wbval y)) (wbval (snd (divGo y x qr)))) (add (mul V (wpow (wlen x))) (wbval x)))
             (\_ -> Lt (wbval (snd (divGo y x qr))) (wbval y)) :=
  \y -> elim List (\x -> (qr : Sigma WB (\_ -> WB)) (V : Nat)
                    -> Path Nat (add (mul (wbval (fst qr)) (wbval y)) (wbval (snd qr))) V -> Lt (wbval (snd qr)) (wbval y)
                    -> Sigma (Path Nat (add (mul (wbval (fst (divGo y x qr))) (wbval y)) (wbval (snd (divGo y x qr)))) (add (mul V (wpow (wlen x))) (wbval x)))
                             (\_ -> Lt (wbval (snd (divGo y x qr))) (wbval y)))
