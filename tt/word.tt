       (sym Nat (mod (mul (pow a n) v) (suc m')) (mod (mul (mod (pow a n) (suc m')) v) (suc m')) (mod_mul_mod1 (pow a n) v m')))
-- the remainder's value at a modulus known to be a successor
def bmod_val_s : (a m : WB) (m' : Nat) -> Path Nat (suc m') (wbval m) -> Path Nat (wbval (bmod_wb a m)) (mod (wbval a) (suc m')) :=
  \a m m' hm -> compPath Nat (wbval (bmod_wb a m)) (mod (wbval a) (wbval m)) (mod (wbval a) (suc m')) (snd (bdivmod_wb_val a m)) (cong Nat Nat (\v -> mod (wbval a) v) (wbval m) (suc m') (sym Nat (suc m') (wbval m) hm))
