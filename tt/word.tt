      elim Bool (\c -> Path Bool (wlt w t) c -> Path Nat (wbval (elim Bool (\_ -> WB) (bmod_wb (nmul acc acc) m) (bmod_wb (nmul (bmod_wb (nmul acc acc) m) x) m) c)) (mod (mul (pow A 2) (pow X W)) M))
        (\hlt ->
          let hW0 : Path Nat W 0 := lt1_zero W (substId (\v -> Lt W v) (pathToId ht) (wlt_true w t hlt)) in
          compPath Nat (wbval (bmod_wb (nmul acc acc) m)) (mod (mul A A) M) (mod (mul (pow A 2) (pow X W)) M)
            hsq
            (cong Nat Nat (\v -> mod v M) (mul A A) (mul (pow A 2) (pow X W))
               (sym Nat (mul (pow A 2) (pow X W)) (mul A A)
                  (compPath Nat (mul (pow A 2) (pow X W)) (mul (pow A 2) 1) (mul A A)
                     (cong Nat Nat (\v -> mul (pow A 2) (pow X v)) W 0 hW0)
                     (compPath Nat (mul (pow A 2) 1) (pow A 2) (mul A A) (mul_one_r (pow A 2)) (a_sq A))))))
        (\hge ->
          let hW1 : Path Nat W 1 := lt2_one W (substId (\v -> Le v W) (pathToId ht) (wlt_false w t hge)) hw in
          compPath Nat (wbval (bmod_wb (nmul (bmod_wb (nmul acc acc) m) x) m)) (mod (mul (mod (mul A A) M) X) M) (mod (mul (pow A 2) (pow X W)) M)
            (compPath Nat (wbval (bmod_wb (nmul (bmod_wb (nmul acc acc) m) x) m)) (mod (wbval (nmul (bmod_wb (nmul acc acc) m) x)) M) (mod (mul (mod (mul A A) M) X) M)
               (bmod_val_s (nmul (bmod_wb (nmul acc acc) m) x) m m' hm)
               (cong Nat Nat (\v -> mod v M) (wbval (nmul (bmod_wb (nmul acc acc) m) x)) (mul (mod (mul A A) M) X)
                  (compPath Nat (wbval (nmul (bmod_wb (nmul acc acc) m) x)) (mul (wbval (bmod_wb (nmul acc acc) m)) X) (mul (mod (mul A A) M) X)
                     (nmul_val (bmod_wb (nmul acc acc) m) x)
                     (cong Nat Nat (\v -> mul v X) (wbval (bmod_wb (nmul acc acc) m)) (mod (mul A A) M) hsq))))
            (compPath Nat (mod (mul (mod (mul A A) M) X) M) (mod (mul (mul A A) X) M) (mod (mul (pow A 2) (pow X W)) M)
               (sym Nat (mod (mul (mul A A) X) M) (mod (mul (mod (mul A A) M) X) M) (mod_mul_mod1 (mul A A) X m'))
               (cong Nat Nat (\v -> mod v M) (mul (mul A A) X) (mul (pow A 2) (pow X W))
                  (compPath Nat (mul (mul A A) X) (mul (pow A 2) X) (mul (pow A 2) (pow X W))
                     (cong Nat Nat (\v -> mul v X) (mul A A) (pow A 2) (sym Nat (pow A 2) (mul A A) (a_sq A)))
                     (cong Nat Nat (\v -> mul (pow A 2) v) X (pow X W) (sym Nat (pow X W) X (compPath Nat (pow X W) (pow X 1) X (cong Nat Nat (pow X) W 1 hW1) (pow_one X))))))))
        (wlt w t) (prefl Bool (wlt w t)))
    (\f ih -> \t w acc ht hw ->
      let T : Nat := wlimb t in
      let W : Nat := wlimb w in
      let A : Nat := wbval acc in
      let X : Nat := wbval x in
      let M : Nat := suc m' in
      let N : Nat := pow 2 (suc f) in
      let t' : Word := fst (wdivmod t 2) in
