           snd ihr))
        (wlt w t) (prefl Bool (wlt w t)))
def divLimb_inv : (y : WB) (qr : Sigma WB (\_ -> WB)) (w : Word) (V : Nat)
    -> Path Nat (add (mul (wbval (fst qr)) (wbval y)) (wbval (snd qr))) V -> Lt (wbval (snd qr)) (wbval y)
    -> Sigma (Path Nat (add (mul (wbval (fst (divLimb y qr w))) (wbval y)) (wbval (snd (divLimb y qr w)))) (add (mul V M64) (wlimb w)))
