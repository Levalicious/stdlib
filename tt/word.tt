                   (cong Nat Nat (\v -> add v d) (mul (add (mul 2 V) 1) N) (add (mul (mul 2 V) N) N)
                      (compPath Nat (mul (add (mul 2 V) 1) N) (add (mul (mul 2 V) N) (mul 1 N)) (add (mul (mul 2 V) N) N) (mul_dist_r (mul 2 V) 1 N) (cong Nat Nat (add (mul (mul 2 V) N)) (mul 1 N) N (one_mul N))))
