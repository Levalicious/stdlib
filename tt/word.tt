          (cong Nat Nat (\v -> mod v M) (mul (pow 1 (wpow (wlen e))) (pow X E)) (pow X E)
             (compPath Nat (mul (pow 1 (wpow (wlen e))) (pow X E)) (mul 1 (pow X E)) (pow X E) (cong Nat Nat (\v -> mul v (pow X E)) (pow 1 (wpow (wlen e))) 1 (one_pow (wpow (wlen e)))) (one_mul (pow X E))))))
-- the inverse's law: minv by the prelude's rule at every y. Below two the exponent is zero and the
-- prelude's own reduction decides; from two on, y = suc (suc d) and the modular power's law applies.
def bminv_wb_val : (x y : WB) -> Path Nat (wbval (bminv_wb x y)) (minv (wbval x) (wbval y)) :=
  \x y ->
  let X : Nat := wbval x in
  let Y : Nat := wbval y in
  elim Nat (\k2 -> Path Nat (blt_wb y wtwo) k2 -> Path Nat (wbval (elim Nat (\_ -> WB) (bpowmod_wb x (nsub y wtwo) y) (\_ _ -> elim Nat (\_ -> WB) (lnil {Word}) (\_ _ -> wone) (bisz y)) k2)) (minv X Y))
    (\h0 ->
      let hblt : Path Nat (blt Y 2) 0 := compPath Nat (blt Y 2) (blt_wb y wtwo) 0 (sym Nat (blt_wb y wtwo) (blt Y 2) (compPath Nat (blt_wb y wtwo) (blt Y (wbval wtwo)) (blt Y 2) (blt_wb_val y wtwo) (cong Nat Nat (blt Y) (wbval wtwo) 2 wbval_wtwo))) h0 in
      let h2Y : Le 2 Y := le_suc_suc 2 Y (ble_not (suc Y) 2 (pathToId hblt)) in
      let d : Nat := fst h2Y in
      let hY : Path Nat (suc (suc d)) Y := snd h2Y in
      compPath Nat (wbval (bpowmod_wb x (nsub y wtwo) y)) (mod (pow X (wbval (nsub y wtwo))) (suc (suc d))) (minv X Y)
        (bpowmod_wb_val x (nsub y wtwo) y (suc d) hY)
        (compPath Nat (mod (pow X (wbval (nsub y wtwo))) (suc (suc d))) (mod (pow X (sub Y 2)) (suc (suc d))) (minv X Y)
           (cong Nat Nat (\v -> mod (pow X v) (suc (suc d))) (wbval (nsub y wtwo)) (sub Y 2) (compPath Nat (wbval (nsub y wtwo)) (sub Y (wbval wtwo)) (sub Y 2) (nsub_val y wtwo) (cong Nat Nat (sub Y) (wbval wtwo) 2 wbval_wtwo)))
           (cong Nat Nat (\v -> mod (pow X (sub Y 2)) v) (suc (suc d)) Y hY)))
    (\k _ -> \hk ->
      let hlt : Lt Y 2 := ble_ones (suc Y) 2 k (pathToId (compPath Nat (blt Y 2) (blt_wb y wtwo) (suc k) (sym Nat (blt_wb y wtwo) (blt Y 2) (compPath Nat (blt_wb y wtwo) (blt Y (wbval wtwo)) (blt Y 2) (blt_wb_val y wtwo) (cong Nat Nat (blt Y) (wbval wtwo) 2 wbval_wtwo))) hk)) in
      elim Nat (\k3 -> Path Nat (bisz y) k3 -> Path Nat (wbval (elim Nat (\_ -> WB) (lnil {Word}) (\_ _ -> wone) k3)) (minv X Y))
        (\hz ->
          let hYs : Path Nat Y (suc (pred Y)) := isZero_suc_of_zero Y (compPath Nat (isZero Y) (bisz y) 0 (sym Nat (bisz y) (isZero Y) (bisz_val y)) hz) in
          let hY1 : Path Nat Y 1 := lt2_one Y (pred Y, sym Nat Y (suc (pred Y)) hYs) hlt in
          substId (\v -> Path Nat 0 (minv X v)) (pathToId (sym Nat Y 1 hY1)) (prefl Nat 0))
        (\k4 _ -> \hz ->
          let hY0 : Path Nat Y 0 := isZero_zero_of_suc Y k4 (compPath Nat (isZero Y) (bisz y) (suc k4) (sym Nat (bisz y) (isZero Y) (bisz_val y)) hz) in
          substId (\v -> Path Nat 1 (minv X v)) (pathToId (sym Nat Y 0 hY0)) (prefl Nat 1))
        (bisz y) (prefl Nat (bisz y)))
    (blt_wb y wtwo) (prefl Nat (blt_wb y wtwo))
