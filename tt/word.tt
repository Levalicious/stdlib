def horner_pow : (A X : Nat) (l : Word) (r : WB) -> Path Nat (mul (pow (mul (pow A M64) (pow X (wlimb l))) (wpow (wlen r))) (pow X (wbval r))) (mul (pow A (wpow (suc (wlen r)))) (pow X (wbval (lcons l r)))) :=
