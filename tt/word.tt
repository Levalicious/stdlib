              (compPath Nat (pow (wbval (limbPow x acc l)) K) (pow (mul (pow A M64) (pow X L)) K) (mul (pow A (mul M64 K)) (pow X (mul L K)))
                 (cong Nat Nat (\v -> pow v K) (wbval (limbPow x acc l)) (mul (pow A M64) (pow X L)) (limbPow_val x acc l))
