      elim Bool (\c -> Path Bool (wlt w t) c -> Path Nat (wbval (elim Bool (\_ -> WB) (limbPowModGo x m (suc f) t' w (bmod_wb (nmul acc acc) m)) (limbPowModGo x m (suc f) t' (wsub w t) (bmod_wb (nmul (bmod_wb (nmul acc acc) m) x) m)) c)) (mod (mul (pow A (pow 2 (suc (suc f)))) (pow X W)) M))
        (\hlt ->
          let hw' : Lt W N := substId (\v -> Lt W v) (pathToId ht) (wlt_true w t hlt) in
