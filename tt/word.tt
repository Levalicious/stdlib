def limbPowMod_val : (x m : WB) (m' : Nat) -> Path Nat (suc m') (wbval m) -> (acc : WB) (w : Word)
    -> Path Nat (wbval (limbPowMod x m acc w)) (mod (mul (pow (wbval acc) M64) (pow (wbval x) (wlimb w))) (suc m')) :=
  \x m m' hm acc w -> limbPowModGo_val x m m' hm 63 9223372036854775808 w acc (prefl Nat 9223372036854775808) (snd w)
-- Horner over the limbs, the running value kept reduced (a reduced value is its own remainder: mod_mod)
def bpowModGo_val : (x m : WB) (m' : Nat) -> Path Nat (suc m') (wbval m) -> (e acc : WB) -> Path Nat (wbval acc) (mod (wbval acc) (suc m'))
    -> Path Nat (wbval (bpowModGo x m e acc)) (mod (mul (pow (wbval acc) (wpow (wlen e))) (pow (wbval x) (wbval e))) (suc m')) :=
  \x m m' hm -> elim List (\e -> (acc : WB) -> Path Nat (wbval acc) (mod (wbval acc) (suc m'))
                          -> Path Nat (wbval (bpowModGo x m e acc)) (mod (mul (pow (wbval acc) (wpow (wlen e))) (pow (wbval x) (wbval e))) (suc m')))
    (\acc hred -> compPath Nat (wbval acc) (mod (wbval acc) (suc m')) (mod (mul (pow (wbval acc) 1) 1) (suc m')) hred
       (cong Nat Nat (\v -> mod v (suc m')) (wbval acc) (mul (pow (wbval acc) 1) 1)
          (sym Nat (mul (pow (wbval acc) 1) 1) (wbval acc)
             (compPath Nat (mul (pow (wbval acc) 1) 1) (mul (wbval acc) 1) (wbval acc) (cong Nat Nat (\v -> mul v 1) (pow (wbval acc) 1) (wbval acc) (pow_one (wbval acc))) (mul_one_r (wbval acc))))))
    (\l r ih -> \acc hred ->
      let X : Nat := wbval x in
      let A : Nat := wbval acc in
      let M : Nat := suc m' in
      let acc1 : WB := limbPowMod x m acc l in
      let h1 : Path Nat (wbval acc1) (mod (mul (pow A M64) (pow X (wlimb l))) M) := limbPowMod_val x m m' hm acc l in
      let hred1 : Path Nat (wbval acc1) (mod (wbval acc1) M) :=
        compPath Nat (wbval acc1) (mod (mul (pow A M64) (pow X (wlimb l))) M) (mod (wbval acc1) M) h1
          (compPath Nat (mod (mul (pow A M64) (pow X (wlimb l))) M) (mod (mod (mul (pow A M64) (pow X (wlimb l))) M) M) (mod (wbval acc1) M)
             (sym Nat (mod (mod (mul (pow A M64) (pow X (wlimb l))) M) M) (mod (mul (pow A M64) (pow X (wlimb l))) M) (mod_mod (mul (pow A M64) (pow X (wlimb l))) m'))
             (cong Nat Nat (\v -> mod v M) (mod (mul (pow A M64) (pow X (wlimb l))) M) (wbval acc1) (sym Nat (wbval acc1) (mod (mul (pow A M64) (pow X (wlimb l))) M) h1))) in
      compPath Nat (wbval (bpowModGo x m r acc1)) (mod (mul (pow (wbval acc1) (wpow (wlen r))) (pow X (wbval r))) M) (mod (mul (pow A (wpow (suc (wlen r)))) (pow X (wbval (lcons l r)))) M)
        (ih acc1 hred1)
        (compPath Nat (mod (mul (pow (wbval acc1) (wpow (wlen r))) (pow X (wbval r))) M) (mod (mul (pow (mod (mul (pow A M64) (pow X (wlimb l))) M) (wpow (wlen r))) (pow X (wbval r))) M) (mod (mul (pow A (wpow (suc (wlen r)))) (pow X (wbval (lcons l r)))) M)
           (cong Nat Nat (\v -> mod (mul (pow v (wpow (wlen r))) (pow X (wbval r))) M) (wbval acc1) (mod (mul (pow A M64) (pow X (wlimb l))) M) h1)
           (compPath Nat (mod (mul (pow (mod (mul (pow A M64) (pow X (wlimb l))) M) (wpow (wlen r))) (pow X (wbval r))) M) (mod (mul (pow (mul (pow A M64) (pow X (wlimb l))) (wpow (wlen r))) (pow X (wbval r))) M) (mod (mul (pow A (wpow (suc (wlen r)))) (pow X (wbval (lcons l r)))) M)
              (mod_mul_pow_mod (mul (pow A M64) (pow X (wlimb l))) (wpow (wlen r)) (pow X (wbval r)) m')
              (cong Nat Nat (\v -> mod v M) (mul (pow (mul (pow A M64) (pow X (wlimb l))) (wpow (wlen r))) (pow X (wbval r))) (mul (pow A (wpow (suc (wlen r)))) (pow X (wbval (lcons l r)))) (horner_pow A X l r)))))
def bpowmod_wb_val : (x e m : WB) (m' : Nat) -> Path Nat (suc m') (wbval m) -> Path Nat (wbval (bpowmod_wb x e m)) (mod (pow (wbval x) (wbval e)) (suc m')) :=
  \x e m m' hm ->
