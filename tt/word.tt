                       (sym Nat (add (mul V 1) 0) V (compPath Nat (add (mul V 1) 0) (mul V 1) V (add_zero_r (mul V 1)) (mul_one_r V))),
                     hR))
    (\l r ih -> \qr V hI hR ->
      let Y : Nat := wbval y in
      let L : Nat := wlimb l in
      let K : Nat := wpow (wlen r) in
      let R : Nat := wbval r in
      let dl : Sigma (Path Nat (add (mul (wbval (fst (divLimb y qr l))) Y) (wbval (snd (divLimb y qr l)))) (add (mul V M64) L)) (\_ -> Lt (wbval (snd (divLimb y qr l))) Y) :=
        divLimb_inv y qr l V hI hR in
      let ihr : Sigma (Path Nat (add (mul (wbval (fst (divGo y r (divLimb y qr l)))) Y) (wbval (snd (divGo y r (divLimb y qr l))))) (add (mul (add (mul V M64) L) K) R))
                      (\_ -> Lt (wbval (snd (divGo y r (divLimb y qr l)))) Y) :=
        ih (divLimb y qr l) (add (mul V M64) L) (fst dl) (snd dl) in
      (compPath Nat (add (mul (wbval (fst (divGo y r (divLimb y qr l)))) Y) (wbval (snd (divGo y r (divLimb y qr l))))) (add (mul (add (mul V M64) L) K) R) (add (mul V (wpow (suc (wlen r)))) (wbval (lcons l r)))
         (fst ihr)
         (compPath Nat (add (mul (add (mul V M64) L) K) R) (add (add (mul (mul V M64) K) (mul L K)) R) (add (mul V (wpow (suc (wlen r)))) (wbval (lcons l r)))
            (cong Nat Nat (\v -> add v R) (mul (add (mul V M64) L) K) (add (mul (mul V M64) K) (mul L K)) (mul_dist_r (mul V M64) L K))
            (compPath Nat (add (add (mul (mul V M64) K) (mul L K)) R) (add (mul (mul V M64) K) (add (mul L K) R)) (add (mul V (wpow (suc (wlen r)))) (wbval (lcons l r)))
               (add_assoc (mul (mul V M64) K) (mul L K) R)
               (compPath Nat (add (mul (mul V M64) K) (add (mul L K) R)) (add (mul V (wpow (suc (wlen r)))) (add (mul L K) R)) (add (mul V (wpow (suc (wlen r)))) (wbval (lcons l r)))
                  (cong Nat Nat (\v -> add v (add (mul L K) R)) (mul (mul V M64) K) (mul V (wpow (suc (wlen r))))
                     (compPath Nat (mul (mul V M64) K) (mul V (mul M64 K)) (mul V (wpow (suc (wlen r))))
                        (mul_assoc V M64 K)
                        (cong Nat Nat (mul V) (mul M64 K) (wpow (suc (wlen r))) (compPath Nat (mul M64 K) (mul K M64) (wpow (suc (wlen r))) (mul_comm M64 K) (sym Nat (wpow (suc (wlen r))) (mul K M64) (wpow_suc (wlen r)))))))
                  (cong Nat Nat (add (mul V (wpow (suc (wlen r))))) (add (mul L K) R) (wbval (lcons l r)) (sym Nat (wbval (lcons l r)) (add (mul L K) R) (wbval_cons l r)))))),
       snd ihr))
-- the division's law: the quotient and remainder are the naturals' own. A zero divisor is the prelude's
-- convention (div x 0 = 0, mod x 0 = x); otherwise the invariant at the end is what dm_unique reads.
def bdivmod_wb_val : (x y : WB) -> Sigma (Path Nat (wbval (bdiv_wb x y)) (div (wbval x) (wbval y))) (\_ -> Path Nat (wbval (bmod_wb x y)) (mod (wbval x) (wbval y))) :=
  \x y ->
  let X : Nat := wbval x in
  let Y : Nat := wbval y in
  elim Nat (\m -> Path Nat (bisz y) m ->
        Sigma (Path Nat (wbval (fst (elim Nat (\_ -> Sigma WB (\_ -> WB)) (divGo y x (lnil {Word}, lnil {Word})) (\_ _ -> (lnil {Word}, x)) m))) (div X Y))
              (\_ -> Path Nat (wbval (snd (elim Nat (\_ -> Sigma WB (\_ -> WB)) (divGo y x (lnil {Word}, lnil {Word})) (\_ _ -> (lnil {Word}, x)) m))) (mod X Y)))
    (\h0 ->
      let hYs : Path Nat Y (suc (pred Y)) := isZero_suc_of_zero Y (compPath Nat (isZero Y) (bisz y) 0 (sym Nat (bisz y) (isZero Y) (bisz_val y)) h0) in
      let m' : Nat := pred Y in
      let hR0 : Lt 0 Y := substId (\v -> Lt 0 v) (pathToId (sym Nat Y (suc m') hYs)) refl in
      let dg : Sigma (Path Nat (add (mul (wbval (fst (divGo y x (lnil {Word}, lnil {Word})))) Y) (wbval (snd (divGo y x (lnil {Word}, lnil {Word}))))) (add (mul 0 (wpow (wlen x))) X))
                     (\_ -> Lt (wbval (snd (divGo y x (lnil {Word}, lnil {Word})))) Y) :=
        divGo_inv y x (lnil {Word}, lnil {Word}) 0 (prefl Nat 0) hR0 in
      let Q' : Nat := wbval (fst (divGo y x (lnil {Word}, lnil {Word}))) in
      let R' : Nat := wbval (snd (divGo y x (lnil {Word}, lnil {Word}))) in
      let eqX : Path Nat (add (mul Q' (suc m')) R') X := substId (\v -> Path Nat (add (mul Q' v) R') X) (pathToId hYs) (fst dg) in
      let ltR : Lt R' (suc m') := substId (\v -> Lt R' v) (pathToId hYs) (snd dg) in
      let dm : Sigma (Path Nat Q' (div X (suc m'))) (\_ -> Path Nat R' (mod X (suc m'))) := dm_unique m' Q' R' X eqX ltR in
      (substId (\v -> Path Nat Q' (div X v)) (pathToId (sym Nat Y (suc m') hYs)) (fst dm),
       substId (\v -> Path Nat R' (mod X v)) (pathToId (sym Nat Y (suc m') hYs)) (snd dm)))
    (\k _ -> \hk ->
      let hY0 : Path Nat Y 0 := isZero_zero_of_suc Y k (compPath Nat (isZero Y) (bisz y) (suc k) (sym Nat (bisz y) (isZero Y) (bisz_val y)) hk) in
      (substId (\v -> Path Nat 0 (div X v)) (pathToId (sym Nat Y 0 hY0)) (prefl Nat 0),
       substId (\v -> Path Nat X (mod X v)) (pathToId (sym Nat Y 0 hY0)) (prefl Nat X)))
    (bisz y) (prefl Nat (bisz y))
-- ---- the modular power and the modular inverse (S6.5) ----
-- The power with reduction after every product: the bit loop of bpow_wb with each square and each
-- multiplication by the base taken modulo m (bmod_wb), so the running value never exceeds the modulus and
-- the work is the exponent's bits, whatever the size of the power itself. With m = 0 the reduction is the
-- identity and this is the plain power.
def limbPowModGo (x m : WB) : Nat -> Word -> Word -> WB -> WB :=
  elim Nat (\_ -> Word -> Word -> WB -> WB)
    (\t w acc -> acc)
    (\_ ih -> \t w acc -> elim Bool (\_ -> WB) (ih (fst (wdivmod t 2)) w (bmod_wb (nmul acc acc) m)) (ih (fst (wdivmod t 2)) (wsub w t) (bmod_wb (nmul (bmod_wb (nmul acc acc) m) x) m))
       (wlt w t))
def limbPowMod (x m acc : WB) (w : Word) : WB := limbPowModGo x m 64 9223372036854775808 w acc
def bpowModGo (x m : WB) : WB -> WB -> WB := elim List (\_ -> WB -> WB) (\acc -> acc) (\l r ih -> \acc -> ih (limbPowMod x m acc l))
def bpowmod_wb (x e m : WB) : WB := bpowModGo x m e (bmod_wb wone m)
-- the inverse by the prelude's rule, minv x y = x^(y-2) mod y: below two the exponent is zero and the answer
-- is 1 mod y - 1 for y = 0, 0 for y = 1; from two on, the modular power at y - 2
def wtwo : WB := lcons 2 (lnil {Word})
def bminv_wb (x y : WB) : WB :=
  elim Nat (\_ -> WB)
    (bpowmod_wb x (nsub y wtwo) y)
    (\_ _ -> elim Nat (\_ -> WB) (lnil {Word}) (\_ _ -> wone) (bisz y))
    (blt_wb y wtwo)
-- ---- their laws ----
def wbval_wtwo : Path Nat (wbval wtwo) 2 := prefl Nat 2
-- reduction commutes with the power, and a reduced base under a power inside a product may be unreduced
def mod_pow : (a n m' : Nat) -> Path Nat (mod (pow (mod a (suc m')) n) (suc m')) (mod (pow a n) (suc m')) :=
  \a -> elim Nat (\n -> (m' : Nat) -> Path Nat (mod (pow (mod a (suc m')) n) (suc m')) (mod (pow a n) (suc m')))
    (\m' -> prefl Nat (mod 1 (suc m')))
    (\n ih -> \m' ->
      compPath Nat (mod (mul (mod a (suc m')) (pow (mod a (suc m')) n)) (suc m')) (mod (mul (mod a (suc m')) (mod (pow (mod a (suc m')) n) (suc m'))) (suc m')) (mod (mul a (pow a n)) (suc m'))
        (mod_mul_mod2 (mod a (suc m')) (pow (mod a (suc m')) n) m')
        (compPath Nat (mod (mul (mod a (suc m')) (mod (pow (mod a (suc m')) n) (suc m'))) (suc m')) (mod (mul (mod a (suc m')) (mod (pow a n) (suc m'))) (suc m')) (mod (mul a (pow a n)) (suc m'))
           (cong Nat Nat (\v -> mod (mul (mod a (suc m')) v) (suc m')) (mod (pow (mod a (suc m')) n) (suc m')) (mod (pow a n) (suc m')) (ih m'))
           (compPath Nat (mod (mul (mod a (suc m')) (mod (pow a n) (suc m'))) (suc m')) (mod (mul (mod a (suc m')) (pow a n)) (suc m')) (mod (mul a (pow a n)) (suc m'))
              (sym Nat (mod (mul (mod a (suc m')) (pow a n)) (suc m')) (mod (mul (mod a (suc m')) (mod (pow a n) (suc m'))) (suc m')) (mod_mul_mod2 (mod a (suc m')) (pow a n) m'))
              (sym Nat (mod (mul a (pow a n)) (suc m')) (mod (mul (mod a (suc m')) (pow a n)) (suc m')) (mod_mul_mod1 a (pow a n) m')))))
def mod_mul_pow_mod : (a n v m' : Nat) -> Path Nat (mod (mul (pow (mod a (suc m')) n) v) (suc m')) (mod (mul (pow a n) v) (suc m')) :=
  \a n v m' -> compPath Nat (mod (mul (pow (mod a (suc m')) n) v) (suc m')) (mod (mul (mod (pow (mod a (suc m')) n) (suc m')) v) (suc m')) (mod (mul (pow a n) v) (suc m'))
    (mod_mul_mod1 (pow (mod a (suc m')) n) v m')
