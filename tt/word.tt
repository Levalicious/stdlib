             (cong Nat Nat (\v -> mul v (pow (pow X L) K)) (pow (pow A M64) K) (pow A (mul M64 K)) (pow_mul A M64 K))
             (cong Nat Nat (\v -> mul (pow A (mul M64 K)) v) (pow (pow X L) K) (pow X (mul L K)) (pow_mul X L K)))))
    (compPath Nat (mul (mul (pow A (mul M64 K)) (pow X (mul L K))) (pow X R)) (mul (pow A (mul M64 K)) (mul (pow X (mul L K)) (pow X R))) (mul (pow A (wpow (suc (wlen r)))) (pow X (wbval (lcons l r))))
       (mul_assoc (pow A (mul M64 K)) (pow X (mul L K)) (pow X R))
       (compPath Nat (mul (pow A (mul M64 K)) (mul (pow X (mul L K)) (pow X R))) (mul (pow A (mul M64 K)) (pow X (add (mul L K) R))) (mul (pow A (wpow (suc (wlen r)))) (pow X (wbval (lcons l r))))
