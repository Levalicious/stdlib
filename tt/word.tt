                    (pow_mul_dist (pow A M64) (pow X L) K)
                    (compPath Nat (mul (pow (pow A M64) K) (pow (pow X L) K)) (mul (pow A (mul M64 K)) (pow (pow X L) K)) (mul (pow A (mul M64 K)) (pow X (mul L K)))
                       (cong Nat Nat (\v -> mul v (pow (pow X L) K)) (pow (pow A M64) K) (pow A (mul M64 K)) (pow_mul A M64 K))
                       (cong Nat Nat (\v -> mul (pow A (mul M64 K)) v) (pow (pow X L) K) (pow X (mul L K)) (pow_mul X L K))))))
