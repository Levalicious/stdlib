-- ---- the Euclidean division, bit-serial (S6.4) ----
-- Long division one bit at a time, from the dividend's most significant end: the remainder takes the next bit
-- (r := 2r + b) and, when the divisor fits, gives it up (r := r - y) while the quotient takes a one bit; else the
-- quotient takes a zero bit. The dividend's bits are peeled exactly as the power peels the exponent's. A zero
-- divisor answers (0, x), as the prelude's div and mod do, so the value laws hold for every divisor.
def divBit (y : WB) (b : Nat) (qr : Sigma WB (\_ -> WB)) : Sigma WB (\_ -> WB) :=
  let r1 : WB := nadd (nadd (snd qr) (snd qr)) (elim Nat (\_ -> WB) (lnil {Word}) (\_ _ -> wone) b) in
  let q2 : WB := nadd (fst qr) (fst qr) in
  elim Nat (\_ -> Sigma WB (\_ -> WB)) (q2, r1) (\_ _ -> (nadd q2 wone, nsub r1 y)) (ble_wb y r1)
def divLimbGo (y : WB) : Nat -> Word -> Word -> Sigma WB (\_ -> WB) -> Sigma WB (\_ -> WB) :=
  elim Nat (\_ -> Word -> Word -> Sigma WB (\_ -> WB) -> Sigma WB (\_ -> WB))
    (\t w qr -> qr)
    (\_ ih -> \t w qr -> elim Bool (\_ -> Sigma WB (\_ -> WB)) (ih (fst (wdivmod t 2)) w (divBit y 0 qr)) (ih (fst (wdivmod t 2)) (wsub w t) (divBit y 1 qr))
       (wlt w t))
def divLimb (y : WB) (qr : Sigma WB (\_ -> WB)) (w : Word) : Sigma WB (\_ -> WB) := divLimbGo y 64 9223372036854775808 w qr
def divGo (y : WB) : WB -> Sigma WB (\_ -> WB) -> Sigma WB (\_ -> WB) :=
  elim List (\_ -> Sigma WB (\_ -> WB) -> Sigma WB (\_ -> WB)) (\qr -> qr) (\l r ih -> \qr -> ih (divLimb y qr l))
def bdivmod_wb (x y : WB) : Sigma WB (\_ -> WB) :=
  elim Nat (\_ -> Sigma WB (\_ -> WB)) (divGo y x (lnil {Word}, lnil {Word})) (\_ _ -> (lnil {Word}, x)) (bisz y)
def bdiv_wb (x y : WB) : WB := fst (bdivmod_wb x y)
def bmod_wb (x y : WB) : WB := snd (bdivmod_wb x y)
-- ---- the division's law ----
def add_shuffle4 : (a b c d : Nat) -> Path Nat (add (add a b) (add c d)) (add (add a c) (add b d)) :=
  \a b c d -> compPath Nat (add (add a b) (add c d)) (add a (add b (add c d))) (add (add a c) (add b d))
    (add_assoc a b (add c d))
    (compPath Nat (add a (add b (add c d))) (add a (add (add b c) d)) (add (add a c) (add b d))
       (cong Nat Nat (add a) (add b (add c d)) (add (add b c) d) (sym Nat (add (add b c) d) (add b (add c d)) (add_assoc b c d)))
       (compPath Nat (add a (add (add b c) d)) (add a (add (add c b) d)) (add (add a c) (add b d))
          (cong Nat Nat (\v -> add a (add v d)) (add b c) (add c b) (add_comm b c))
          (compPath Nat (add a (add (add c b) d)) (add a (add c (add b d))) (add (add a c) (add b d))
             (cong Nat Nat (add a) (add (add c b) d) (add c (add b d)) (add_assoc c b d))
             (sym Nat (add (add a c) (add b d)) (add a (add c (add b d))) (add_assoc a c (add b d))))))
def isZero_zero_of_suc : (n k : Nat) -> Path Nat (isZero n) (suc k) -> Path Nat n 0 :=
  \n k -> elim Nat (\n -> Path Nat (isZero n) (suc k) -> Path Nat n 0) (\_ -> prefl Nat 0) (\m _ -> \h -> elim Empty (\_ -> Path Nat (suc m) 0) (znots h)) n
def isZero_suc_of_zero : (n : Nat) -> Path Nat (isZero n) 0 -> Path Nat n (suc (pred n)) :=
  \n -> elim Nat (\n -> Path Nat (isZero n) 0 -> Path Nat n (suc (pred n))) (\h -> elim Empty (\_ -> Path Nat 0 (suc (pred 0))) (snotz h)) (\m _ -> \_ -> prefl Nat (suc m)) n
-- the bit chain's value is the bit
def bitchain_val : (b : Nat) -> Le b 1 -> Path Nat (wbval (elim Nat (\_ -> WB) (lnil {Word}) (\_ _ -> wone) b)) b :=
  \b -> elim Nat (\b -> Le b 1 -> Path Nat (wbval (elim Nat (\_ -> WB) (lnil {Word}) (\_ _ -> wone) b)) b)
    (\_ -> prefl Nat 0)
    (\k _ -> \hb -> compPath Nat (wbval wone) 1 (suc k) wbval_wone
       (cong Nat Nat suc 0 k (le_antisym 0 k (k, prefl Nat k) (le_suc_suc k 0 hb))))
    b
-- (R + R) + 2 = (R + 1) + (R + 1)
def two_r_plus_two : (R : Nat) -> Path Nat (add (add R R) 2) (add (suc R) (suc R)) :=
  \R -> compPath Nat (add (add R R) 2) (suc (suc (add R R))) (add (suc R) (suc R))
    (compPath Nat (add (add R R) 2) (suc (add (add R R) 1)) (suc (suc (add R R)))
       (add_suc_r (add R R) 1)
       (cong Nat Nat suc (add (add R R) 1) (suc (add R R))
          (compPath Nat (add (add R R) 1) (suc (add (add R R) 0)) (suc (add R R))
             (add_suc_r (add R R) 0)
             (cong Nat Nat suc (add (add R R) 0) (add R R) (add_zero_r (add R R))))))
    (sym Nat (add (suc R) (suc R)) (suc (suc (add R R))) (cong Nat Nat suc (add R (suc R)) (suc (add R R)) (add_suc_r R R)))
-- one bit into the remainder and quotient, by the values: from Q*Y + R = V and R < Y, after the bit b the pair
-- satisfies Q'*Y + R' = 2V + b and R' < Y. The decision ble_wb y r1 is split with its equation; when the
-- divisor fits, R1 = Y + d and the new remainder is d, below Y because R1 < 2Y.
def divBit_inv : (y : WB) (b : Nat) -> Le b 1 -> (qr : Sigma WB (\_ -> WB)) (V : Nat)
    -> Path Nat (add (mul (wbval (fst qr)) (wbval y)) (wbval (snd qr))) V -> Lt (wbval (snd qr)) (wbval y)
    -> Sigma (Path Nat (add (mul (wbval (fst (divBit y b qr))) (wbval y)) (wbval (snd (divBit y b qr)))) (add (mul 2 V) b))
             (\_ -> Lt (wbval (snd (divBit y b qr))) (wbval y)) :=
  \y b hb qr V hI hR ->
  let Y : Nat := wbval y in
  let Q : Nat := wbval (fst qr) in
  let R : Nat := wbval (snd qr) in
  let bc : WB := elim Nat (\_ -> WB) (lnil {Word}) (\_ _ -> wone) b in
  let r1 : WB := nadd (nadd (snd qr) (snd qr)) bc in
  let q2 : WB := nadd (fst qr) (fst qr) in
  let R1 : Nat := wbval r1 in
  let Q2 : Nat := wbval q2 in
  let hR1 : Path Nat R1 (add (add R R) b) :=
    compPath Nat R1 (add (wbval (nadd (snd qr) (snd qr))) (wbval bc)) (add (add R R) b)
      (nadd_val (nadd (snd qr) (snd qr)) bc)
      (compPath Nat (add (wbval (nadd (snd qr) (snd qr))) (wbval bc)) (add (add R R) (wbval bc)) (add (add R R) b)
         (cong Nat Nat (\v -> add v (wbval bc)) (wbval (nadd (snd qr) (snd qr))) (add R R) (nadd_val (snd qr) (snd qr)))
         (cong Nat Nat (\v -> add (add R R) v) (wbval bc) b (bitchain_val b hb))) in
  let hQ2 : Path Nat Q2 (add Q Q) := nadd_val (fst qr) (fst qr) in
  -- the equation of the no-borrow pair, shared by both cases: Q2*Y + R1 = 2V + b
  let eq0 : Path Nat (add (mul Q2 Y) R1) (add (mul 2 V) b) :=
    compPath Nat (add (mul Q2 Y) R1) (add (add (mul Q Y) (mul Q Y)) (add (add R R) b)) (add (mul 2 V) b)
      (compPath Nat (add (mul Q2 Y) R1) (add (mul (add Q Q) Y) (add (add R R) b)) (add (add (mul Q Y) (mul Q Y)) (add (add R R) b))
         (compPath Nat (add (mul Q2 Y) R1) (add (mul (add Q Q) Y) R1) (add (mul (add Q Q) Y) (add (add R R) b))
            (cong Nat Nat (\v -> add (mul v Y) R1) Q2 (add Q Q) hQ2)
            (cong Nat Nat (\v -> add (mul (add Q Q) Y) v) R1 (add (add R R) b) hR1))
         (cong Nat Nat (\v -> add v (add (add R R) b)) (mul (add Q Q) Y) (add (mul Q Y) (mul Q Y)) (mul_dist_r Q Q Y)))
      (compPath Nat (add (add (mul Q Y) (mul Q Y)) (add (add R R) b)) (add (add (add (mul Q Y) (mul Q Y)) (add R R)) b) (add (mul 2 V) b)
         (sym Nat (add (add (add (mul Q Y) (mul Q Y)) (add R R)) b) (add (add (mul Q Y) (mul Q Y)) (add (add R R) b)) (add_assoc (add (mul Q Y) (mul Q Y)) (add R R) b))
         (cong Nat Nat (\v -> add v b) (add (add (mul Q Y) (mul Q Y)) (add R R)) (mul 2 V)
            (compPath Nat (add (add (mul Q Y) (mul Q Y)) (add R R)) (add (add (mul Q Y) R) (add (mul Q Y) R)) (mul 2 V)
               (add_shuffle4 (mul Q Y) (mul Q Y) R R)
               (compPath Nat (add (add (mul Q Y) R) (add (mul Q Y) R)) (add V V) (mul 2 V)
                  (compPath Nat (add (add (mul Q Y) R) (add (mul Q Y) R)) (add V (add (mul Q Y) R)) (add V V)
                     (cong Nat Nat (\v -> add v (add (mul Q Y) R)) (add (mul Q Y) R) V hI)
                     (cong Nat Nat (\v -> add V v) (add (mul Q Y) R) V hI))
                  (sym Nat (mul 2 V) (add V V) (mul_two V)))))) in
  -- R1 < 2Y: R1 = (R + R) + b <= (R + R) + 2 = (R + 1) + (R + 1) <= Y + Y
  let hR1lt : Le (suc R1) (add Y Y) :=
    substId (\v -> Le (suc v) (add Y Y)) (pathToId (sym Nat R1 (add (add R R) b) hR1))
      (substId (\v -> Le v (add Y Y)) (pathToId (add_suc_r (add R R) b))
        (le_trans (add (add R R) (suc b)) (add (add R R) 2) (add Y Y)
           (le_add_le (add R R) (add R R) (suc b) 2 (le_refl (add R R)) (le_suc_both b 1 hb))
           (substId (\v -> Le v (add Y Y)) (pathToId (sym Nat (add (add R R) 2) (add (suc R) (suc R)) (two_r_plus_two R)))
              (le_add_le (suc R) Y (suc R) Y (lt_le R Y hR) (lt_le R Y hR))))) in
  elim Nat (\m -> Path Nat (ble_wb y r1) m ->
        Sigma (Path Nat (add (mul (wbval (fst (elim Nat (\_ -> Sigma WB (\_ -> WB)) (q2, r1) (\_ _ -> (nadd q2 wone, nsub r1 y)) m))) Y)
                                  (wbval (snd (elim Nat (\_ -> Sigma WB (\_ -> WB)) (q2, r1) (\_ _ -> (nadd q2 wone, nsub r1 y)) m)))) (add (mul 2 V) b))
              (\_ -> Lt (wbval (snd (elim Nat (\_ -> Sigma WB (\_ -> WB)) (q2, r1) (\_ _ -> (nadd q2 wone, nsub r1 y)) m))) Y))
    (\h0 ->
      let hble : Path Nat (ble Y R1) 0 := compPath Nat (ble Y R1) (ble_wb y r1) 0 (sym Nat (ble_wb y r1) (ble Y R1) (ble_wb_val y r1)) h0 in
      (eq0, le_ble (suc R1) Y (ble_not Y R1 (pathToId hble))))
    (\k _ -> \hk ->
      let hble : Path Nat (ble Y R1) (suc k) := compPath Nat (ble Y R1) (ble_wb y r1) (suc k) (sym Nat (ble_wb y r1) (ble Y R1) (ble_wb_val y r1)) hk in
      let hYR : Le Y R1 := ble_le Y R1 (ble_ones Y R1 k (pathToId hble)) in
      let d : Nat := fst hYR in
      let hd : Path Nat (add Y d) R1 := snd hYR in
      let hQ' : Path Nat (wbval (nadd q2 wone)) (add Q2 1) :=
        compPath Nat (wbval (nadd q2 wone)) (add Q2 (wbval wone)) (add Q2 1) (nadd_val q2 wone) (cong Nat Nat (add Q2) (wbval wone) 1 wbval_wone) in
      let hR' : Path Nat (wbval (nsub r1 y)) d :=
        compPath Nat (wbval (nsub r1 y)) (sub R1 Y) d (nsub_val r1 y)
          (compPath Nat (sub R1 Y) (sub (add Y d) Y) d (cong Nat Nat (\v -> sub v Y) R1 (add Y d) (sym Nat (add Y d) R1 hd)) (sub_add_d Y d)) in
      let hdY : Lt d Y :=
        le_ble (suc d) Y (le_cancel_l Y (suc d) Y
          (substId (\v -> Le v (add Y Y)) (pathToId (sym Nat (add Y (suc d)) (suc (add Y d)) (add_suc_r Y d)))
            (substId (\v -> Le (suc v) (add Y Y)) (pathToId (sym Nat (add Y d) R1 hd)) hR1lt))) in
      (compPath Nat (add (mul (wbval (nadd q2 wone)) Y) (wbval (nsub r1 y))) (add (mul (add Q2 1) Y) d) (add (mul 2 V) b)
         (compPath Nat (add (mul (wbval (nadd q2 wone)) Y) (wbval (nsub r1 y))) (add (mul (add Q2 1) Y) (wbval (nsub r1 y))) (add (mul (add Q2 1) Y) d)
            (cong Nat Nat (\v -> add (mul v Y) (wbval (nsub r1 y))) (wbval (nadd q2 wone)) (add Q2 1) hQ')
            (cong Nat Nat (\v -> add (mul (add Q2 1) Y) v) (wbval (nsub r1 y)) d hR'))
         (compPath Nat (add (mul (add Q2 1) Y) d) (add (add (mul Q2 Y) Y) d) (add (mul 2 V) b)
            (cong Nat Nat (\v -> add v d) (mul (add Q2 1) Y) (add (mul Q2 Y) Y)
               (compPath Nat (mul (add Q2 1) Y) (add (mul Q2 Y) (mul 1 Y)) (add (mul Q2 Y) Y) (mul_dist_r Q2 1 Y) (cong Nat Nat (add (mul Q2 Y)) (mul 1 Y) Y (one_mul Y))))
            (compPath Nat (add (add (mul Q2 Y) Y) d) (add (mul Q2 Y) (add Y d)) (add (mul 2 V) b)
               (add_assoc (mul Q2 Y) Y d)
               (compPath Nat (add (mul Q2 Y) (add Y d)) (add (mul Q2 Y) R1) (add (mul 2 V) b)
                  (cong Nat Nat (add (mul Q2 Y)) (add Y d) R1 hd)
                  eq0))),
       substId (\v -> Lt v Y) (pathToId (sym Nat (wbval (nsub r1 y)) d hR')) hdY))
    (ble_wb y r1) (prefl Nat (ble_wb y r1))
-- the bit loop's invariant: with fuel f + 1, a threshold worth 2^f, a word below 2^(f+1), and a pair with
-- Q*Y + R = V and R < Y, the loop returns a pair with Q'*Y + R' = V * 2^(f+1) + w and R' < Y: the processed
-- bits are appended to V, each by divBit_inv.
def divLimbGo_inv : (y : WB) (f : Nat) (t w : Word) (qr : Sigma WB (\_ -> WB)) (V : Nat)
    -> Path Nat (wlimb t) (pow 2 f) -> .(hw : Lt (wlimb w) (pow 2 (suc f)))
    -> Path Nat (add (mul (wbval (fst qr)) (wbval y)) (wbval (snd qr))) V -> Lt (wbval (snd qr)) (wbval y)
    -> Sigma (Path Nat (add (mul (wbval (fst (divLimbGo y (suc f) t w qr))) (wbval y)) (wbval (snd (divLimbGo y (suc f) t w qr))))
                       (add (mul V (pow 2 (suc f))) (wlimb w)))
             (\_ -> Lt (wbval (snd (divLimbGo y (suc f) t w qr))) (wbval y)) :=
  \y -> elim Nat (\f -> (t w : Word) (qr : Sigma WB (\_ -> WB)) (V : Nat) -> Path Nat (wlimb t) (pow 2 f) -> .(hw : Lt (wlimb w) (pow 2 (suc f)))
                       -> Path Nat (add (mul (wbval (fst qr)) (wbval y)) (wbval (snd qr))) V -> Lt (wbval (snd qr)) (wbval y)
                       -> Sigma (Path Nat (add (mul (wbval (fst (divLimbGo y (suc f) t w qr))) (wbval y)) (wbval (snd (divLimbGo y (suc f) t w qr))))
                                          (add (mul V (pow 2 (suc f))) (wlimb w)))
                                (\_ -> Lt (wbval (snd (divLimbGo y (suc f) t w qr))) (wbval y)))
    (\t w qr V ht hw hI hR ->
      let T : Nat := wlimb t in
      let W : Nat := wlimb w in
      let Y : Nat := wbval y in
      elim Bool (\c -> Path Bool (wlt w t) c ->
            Sigma (Path Nat (add (mul (wbval (fst (elim Bool (\_ -> Sigma WB (\_ -> WB)) (divLimbGo y 0 (fst (wdivmod t 2)) w (divBit y 0 qr)) (divLimbGo y 0 (fst (wdivmod t 2)) (wsub w t) (divBit y 1 qr)) c))) Y)
                                 (wbval (snd (elim Bool (\_ -> Sigma WB (\_ -> WB)) (divLimbGo y 0 (fst (wdivmod t 2)) w (divBit y 0 qr)) (divLimbGo y 0 (fst (wdivmod t 2)) (wsub w t) (divBit y 1 qr)) c))))
                            (add (mul V (pow 2 1)) W))
                  (\_ -> Lt (wbval (snd (elim Bool (\_ -> Sigma WB (\_ -> WB)) (divLimbGo y 0 (fst (wdivmod t 2)) w (divBit y 0 qr)) (divLimbGo y 0 (fst (wdivmod t 2)) (wsub w t) (divBit y 1 qr)) c))) Y))
        (\hlt ->
          let hW0 : Path Nat W 0 := lt1_zero W (substId (\v -> Lt W v) (pathToId ht) (wlt_true w t hlt)) in
          let ib : Sigma (Path Nat (add (mul (wbval (fst (divBit y 0 qr))) Y) (wbval (snd (divBit y 0 qr)))) (add (mul 2 V) 0)) (\_ -> Lt (wbval (snd (divBit y 0 qr))) Y) :=
            divBit_inv y 0 (1, prefl Nat 1) qr V hI hR in
          (compPath Nat (add (mul (wbval (fst (divBit y 0 qr))) Y) (wbval (snd (divBit y 0 qr)))) (add (mul 2 V) 0) (add (mul V 2) W)
             (fst ib)
             (compPath Nat (add (mul 2 V) 0) (add (mul V 2) 0) (add (mul V 2) W)
                (cong Nat Nat (\v -> add v 0) (mul 2 V) (mul V 2) (mul_comm 2 V))
                (cong Nat Nat (add (mul V 2)) 0 W (sym Nat W 0 hW0))),
           snd ib))
        (\hge ->
          let hW1 : Path Nat W 1 := lt2_one W (substId (\v -> Le v W) (pathToId ht) (wlt_false w t hge)) hw in
          let ib : Sigma (Path Nat (add (mul (wbval (fst (divBit y 1 qr))) Y) (wbval (snd (divBit y 1 qr)))) (add (mul 2 V) 1)) (\_ -> Lt (wbval (snd (divBit y 1 qr))) Y) :=
            divBit_inv y 1 (le_refl 1) qr V hI hR in
          (compPath Nat (add (mul (wbval (fst (divBit y 1 qr))) Y) (wbval (snd (divBit y 1 qr)))) (add (mul 2 V) 1) (add (mul V 2) W)
             (fst ib)
             (compPath Nat (add (mul 2 V) 1) (add (mul V 2) 1) (add (mul V 2) W)
                (cong Nat Nat (\v -> add v 1) (mul 2 V) (mul V 2) (mul_comm 2 V))
                (cong Nat Nat (add (mul V 2)) 1 W (sym Nat W 1 hW1))),
           snd ib))
        (wlt w t) (prefl Bool (wlt w t)))
    (\f ih -> \t w qr V ht hw hI hR ->
      let T : Nat := wlimb t in
      let W : Nat := wlimb w in
      let Y : Nat := wbval y in
      let N : Nat := pow 2 (suc f) in
      let t' : Word := fst (wdivmod t 2) in
      let ht' : Path Nat (wlimb t') (pow 2 f) := wlimb_wdiv2 t f ht in
      let hVN : Path Nat (mul (mul 2 V) N) (mul V (mul 2 N)) :=
        compPath Nat (mul (mul 2 V) N) (mul (mul V 2) N) (mul V (mul 2 N)) (cong Nat Nat (\v -> mul v N) (mul 2 V) (mul V 2) (mul_comm 2 V)) (mul_assoc V 2 N) in
      elim Bool (\c -> Path Bool (wlt w t) c ->
            Sigma (Path Nat (add (mul (wbval (fst (elim Bool (\_ -> Sigma WB (\_ -> WB)) (divLimbGo y (suc f) t' w (divBit y 0 qr)) (divLimbGo y (suc f) t' (wsub w t) (divBit y 1 qr)) c))) Y)
                                 (wbval (snd (elim Bool (\_ -> Sigma WB (\_ -> WB)) (divLimbGo y (suc f) t' w (divBit y 0 qr)) (divLimbGo y (suc f) t' (wsub w t) (divBit y 1 qr)) c))))
                            (add (mul V (pow 2 (suc (suc f)))) W))
                  (\_ -> Lt (wbval (snd (elim Bool (\_ -> Sigma WB (\_ -> WB)) (divLimbGo y (suc f) t' w (divBit y 0 qr)) (divLimbGo y (suc f) t' (wsub w t) (divBit y 1 qr)) c))) Y))
        (\hlt ->
          let hw' : Lt W N := substId (\v -> Lt W v) (pathToId ht) (wlt_true w t hlt) in
          let ib : Sigma (Path Nat (add (mul (wbval (fst (divBit y 0 qr))) Y) (wbval (snd (divBit y 0 qr)))) (add (mul 2 V) 0)) (\_ -> Lt (wbval (snd (divBit y 0 qr))) Y) :=
            divBit_inv y 0 (1, prefl Nat 1) qr V hI hR in
          let ihr : Sigma (Path Nat (add (mul (wbval (fst (divLimbGo y (suc f) t' w (divBit y 0 qr)))) Y) (wbval (snd (divLimbGo y (suc f) t' w (divBit y 0 qr))))) (add (mul (add (mul 2 V) 0) N) W))
                          (\_ -> Lt (wbval (snd (divLimbGo y (suc f) t' w (divBit y 0 qr)))) Y) :=
            ih t' w (divBit y 0 qr) (add (mul 2 V) 0) ht' hw' (fst ib) (snd ib) in
          (compPath Nat (add (mul (wbval (fst (divLimbGo y (suc f) t' w (divBit y 0 qr)))) Y) (wbval (snd (divLimbGo y (suc f) t' w (divBit y 0 qr))))) (add (mul (add (mul 2 V) 0) N) W) (add (mul V (mul 2 N)) W)
             (fst ihr)
             (cong Nat Nat (\v -> add v W) (mul (add (mul 2 V) 0) N) (mul V (mul 2 N))
                (compPath Nat (mul (add (mul 2 V) 0) N) (mul (mul 2 V) N) (mul V (mul 2 N)) (cong Nat Nat (\v -> mul v N) (add (mul 2 V) 0) (mul 2 V) (add_zero_r (mul 2 V))) hVN)),
           snd ihr))
        (\hge ->
          let hTW : Le T W := wlt_false w t hge in
          let d : Nat := fst hTW in
          let hd : Path Nat (add T d) W := snd hTW in
          let hsub : Path Nat (wlimb (wsub w t)) d :=
            compPath Nat (wlimb (wsub w t)) (sub W T) d (wsub_ge w t hTW)
              (compPath Nat (sub W T) (sub (add T d) T) d (cong Nat Nat (\v -> sub v T) W (add T d) (sym Nat (add T d) W hd)) (sub_add_d T d)) in
          let hdN : Lt d N :=
            le_ble (suc d) N (le_cancel_l T (suc d) N
              (substId (\v -> Le v (add T N)) (pathToId (sym Nat (add T (suc d)) (suc (add T d)) (add_suc_r T d)))
                (substId (\v -> Le (suc v) (add T N)) (pathToId (sym Nat (add T d) W hd))
                  (substId (\v -> Le (suc W) (add v N)) (pathToId (sym Nat T (pow 2 (suc f)) ht))
                    (substId (\v -> Le (suc W) v) (pathToId (mul_two N)) (ble_le (suc W) (mul 2 N) hw)))))) in
          let hw' : Lt (wlimb (wsub w t)) N := substId (\v -> Lt v N) (pathToId (sym Nat (wlimb (wsub w t)) d hsub)) hdN in
          let ib : Sigma (Path Nat (add (mul (wbval (fst (divBit y 1 qr))) Y) (wbval (snd (divBit y 1 qr)))) (add (mul 2 V) 1)) (\_ -> Lt (wbval (snd (divBit y 1 qr))) Y) :=
            divBit_inv y 1 (le_refl 1) qr V hI hR in
          let ihr : Sigma (Path Nat (add (mul (wbval (fst (divLimbGo y (suc f) t' (wsub w t) (divBit y 1 qr)))) Y) (wbval (snd (divLimbGo y (suc f) t' (wsub w t) (divBit y 1 qr))))) (add (mul (add (mul 2 V) 1) N) (wlimb (wsub w t))))
                          (\_ -> Lt (wbval (snd (divLimbGo y (suc f) t' (wsub w t) (divBit y 1 qr)))) Y) :=
            ih t' (wsub w t) (divBit y 1 qr) (add (mul 2 V) 1) ht' hw' (fst ib) (snd ib) in
          (compPath Nat (add (mul (wbval (fst (divLimbGo y (suc f) t' (wsub w t) (divBit y 1 qr)))) Y) (wbval (snd (divLimbGo y (suc f) t' (wsub w t) (divBit y 1 qr))))) (add (mul (add (mul 2 V) 1) N) (wlimb (wsub w t))) (add (mul V (mul 2 N)) W)
             (fst ihr)
             (compPath Nat (add (mul (add (mul 2 V) 1) N) (wlimb (wsub w t))) (add (mul (add (mul 2 V) 1) N) d) (add (mul V (mul 2 N)) W)
