          compPath Nat (wbval (limbPowGo x (suc f) t' (wsub w t) acc')) (mul (pow (wbval acc') N) (pow X (wlimb (wsub w t)))) (mul (pow A (pow 2 (suc (suc f)))) (pow X W))
            (ih t' (wsub w t) acc' ht' hw')
            (compPath Nat (mul (pow (wbval acc') N) (pow X (wlimb (wsub w t)))) (mul (mul (pow A (mul 2 N)) (pow X N)) (pow X d)) (mul (pow A (pow 2 (suc (suc f)))) (pow X W))
               (compPath Nat (mul (pow (wbval acc') N) (pow X (wlimb (wsub w t)))) (mul (pow (mul (mul A A) X) N) (pow X d)) (mul (mul (pow A (mul 2 N)) (pow X N)) (pow X d))
                  (compPath Nat (mul (pow (wbval acc') N) (pow X (wlimb (wsub w t)))) (mul (pow (mul (mul A A) X) N) (pow X (wlimb (wsub w t)))) (mul (pow (mul (mul A A) X) N) (pow X d))
                     (cong Nat Nat (\v -> mul (pow v N) (pow X (wlimb (wsub w t)))) (wbval acc') (mul (mul A A) X) hacc')
                     (cong Nat Nat (\v -> mul (pow (mul (mul A A) X) N) (pow X v)) (wlimb (wsub w t)) d hsub))
                  (cong Nat Nat (\v -> mul v (pow X d)) (pow (mul (mul A A) X) N) (mul (pow A (mul 2 N)) (pow X N))
                     (compPath Nat (pow (mul (mul A A) X) N) (mul (pow (mul A A) N) (pow X N)) (mul (pow A (mul 2 N)) (pow X N))
                        (pow_mul_dist (mul A A) X N)
                        (cong Nat Nat (\v -> mul v (pow X N)) (pow (mul A A) N) (pow A (mul 2 N)) (pow_sq A N)))))
               (compPath Nat (mul (mul (pow A (mul 2 N)) (pow X N)) (pow X d)) (mul (pow A (mul 2 N)) (mul (pow X N) (pow X d))) (mul (pow A (pow 2 (suc (suc f)))) (pow X W))
                  (mul_assoc (pow A (mul 2 N)) (pow X N) (pow X d))
                  (cong Nat Nat (\v -> mul (pow A (mul 2 N)) v) (mul (pow X N) (pow X d)) (pow X W)
                     (compPath Nat (mul (pow X N) (pow X d)) (pow X (add N d)) (pow X W)
                        (sym Nat (pow X (add N d)) (mul (pow X N) (pow X d)) (pow_add X N d))
                        (cong Nat Nat (pow X) (add N d) W (compPath Nat (add N d) (add T d) W (cong Nat Nat (\v -> add v d) N T (sym Nat T N ht)) hd)))))))
        (wlt w t) (prefl Bool (wlt w t)))
