#import prelude
#import word
-- wnat.tt: the word-backed naturals as a sub-theory of the naturals (M17).
--
-- wbval interprets a limb list as the number it denotes, and the laws bundled below say it carries every
-- limb operation onto the natural operation the runtime implements with it: addition, subtraction,
-- multiplication, the power, the Euclidean division, the modular inverse, and the embedding of a natural as
-- its own limbs. The bundle IS the licence for accelerating a Nat computation with limbs - erase to the
-- limb operation, run it, read the answer back through wbval - and it is stated once here rather than
-- re-derived wherever it is used.
--
-- What it does not license is the recursor. A fold whose step has a limb law is a computation this
-- sub-theory can carry whole (see fold.tt, where elim_add is one and the switch compiles it); a fold whose
-- step has none cannot be carried at all, and the switch refuses it rather than walking the literal.

def WNat : U :=
  Sigma ((x y : WB) -> Path Nat (wbval (badd x y)) (add (wbval x) (wbval y))) (\_ ->
  Sigma ((x y : WB) -> Path Nat (wbval (bsub x y)) (sub (wbval x) (wbval y))) (\_ ->
  Sigma ((x y : WB) -> Path Nat (wbval (bmul x y)) (mul (wbval x) (wbval y))) (\_ ->
  Sigma ((x : WB) (k : Nat) -> Path Nat (wbval (bpow x k)) (pow (wbval x) k)) (\_ ->
  Sigma ((x y : WB) (m' : Nat) (hm : Path Nat (suc m') (wbval y)) ->
           Path Nat (add (mul (wbval (fst (bdivmod x y m' hm))) (wbval y)) (wbval (snd (bdivmod x y m' hm)))) (wbval x)) (\_ ->
  Sigma ((x y : WB) -> Path Nat (wbval (bminv x y)) (minv (wbval x) (wbval y))) (\_ ->
         (k : Nat) -> Path Nat (wbval (nelim k)) k))))))
def wnat : WNat := (badd_val, (bsub_val, (bmul_val, (bpow_val, (bdivmod_val, (bminv_val, wbval_nelim))))))
-- the components, named: a use of the sub-theory reads as one
def wnat_add  : (x y : WB) -> Path Nat (wbval (badd x y)) (add (wbval x) (wbval y)) := fst wnat
def wnat_sub  : (x y : WB) -> Path Nat (wbval (bsub x y)) (sub (wbval x) (wbval y)) := fst (snd wnat)
def wnat_mul  : (x y : WB) -> Path Nat (wbval (bmul x y)) (mul (wbval x) (wbval y)) := fst (snd (snd wnat))
def wnat_pow  : (x : WB) (k : Nat) -> Path Nat (wbval (bpow x k)) (pow (wbval x) k) := fst (snd (snd (snd wnat)))
def wnat_div  : (x y : WB) (m' : Nat) (hm : Path Nat (suc m') (wbval y)) ->
                Path Nat (add (mul (wbval (fst (bdivmod x y m' hm))) (wbval y)) (wbval (snd (bdivmod x y m' hm)))) (wbval x) :=
  fst (snd (snd (snd (snd wnat))))
def wnat_inv  : (x y : WB) -> Path Nat (wbval (bminv x y)) (minv (wbval x) (wbval y)) := fst (snd (snd (snd (snd (snd wnat)))))
def wnat_embed : (k : Nat) -> Path Nat (wbval (nelim k)) k := snd (snd (snd (snd (snd (snd wnat)))))

-- a use of it, in the shape the runtime has: a natural sum, computed in limbs and read back through wbval
def accel_add (x y : Nat) : Path Nat (wbval (badd (nelim x) (nelim y))) (add x y) :=
  compPath Nat (wbval (badd (nelim x) (nelim y))) (add (wbval (nelim x)) (wbval (nelim y))) (add x y)
    (wnat_add (nelim x) (nelim y))
    (compPath Nat (add (wbval (nelim x)) (wbval (nelim y))) (add x (wbval (nelim y))) (add x y)
       (cong Nat Nat (\u -> add u (wbval (nelim y))) (wbval (nelim x)) x (wnat_embed x))
       (cong Nat Nat (\u -> add x u) (wbval (nelim y)) y (wnat_embed y)))
