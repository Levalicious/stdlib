#import word
-- bignat.tt: arbitrary-precision naturals over limbs, verified against the kernel's Nat (M16b b5).
-- Limbs are Nats (no invariant needed; every limb and carry fact goes through divmod_spec), most significant
-- first, and bval maps a limb list into the kernel's bignum Nat, so the kernel computes both sides of every law.
def BigNat : U := List Nat
def bvalAux (acc : Nat) (x : BigNat) : Nat :=
  elim List (\_ -> Nat -> Nat) (\acc -> acc) (\l rest ih -> \acc -> ih (add (mul acc M64) l)) x acc
def bval (x : BigNat) : Nat := bvalAux 0 x
-- one limb column: the carry in from the less significant side, the two limbs; the result is (carry out, digit)
def addLimbs (c a b : Nat) : Sigma Nat (\_ -> Nat) :=
  (div (add (add a b) c) M64, mod (add (add a b) c) M64)
-- the digits, least significant column first by recursion on the tails; the entering carry comes from them
def baddGo (x y : BigNat) : Sigma Nat (\_ -> BigNat) :=
  elim List (\_ -> BigNat -> Sigma Nat (\_ -> BigNat))
    (\y -> elim List (\_ -> Sigma Nat (\_ -> BigNat))
       (0, lnil {Nat})
       (\b bs ihb -> (fst (addLimbs (fst ihb) 0 b), lcons (snd (addLimbs (fst ihb) 0 b)) (snd ihb)))
       y)
    (\a as iha -> \y -> elim List (\_ -> Sigma Nat (\_ -> BigNat))
       (fst (addLimbs (fst (iha (lnil {Nat}))) a 0),
        lcons (snd (addLimbs (fst (iha (lnil {Nat}))) a 0)) (snd (iha (lnil {Nat}))))
       (\b bs ihb -> (fst (addLimbs (fst (iha bs)) a b),
                      lcons (snd (addLimbs (fst (iha bs)) a b)) (snd (iha bs))))
       y)
    x y
-- lengths, leading zeros (value-free: bvalAux 0 of zeros is 0) and padding to a common length
def len : BigNat -> Nat := elim List (\_ -> Nat) 0 (\_ r ih -> suc ih)
def zeros : Nat -> BigNat := elim Nat (\_ -> BigNat) (lnil {Nat}) (\_ ih -> lcons 0 ih)
def app (x y : BigNat) : BigNat := elim List (\_ -> BigNat) y (\l r ih -> lcons l ih) x
def padTo (n : Nat) (x : BigNat) : BigNat := app (zeros (sub n (len x))) x
def bvalAux_zeros0 : (d : Nat) -> Path Nat (bvalAux 0 (zeros d)) 0 :=
  \d -> elim Nat (\d -> Path Nat (bvalAux 0 (zeros d)) 0) (prefl Nat 0) (\k ih -> ih) d
def bvalAux_app : (a b : BigNat) (acc : Nat) -> Path Nat (bvalAux acc (app a b)) (bvalAux (bvalAux acc a) b) :=
  \a -> elim List (\a -> (b : BigNat) (acc : Nat) -> Path Nat (bvalAux acc (app a b)) (bvalAux (bvalAux acc a) b))
    (\b acc -> prefl Nat (bvalAux acc b))
    (\l r ih -> \b acc -> ih b (add (mul acc M64) l))
    a
def bval_padTo : (n : Nat) (x : BigNat) -> Path Nat (bval (padTo n x)) (bval x) :=
  \n x -> compPath Nat (bvalAux 0 (app (zeros (sub n (len x))) x)) (bvalAux (bvalAux 0 (zeros (sub n (len x)))) x) (bvalAux 0 x)
     (bvalAux_app (zeros (sub n (len x))) x 0)
     (cong Nat Nat (\w -> bvalAux w x) (bvalAux 0 (zeros (sub n (len x)))) 0 (bvalAux_zeros0 (sub n (len x))))
def badd (x y : BigNat) : BigNat :=
  let n : Nat := add (len x) (len y) in
  let q : Sigma Nat (\_ -> BigNat) := baddGo (padTo n x) (padTo n y) in
  ifN (beq (fst q) 0) (snd q) (lcons (fst q) (snd q))

-- ---- the correctness layer: bval of the fold is the sum ----
def pow64 : Nat -> Nat := elim Nat (\_ -> Nat) 1 (\_ ih -> mul ih M64)   -- the variable first: mul recurses on it, so a neutral exponent stays cheap
def len_zeros : (d : Nat) -> Path Nat (len (zeros d)) d :=
  \d -> elim Nat (\d -> Path Nat (len (zeros d)) d) (prefl Nat 0) (\k ih -> cong Nat Nat suc (len (zeros k)) k ih) d
def len_app : (a b : BigNat) -> Path Nat (len (app a b)) (add (len a) (len b)) :=
  \a -> elim List (\a -> (b : BigNat) -> Path Nat (len (app a b)) (add (len a) (len b)))
    (\b -> prefl Nat (len b))
    (\l r ih -> \b -> cong Nat Nat suc (len (app r b)) (add (len r) (len b)) (ih b))
    a
def len_padTo : (n : Nat) (x : BigNat) -> Path Nat (len (padTo n x)) (add (sub n (len x)) (len x)) :=
  \n x -> compPath Nat (len (app (zeros (sub n (len x))) x)) (add (len (zeros (sub n (len x)))) (len x)) (add (sub n (len x)) (len x))
    (len_app (zeros (sub n (len x))) x)
    (cong Nat Nat (\w -> add w (len x)) (len (zeros (sub n (len x)))) (sub n (len x)) (len_zeros (sub n (len x))))
def len_padTo_common : (x y : BigNat) -> Path Nat (len (padTo (add (len x) (len y)) x)) (add (len x) (len y)) :=
  \x y -> compPath Nat (len (padTo (add (len x) (len y)) x)) (add (sub (add (len x) (len y)) (len x)) (len x)) (add (len x) (len y))
    (len_padTo (add (len x) (len y)) x)
    (sub_add_le (add (len x) (len y)) (len x) (len y, prefl Nat (add (len x) (len y))))
-- the same for the right operand: both operands are padded to add (len x) (len y), whose two summands
-- are not convertible, so the y-side index needs one commutation
def len_padTo_common_r : (x y : BigNat) -> Path Nat (len (padTo (add (len x) (len y)) y)) (add (len x) (len y)) :=
  \x y -> compPath Nat (len (padTo (add (len x) (len y)) y)) (len (padTo (add (len y) (len x)) y)) (add (len x) (len y))
    (cong Nat Nat (\w -> len (padTo w y)) (add (len x) (len y)) (add (len y) (len x)) (add_comm (len x) (len y)))
    (compPath Nat (len (padTo (add (len y) (len x)) y)) (add (len y) (len x)) (add (len x) (len y))
       (len_padTo_common y x)
       (add_comm (len y) (len x)))
def bval_ifN_carry : (c : Nat) (r : BigNat) -> Path Nat (bval (ifN (beq c 0) r (lcons c r))) (bvalAux c r) :=
  \c -> elim Nat (\c -> (r : BigNat) -> Path Nat (bval (ifN (beq c 0) r (lcons c r))) (bvalAux c r))
    (\r -> prefl Nat (bvalAux 0 r))
    (\k ih -> \r -> prefl Nat (bvalAux (suc k) r))
    c
def bvalAux_add : (X C : Nat) (D : BigNat) -> Path Nat (bvalAux (add X C) D) (add (mul X (pow64 (len D))) (bvalAux C D)) :=
  \X C D -> elim List (\D -> (X C : Nat) -> Path Nat (bvalAux (add X C) D) (add (mul X (pow64 (len D))) (bvalAux C D)))
    (\X C -> cong Nat Nat (\w -> add w C) X (mul X 1) (sym Nat (mul X 1) X (mul_one_r X)))
    (\l r ih -> \X C -> compPath Nat
       (bvalAux (add (mul (add X C) M64) l) r)
       (add (mul (mul (add X C) M64) (pow64 (len r))) (bvalAux l r))
       (add (mul X (mul (pow64 (len r)) M64)) (bvalAux (add (mul C M64) l) r))
       (ih (mul (add X C) M64) l)
       (compPath Nat
          (add (mul (mul (add X C) M64) (pow64 (len r))) (bvalAux l r))
          (add (mul X (mul (pow64 (len r)) M64)) (add (mul (mul C M64) (pow64 (len r))) (bvalAux l r)))
          (add (mul X (mul (pow64 (len r)) M64)) (bvalAux (add (mul C M64) l) r))
          (compPath Nat
             (add (mul (mul (add X C) M64) (pow64 (len r))) (bvalAux l r))
             (add (mul (add X C) (mul (pow64 (len r)) M64)) (bvalAux l r))
             (add (mul X (mul (pow64 (len r)) M64)) (add (mul (mul C M64) (pow64 (len r))) (bvalAux l r)))
             (cong Nat Nat (\w -> add w (bvalAux l r)) (mul (mul (add X C) M64) (pow64 (len r))) (mul (add X C) (mul (pow64 (len r)) M64))
                (compPath Nat (mul (mul (add X C) M64) (pow64 (len r))) (mul (add X C) (mul M64 (pow64 (len r)))) (mul (add X C) (mul (pow64 (len r)) M64))
                   (mul_assoc (add X C) M64 (pow64 (len r)))
                   (cong Nat Nat (\w -> mul (add X C) w) (mul M64 (pow64 (len r))) (mul (pow64 (len r)) M64) (mul_comm M64 (pow64 (len r))))))
             (compPath Nat
                (add (mul (add X C) (mul (pow64 (len r)) M64)) (bvalAux l r))
                (add (add (mul X (mul (pow64 (len r)) M64)) (mul C (mul (pow64 (len r)) M64))) (bvalAux l r))
                (add (mul X (mul (pow64 (len r)) M64)) (add (mul (mul C M64) (pow64 (len r))) (bvalAux l r)))
                (cong Nat Nat (\w -> add w (bvalAux l r)) (mul (add X C) (mul (pow64 (len r)) M64)) (add (mul X (mul (pow64 (len r)) M64)) (mul C (mul (pow64 (len r)) M64))) (mul_dist_r X C (mul (pow64 (len r)) M64)))
                (compPath Nat
                   (add (add (mul X (mul (pow64 (len r)) M64)) (mul C (mul (pow64 (len r)) M64))) (bvalAux l r))
                   (add (mul X (mul (pow64 (len r)) M64)) (add (mul C (mul (pow64 (len r)) M64)) (bvalAux l r)))
                   (add (mul X (mul (pow64 (len r)) M64)) (add (mul (mul C M64) (pow64 (len r))) (bvalAux l r)))
                   (add_assoc (mul X (mul (pow64 (len r)) M64)) (mul C (mul (pow64 (len r)) M64)) (bvalAux l r))
                   (cong Nat Nat (\w -> add (mul X (mul (pow64 (len r)) M64)) (add w (bvalAux l r))) (mul C (mul (pow64 (len r)) M64)) (mul (mul C M64) (pow64 (len r)))
                      (sym Nat (mul (mul C M64) (pow64 (len r))) (mul C (mul (pow64 (len r)) M64))
                         (compPath Nat (mul (mul C M64) (pow64 (len r))) (mul C (mul M64 (pow64 (len r)))) (mul C (mul (pow64 (len r)) M64))
                            (mul_assoc C M64 (pow64 (len r)))
                            (cong Nat Nat (\w -> mul C w) (mul M64 (pow64 (len r))) (mul (pow64 (len r)) M64) (mul_comm M64 (pow64 (len r))))))))))
          (sym Nat (add (mul X (mul (pow64 (len r)) M64)) (bvalAux (add (mul C M64) l) r)) (add (mul X (mul (pow64 (len r)) M64)) (add (mul (mul C M64) (pow64 (len r))) (bvalAux l r)))
             (cong Nat Nat (\w -> add (mul X (mul (pow64 (len r)) M64)) w) (bvalAux (add (mul C M64) l) r) (add (mul (mul C M64) (pow64 (len r))) (bvalAux l r)) (ih (mul C M64) l)))))
    D X C

-- the fold preserves length, so the invariant's length hypothesis survives the recursion
def len_pres : (x y : BigNat) (h : Path Nat (len x) (len y)) -> Path Nat (len (snd (baddGo x y))) (len x) :=
  \x -> elim List (\x -> (y : BigNat) (h : Path Nat (len x) (len y)) -> Path Nat (len (snd (baddGo x y))) (len x))
    (\y -> elim List (\y -> (h : Path Nat (len (lnil {Nat})) (len y)) -> Path Nat (len (snd (baddGo (lnil {Nat}) y))) (len (lnil {Nat})))
       (\_ -> prefl Nat 0)
       (\b bs ihb -> \h -> elim Empty (\_ -> Path Nat (len (snd (baddGo (lnil {Nat}) (lcons b bs)))) 0) (znots h))
       y)
    (\a as iha -> \y -> elim List (\y -> (h : Path Nat (len (lcons a as)) (len y)) -> Path Nat (len (snd (baddGo (lcons a as) y))) (len (lcons a as)))
       (\h -> elim Empty (\_ -> Path Nat (len (snd (baddGo (lcons a as) (lnil {Nat})))) (suc (len as))) (snotz h))
       (\b bs ihb -> \h -> cong Nat Nat suc (len (snd (baddGo as bs))) (len as) (iha bs (injSuc h)))
       y)
    x

def interchange : (a b c d : Nat) -> Path Nat (add (add a b) (add c d)) (add (add a c) (add b d)) :=
  \a b c d -> compPath Nat (add (add a b) (add c d)) (add a (add b (add c d))) (add (add a c) (add b d))
    (add_assoc a b (add c d))
    (compPath Nat (add a (add b (add c d))) (add a (add c (add b d))) (add (add a c) (add b d))
       (cong Nat Nat (\w -> add a w) (add b (add c d)) (add c (add b d)) (add_swap b c d))
       (sym Nat (add (add a c) (add b d)) (add a (add c (add b d))) (add_assoc a c (add b d))))



def baddGo_inv : (x y : BigNat) (h : Path Nat (len x) (len y)) -> Path Nat (bvalAux (fst (baddGo x y)) (snd (baddGo x y))) (add (bval x) (bval y)) :=
  \x -> elim List (\x -> (y : BigNat) (h : Path Nat (len x) (len y)) -> Path Nat (bvalAux (fst (baddGo x y)) (snd (baddGo x y))) (add (bval x) (bval y)))
    (\y -> elim List (\y -> (h : Path Nat (len (lnil {Nat})) (len y)) -> Path Nat (bvalAux (fst (baddGo (lnil {Nat}) y)) (snd (baddGo (lnil {Nat}) y))) (add (bval (lnil {Nat})) (bval y)))
       (\_ -> prefl Nat 0)
       (\b bs ihb -> \h -> elim Empty (\_ -> Path Nat (bvalAux (fst (baddGo (lnil {Nat}) (lcons b bs))) (snd (baddGo (lnil {Nat}) (lcons b bs)))) (add (bval (lnil {Nat})) (bval (lcons b bs)))) (znots h))
       y)
    (\a as iha -> \y -> elim List (\y -> (h : Path Nat (len (lcons a as)) (len y)) -> Path Nat (bvalAux (fst (baddGo (lcons a as) y)) (snd (baddGo (lcons a as) y))) (add (bval (lcons a as)) (bval y)))
       (\h -> elim Empty (\_ -> Path Nat (bvalAux (fst (baddGo (lcons a as) (lnil {Nat}))) (snd (baddGo (lcons a as) (lnil {Nat})))) (add (bval (lcons a as)) (bval (lnil {Nat})))) (snotz h))
       (\b bs ihb -> \h -> compPath Nat (bvalAux (fst (baddGo (lcons a as) (lcons b bs))) (snd (baddGo (lcons a as) (lcons b bs)))) (bvalAux (add (add a b) (fst (baddGo as bs))) (snd (baddGo as bs))) (add (bvalAux a as) (bvalAux b bs))
          (cong Nat Nat (\w -> bvalAux w (snd (baddGo as bs))) (add (mul (fst (addLimbs (fst (baddGo as bs)) a b)) M64) (snd (addLimbs (fst (baddGo as bs)) a b))) (add (add a b) (fst (baddGo as bs))) (divmod_spec (add (add a b) (fst (baddGo as bs))) M63))
          (compPath Nat (bvalAux (add (add a b) (fst (baddGo as bs))) (snd (baddGo as bs))) (add (mul (add a b) (pow64 (len (snd (baddGo as bs))))) (bvalAux (fst (baddGo as bs)) (snd (baddGo as bs)))) (add (bvalAux a as) (bvalAux b bs))
          (bvalAux_add (add a b) (fst (baddGo as bs)) (snd (baddGo as bs)))
          (compPath Nat (add (mul (add a b) (pow64 (len (snd (baddGo as bs))))) (bvalAux (fst (baddGo as bs)) (snd (baddGo as bs)))) (add (mul (add a b) (pow64 (len as))) (bvalAux (fst (baddGo as bs)) (snd (baddGo as bs)))) (add (bvalAux a as) (bvalAux b bs))
          (cong Nat Nat (\w -> add (mul (add a b) w) (bvalAux (fst (baddGo as bs)) (snd (baddGo as bs)))) (pow64 (len (snd (baddGo as bs)))) (pow64 (len as)) (cong Nat Nat pow64 (len (snd (baddGo as bs))) (len as) (len_pres as bs (injSuc h))))
          (compPath Nat (add (mul (add a b) (pow64 (len as))) (bvalAux (fst (baddGo as bs)) (snd (baddGo as bs)))) (add (mul (add a b) (pow64 (len as))) (add (bvalAux 0 as) (bvalAux 0 bs))) (add (bvalAux a as) (bvalAux b bs))
          (cong Nat Nat (\w -> add (mul (add a b) (pow64 (len as))) w) (bvalAux (fst (baddGo as bs)) (snd (baddGo as bs))) (add (bvalAux 0 as) (bvalAux 0 bs)) (iha bs (injSuc h)))
          (compPath Nat (add (mul (add a b) (pow64 (len as))) (add (bvalAux 0 as) (bvalAux 0 bs))) (add (add (mul a (pow64 (len as))) (mul b (pow64 (len as)))) (add (bvalAux 0 as) (bvalAux 0 bs))) (add (bvalAux a as) (bvalAux b bs))
          (cong Nat Nat (\w -> add w (add (bvalAux 0 as) (bvalAux 0 bs))) (mul (add a b) (pow64 (len as))) (add (mul a (pow64 (len as))) (mul b (pow64 (len as)))) (mul_dist_r a b (pow64 (len as))))
          (compPath Nat (add (add (mul a (pow64 (len as))) (mul b (pow64 (len as)))) (add (bvalAux 0 as) (bvalAux 0 bs))) (add (add (mul a (pow64 (len as))) (bvalAux 0 as)) (add (mul b (pow64 (len as))) (bvalAux 0 bs))) (add (bvalAux a as) (bvalAux b bs))
          (interchange (mul a (pow64 (len as))) (mul b (pow64 (len as))) (bvalAux 0 as) (bvalAux 0 bs))
          (compPath Nat (add (add (mul a (pow64 (len as))) (bvalAux 0 as)) (add (mul b (pow64 (len as))) (bvalAux 0 bs))) (add (bvalAux a as) (add (mul b (pow64 (len as))) (bvalAux 0 bs))) (add (bvalAux a as) (bvalAux b bs))
          (cong Nat Nat (\w -> add w (add (mul b (pow64 (len as))) (bvalAux 0 bs))) (add (mul a (pow64 (len as))) (bvalAux 0 as)) (bvalAux a as) (compPath Nat (add (mul a (pow64 (len as))) (bvalAux 0 as)) (bvalAux (add a 0) as) (bvalAux a as) (sym Nat (bvalAux (add a 0) as) (add (mul a (pow64 (len as))) (bvalAux 0 as)) (bvalAux_add a 0 as)) (cong Nat Nat (\w -> bvalAux w as) (add a 0) a (add_zero_r a))))
          (cong Nat Nat (\w -> add (bvalAux a as) w) (add (mul b (pow64 (len as))) (bvalAux 0 bs)) (bvalAux b bs) (compPath Nat (add (mul b (pow64 (len as))) (bvalAux 0 bs)) (add (mul b (pow64 (len bs))) (bvalAux 0 bs)) (bvalAux b bs) (cong Nat Nat (\w -> add (mul b w) (bvalAux 0 bs)) (pow64 (len as)) (pow64 (len bs)) (cong Nat Nat pow64 (len as) (len bs) (injSuc h))) (compPath Nat (add (mul b (pow64 (len bs))) (bvalAux 0 bs)) (bvalAux (add b 0) bs) (bvalAux b bs) (sym Nat (bvalAux (add b 0) bs) (add (mul b (pow64 (len bs))) (bvalAux 0 bs)) (bvalAux_add b 0 bs)) (cong Nat Nat (\w -> bvalAux w bs) (add b 0) b (add_zero_r b))))))))))))
       y)
    x

-- the payoff: the padded fold, ifN-ed back into a BigNat, is addition of values
def badd_ok (x y : BigNat) : Path Nat (bval (badd x y)) (add (bval x) (bval y)) :=
  let n : Nat := add (len x) (len y) in
  let px : BigNat := padTo n x in
  let py : BigNat := padTo n y in
  let q : Sigma Nat (\_ -> BigNat) := baddGo px py in
  let h : Path Nat (len px) (len py) :=
    compPath Nat (len px) n (len py) (len_padTo_common x y) (sym Nat (len py) n (len_padTo_common_r x y)) in
  compPath Nat (bval (badd x y)) (bvalAux (fst q) (snd q)) (add (bval x) (bval y))
    (bval_ifN_carry (fst q) (snd q))
    (compPath Nat (bvalAux (fst q) (snd q)) (add (bval px) (bval py)) (add (bval x) (bval y))
      (baddGo_inv px py h)
      (compPath Nat (add (bval px) (bval py)) (add (bval x) (bval py)) (add (bval x) (bval y))
        (cong Nat Nat (\w -> add w (bval py)) (bval px) (bval x) (bval_padTo n x))
        (cong Nat Nat (\w -> add (bval x) w) (bval py) (bval y) (bval_padTo n y))))

-- ---- multiplication: per-limb scalar rows, accumulated by badd ----

-- the accumulator unfolds (forward) and its reverse is what the assembly steps need, so name both
def bvalAux_cons : (l : Nat) (rest : BigNat) -> Path Nat (bvalAux l rest) (add (mul l (pow64 (len rest))) (bvalAux 0 rest)) :=
  \l rest -> compPath Nat (bvalAux l rest) (bvalAux (add l 0) rest) (add (mul l (pow64 (len rest))) (bvalAux 0 rest))
    (cong Nat Nat (\w -> bvalAux w rest) l (add l 0) (sym Nat (add l 0) l (add_zero_r l)))
    (bvalAux_add l 0 rest)
-- a run of zeros in the accumulator is a shift by pow64, which is what app-to-(zeros k) means
def bvalAux_zeros_pow : (acc d : Nat) -> Path Nat (bvalAux acc (zeros d)) (mul acc (pow64 d)) :=
  \acc d -> compPath Nat (bvalAux acc (zeros d)) (bvalAux (add acc 0) (zeros d)) (mul acc (pow64 d))
    (cong Nat Nat (\w -> bvalAux w (zeros d)) acc (add acc 0) (sym Nat (add acc 0) acc (add_zero_r acc)))
    (compPath Nat (bvalAux (add acc 0) (zeros d)) (add (mul acc (pow64 (len (zeros d)))) (bvalAux 0 (zeros d))) (mul acc (pow64 d))
       (bvalAux_add acc 0 (zeros d))
       (compPath Nat (add (mul acc (pow64 (len (zeros d)))) (bvalAux 0 (zeros d))) (add (mul acc (pow64 d)) (bvalAux 0 (zeros d))) (mul acc (pow64 d))
          (cong Nat Nat (\w -> add (mul acc w) (bvalAux 0 (zeros d))) (pow64 (len (zeros d))) (pow64 d) (cong Nat Nat pow64 (len (zeros d)) d (len_zeros d)))
          (compPath Nat (add (mul acc (pow64 d)) (bvalAux 0 (zeros d))) (add (mul acc (pow64 d)) 0) (mul acc (pow64 d))
             (cong Nat Nat (\w -> add (mul acc (pow64 d)) w) (bvalAux 0 (zeros d)) 0 (bvalAux_zeros0 d))
             (add_zero_r (mul acc (pow64 d))))))
def bval_app_zeros : (x : BigNat) (d : Nat) -> Path Nat (bval (app x (zeros d))) (mul (bval x) (pow64 d)) :=
  \x d -> compPath Nat (bval (app x (zeros d))) (bvalAux (bval x) (zeros d)) (mul (bval x) (pow64 d))
    (bvalAux_app x (zeros d) 0)
    (bvalAux_zeros_pow (bval x) d)

-- the scalar fold: one limb column carry-propagates mul a b + c, digits land MSB first, carry at the head
def mulLimbs (c a b : Nat) : Sigma Nat (\_ -> Nat) :=
  (div (add (mul a b) c) M64, mod (add (mul a b) c) M64)
def mulGo (x : BigNat) (b : Nat) : Sigma Nat (\_ -> BigNat) :=
  elim List (\_ -> Sigma Nat (\_ -> BigNat))
    (0, lnil {Nat})
    (\a as iha -> (fst (mulLimbs (fst iha) a b), lcons (snd (mulLimbs (fst iha) a b)) (snd iha)))
    x
def scalar (x : BigNat) (b : Nat) : BigNat := lcons (fst (mulGo x b)) (snd (mulGo x b))
def len_mulGo : (x : BigNat) (b : Nat) -> Path Nat (len (snd (mulGo x b))) (len x) :=
  \x -> elim List (\x -> (b : Nat) -> Path Nat (len (snd (mulGo x b))) (len x))
    (\b -> prefl Nat 0)
    (\a as iha -> \b -> cong Nat Nat suc (len (snd (mulGo as b))) (len as) (iha b))
    x
def mulGo_inv : (x : BigNat) (b : Nat) -> Path Nat (bvalAux (fst (mulGo x b)) (snd (mulGo x b))) (mul (bval x) b) :=
  \x -> elim List (\x -> (b : Nat) -> Path Nat (bvalAux (fst (mulGo x b)) (snd (mulGo x b))) (mul (bval x) b))
    (\b -> prefl Nat 0)
    (\a as iha -> \b -> compPath Nat
        (bvalAux (fst (mulGo (lcons a as) b)) (snd (mulGo (lcons a as) b)))
        (bvalAux (add (mul a b) (fst (mulGo as b))) (snd (mulGo as b)))
        (mul (bvalAux a as) b)
        (cong Nat Nat (\w -> bvalAux w (snd (mulGo as b)))
           (add (mul (fst (mulLimbs (fst (mulGo as b)) a b)) M64) (snd (mulLimbs (fst (mulGo as b)) a b)))
           (add (mul a b) (fst (mulGo as b)))
           (divmod_spec (add (mul a b) (fst (mulGo as b))) M63))
        (compPath Nat
           (bvalAux (add (mul a b) (fst (mulGo as b))) (snd (mulGo as b)))
           (add (mul (mul a b) (pow64 (len (snd (mulGo as b))))) (bvalAux (fst (mulGo as b)) (snd (mulGo as b))))
           (mul (bvalAux a as) b)
           (bvalAux_add (mul a b) (fst (mulGo as b)) (snd (mulGo as b)))
           (compPath Nat
              (add (mul (mul a b) (pow64 (len (snd (mulGo as b))))) (bvalAux (fst (mulGo as b)) (snd (mulGo as b))))
              (add (mul (mul a b) (pow64 (len as))) (bvalAux (fst (mulGo as b)) (snd (mulGo as b))))
              (mul (bvalAux a as) b)
              (cong Nat Nat (\w -> add (mul (mul a b) w) (bvalAux (fst (mulGo as b)) (snd (mulGo as b))))
                 (pow64 (len (snd (mulGo as b)))) (pow64 (len as))
                 (cong Nat Nat pow64 (len (snd (mulGo as b))) (len as) (len_mulGo as b)))
              (compPath Nat
                 (add (mul (mul a b) (pow64 (len as))) (bvalAux (fst (mulGo as b)) (snd (mulGo as b))))
                 (add (mul (mul a b) (pow64 (len as))) (mul (bval as) b))
                 (mul (bvalAux a as) b)
                 (cong Nat Nat (\w -> add (mul (mul a b) (pow64 (len as))) w)
                    (bvalAux (fst (mulGo as b)) (snd (mulGo as b))) (mul (bval as) b) (iha b))
                 (compPath Nat
                    (add (mul (mul a b) (pow64 (len as))) (mul (bval as) b))
                    (add (mul (mul a (pow64 (len as))) b) (mul (bvalAux 0 as) b))
                    (mul (bvalAux a as) b)
                    (cong Nat Nat (\w -> add w (mul (bvalAux 0 as) b))
                       (mul (mul a b) (pow64 (len as))) (mul (mul a (pow64 (len as))) b)
                       (compPath Nat (mul (mul a b) (pow64 (len as))) (mul a (mul b (pow64 (len as)))) (mul (mul a (pow64 (len as))) b)
                          (mul_assoc a b (pow64 (len as)))
                          (compPath Nat (mul a (mul b (pow64 (len as)))) (mul a (mul (pow64 (len as)) b)) (mul (mul a (pow64 (len as))) b)
                             (cong Nat Nat (\w -> mul a w) (mul b (pow64 (len as))) (mul (pow64 (len as)) b) (mul_comm b (pow64 (len as))))
                             (sym Nat (mul (mul a (pow64 (len as))) b) (mul a (mul (pow64 (len as)) b)) (mul_assoc a (pow64 (len as)) b)))))
                    (compPath Nat
                       (add (mul (mul a (pow64 (len as))) b) (mul (bvalAux 0 as) b))
                       (mul (add (mul a (pow64 (len as))) (bvalAux 0 as)) b)
                       (mul (bvalAux a as) b)
                       (sym Nat (mul (add (mul a (pow64 (len as))) (bvalAux 0 as)) b) (add (mul (mul a (pow64 (len as))) b) (mul (bvalAux 0 as) b))
                          (mul_dist_r (mul a (pow64 (len as))) (bvalAux 0 as) b))
                       (cong Nat Nat (\w -> mul w b) (add (mul a (pow64 (len as))) (bvalAux 0 as)) (bvalAux a as)
                          (sym Nat (bvalAux a as) (add (mul a (pow64 (len as))) (bvalAux 0 as)) (bvalAux_cons a as)))))))))
    x
def scalar_ok (x : BigNat) (b : Nat) : Path Nat (bval (scalar x b)) (mul (bval x) b) := mulGo_inv x b

-- schoolbook rows: the row for a multiplier limb sits at the shift of the limbs to its right
def bmul (x y : BigNat) : BigNat :=
  elim List (\_ -> BigNat) (lnil {Nat})
    (\b bs ih -> badd (app (scalar x b) (zeros (len bs))) ih)
    y
def bmul_ok (x y : BigNat) : Path Nat (bval (bmul x y)) (mul (bval x) (bval y)) :=
  elim List (\y -> Path Nat (bval (bmul x y)) (mul (bval x) (bval y)))
    (sym Nat (mul (bval x) 0) 0 (mul_zero_r (bval x)))
    (\b bs ih -> compPath Nat
        (bval (bmul x (lcons b bs)))
        (add (bval (app (scalar x b) (zeros (len bs)))) (bval (bmul x bs)))
        (mul (bval x) (bvalAux b bs))
        (badd_ok (app (scalar x b) (zeros (len bs))) (bmul x bs))
        (compPath Nat
           (add (bval (app (scalar x b) (zeros (len bs)))) (bval (bmul x bs)))
           (add (mul (mul (bval x) b) (pow64 (len bs))) (bval (bmul x bs)))
           (mul (bval x) (bvalAux b bs))
           (cong Nat Nat (\w -> add w (bval (bmul x bs)))
              (bval (app (scalar x b) (zeros (len bs))))
              (mul (mul (bval x) b) (pow64 (len bs)))
              (compPath Nat
                 (bval (app (scalar x b) (zeros (len bs))))
                 (mul (bval (scalar x b)) (pow64 (len bs)))
                 (mul (mul (bval x) b) (pow64 (len bs)))
                 (bval_app_zeros (scalar x b) (len bs))
                 (cong Nat Nat (\w -> mul w (pow64 (len bs))) (bval (scalar x b)) (mul (bval x) b) (scalar_ok x b))))
           (compPath Nat
              (add (mul (mul (bval x) b) (pow64 (len bs))) (bval (bmul x bs)))
              (add (mul (mul (bval x) b) (pow64 (len bs))) (mul (bval x) (bval bs)))
              (mul (bval x) (bvalAux b bs))
              (cong Nat Nat (\w -> add (mul (mul (bval x) b) (pow64 (len bs))) w) (bval (bmul x bs)) (mul (bval x) (bval bs)) (ih))
           (compPath Nat
              (add (mul (mul (bval x) b) (pow64 (len bs))) (mul (bval x) (bval bs)))
              (add (mul (bval x) (mul b (pow64 (len bs)))) (mul (bval x) (bval bs)))
              (mul (bval x) (bvalAux b bs))
              (cong Nat Nat (\w -> add w (mul (bval x) (bval bs)))
                 (mul (mul (bval x) b) (pow64 (len bs)))
                 (mul (bval x) (mul b (pow64 (len bs))))
                 (mul_assoc (bval x) b (pow64 (len bs))))
              (compPath Nat
                 (add (mul (bval x) (mul b (pow64 (len bs)))) (mul (bval x) (bval bs)))
                 (mul (bval x) (add (mul b (pow64 (len bs))) (bvalAux 0 bs)))
                 (mul (bval x) (bvalAux b bs))
                 (sym Nat (mul (bval x) (add (mul b (pow64 (len bs))) (bvalAux 0 bs))) (add (mul (bval x) (mul b (pow64 (len bs)))) (mul (bval x) (bvalAux 0 bs)))
                    (mul_dist_l (bval x) (mul b (pow64 (len bs))) (bvalAux 0 bs)))
                 (cong Nat Nat (\w -> mul (bval x) w)
                    (add (mul b (pow64 (len bs))) (bvalAux 0 bs))
                    (bvalAux b bs)
                    (sym Nat (bvalAux b bs) (add (mul b (pow64 (len bs))) (bvalAux 0 bs)) (bvalAux_cons b bs))))))))
    y
